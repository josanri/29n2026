{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      // The election that astro.config.mjs compiles (ELECTION). Here, the default one, for the editor types.
      "@eleccion/*": ["src/data/2026/generales/*"]
    }
  }
}
