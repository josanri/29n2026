---
import '@/styles/global.css';
import '@fontsource/archivo-black/400.css';
import '@fontsource-variable/archivo/wght.css';
import '@fontsource-variable/archivo/wght-italic.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/700.css';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import Tooltip from '@/components/ui/Tooltip.astro';
import { readableTextColor, BLACK } from '@/lib/color';
import { DEFAULT_DESCRIPTION, SITE_NAME, THEME_STORAGE_KEY } from '@/lib/site';
import { routes } from '@/lib/routes';

interface Props {
  title: string;
  description?: string;
  /** Party color. When set with `accentLight`, the page takes the party theme. */
  accent?: string;
  accentLight?: string;
  /** Hide the page from search engines. */
  noindex?: boolean;
}

const { title, description = DEFAULT_DESCRIPTION, accent, accentLight, noindex = false } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = `${title} · ${SITE_NAME}`;

// Party theme: the accent colors, and the brand surface (header line, footer, primary buttons).
const onAccent = accent ? readableTextColor(accent) : undefined;
const partyTheme =
  accent && accentLight
    ? [
        `--color-accent:${accent}`,
        `--color-accent-light:${accentLight}`,
        `--color-on-accent:${onAccent}`,
        `--color-highlight:${accentLight}`,
        `--color-on-highlight:${BLACK}`,
        `--color-brand:${accent}`,
        `--color-on-brand:${onAccent}`,
      ].join(';')
    : undefined;

const faviconSvg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect width="64" height="64" fill="${accent}"/><text x="32" y="43" font-family="Arial Black,Impact,sans-serif" font-weight="900" font-size="30" text-anchor="middle" textLength="54" lengthAdjust="spacingAndGlyphs" fill="${onAccent}">29N</text><rect x="6" y="50" width="52" height="5" fill="${onAccent}"/></svg>`;
const faviconHref = accent && accentLight ? `data:image/svg+xml,${encodeURIComponent(faviconSvg)}` : routes.asset('/favicon.svg');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href={routes.asset('/sitemap-index.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content={accentLight ?? '#f3efe4'} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={accent ?? '#151515'} media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={faviconHref} type="image/svg+xml" />
    <!-- Apply the saved theme before the first paint, so the page does not flash. The `js` class lets the CSS
         fold the phone menu only when the script that opens it can run. -->
    <script is:inline define:vars={{ storageKey: THEME_STORAGE_KEY }}>
      document.documentElement.classList.add('js');
      try {
        const saved = localStorage.getItem(storageKey);
        if (saved) document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
  </head>
  <body style={partyTheme}>
    <a class="skip-link" href="#content">Saltar al contenido</a>
    <SiteHeader />
    <main id="content">
      <slot />
    </main>
    <SiteFooter />
    <Tooltip />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -999px;
    top: 8px;
    z-index: var(--z-skip-link);
    background: var(--color-highlight);
    color: var(--color-on-highlight);
    padding: 8px 12px;
    border: var(--border-thick) solid var(--color-ink);
  }
  .skip-link:focus { left: 8px; }
</style>
