---
import '@/styles/global.css';
import '@fontsource/big-shoulders-display/900';
import '@fontsource-variable/archivo/wght.css';
import '@fontsource-variable/archivo/wght-italic.css';
// The two fonts of the first screen, preloaded: without this the browser finds them only after the CSS, and the
// late swap moves the header and the hero (Web Analytics: CLS 0,13 on the home page). Vite gives them the same
// hashed URL as the CSS, so the browser downloads each file once.
import bodyFontUrl from '@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url';
import displayFontUrl from '@fontsource/big-shoulders-display/files/big-shoulders-display-latin-900-normal.woff2?url';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import Tooltip from '@/components/ui/Tooltip.astro';
import { partyHighlightStyle, partyScaleStyle, readableTextColor, sphereStyle } from '@/lib/color';
import { DEFAULT_DESCRIPTION, DEFAULT_SHARE_IMAGE, SITE_NAME, THEME_STORAGE_KEY, X_HANDLE, type ShareImage } from '@/lib/site';
import { routes } from '@/lib/routes';

interface Props {
  title: string;
  description?: string;
  /** Party color. When set with `accentLight`, the page takes the party theme. */
  accent?: string;
  accentLight?: string;
  /** Hide the page from search engines. */
  noindex?: boolean;
  /** The picture of the link preview (X, Instagram, WhatsApp…). Without it, the card of the site. */
  image?: ShareImage;
  /** `false` for a page with no Markdown version (the hidden design system). The others have one: `src/lib/markdown/`. */
  markdown?: boolean;
}

const { title, description = DEFAULT_DESCRIPTION, accent, accentLight, noindex = false, image = DEFAULT_SHARE_IMAGE, markdown = true } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
// The Markdown version is the file `index.md` next to the page (see `src/lib/markdown/shared.ts`).
const markdownHref = `${Astro.url.pathname.replace(/\/$/, '')}/index.md`;
const fullTitle = `${title} | ${SITE_NAME}`;
// A link preview needs the full URL of its picture.
const imageUrl = new URL(routes.asset(image.path), Astro.site).href;

// Party theme: the accent takes the party color (and its readable text). The brand stays black and white,
// and the yellow highlight is the same on every page.
const onAccent = accent ? readableTextColor(accent) : undefined;
// Every page has a color scale for blocks and bars (`--party-1` to `--party-4`). A party page builds it
// from the party color, and its bars and hovers take that color too. Other pages get a neutral scale.
const partyTheme =
  accent && accentLight
    ? [
        `--color-accent:${accent}`,
        `--color-accent-light:${accentLight}`,
        `--color-on-accent:${onAccent}`,
        partyScaleStyle(accent, accentLight),
        partyHighlightStyle(accentLight),
        // The sphere of the party page and the dot of the wordmark take the two colors of the party.
        sphereStyle(accent, accentLight),
      ].join(';')
    : partyScaleStyle().replace(/;--color-bar:.*$/, '');

// Favicon: a black dot on a white square. A party page keeps the square and puts a dot in the party color (the same as the sphere),
// with a black ring so that a light color still shows on the white.
const partyFavicon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect width="64" height="64" fill="#fff"/><circle cx="32" cy="32" r="19" fill="${accent}" stroke="#000" stroke-width="5"/></svg>`;
const faviconHref = accent && accentLight ? `data:image/svg+xml,${encodeURIComponent(partyFavicon)}` : routes.asset('/favicon.svg');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={bodyFontUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={displayFontUrl} as="font" type="font/woff2" crossorigin />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'max-image-preview:large'} />
    <link rel="canonical" href={canonicalUrl} />
    {markdown && <link rel="alternate" type="text/markdown" href={markdownHref} />}
    <link rel="sitemap" href={routes.asset('/sitemap-index.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={X_HANDLE} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={image.alt} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <!-- The ICO and the PNG are for search engines and old browsers (they need a file of their own, in a multiple of
         48 px); browsers that read SVG take the last icon, the SVG. `scripts/favicons.py` draws them. -->
    <link rel="icon" href={routes.asset('/favicon.ico')} sizes="48x48" />
    <link rel="icon" href={routes.asset('/favicon-192.png')} type="image/png" sizes="192x192" />
    <link rel="icon" href={faviconHref} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={routes.asset('/apple-touch-icon.png')} />
    <!-- Apply the saved theme before the first paint, so the page does not flash. The `js` class lets the CSS
         fold the phone menu only when the script that opens it can run. -->
    <script is:inline define:vars={{ storageKey: THEME_STORAGE_KEY }}>
      document.documentElement.classList.add('js');
      try {
        const saved = localStorage.getItem(storageKey);
        if (saved) document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
  </head>
  <body style={partyTheme}>
    <a class="skip-link" href="#content">Saltar al contenido</a>
    <SiteHeader />
    <main id="content">
      <slot />
    </main>
    <SiteFooter />
    <Tooltip />
    <script>
      // WebMCP: tools for the AI agent of the browser (`src/lib/webmcp/`). Only a browser that has the API downloads
      // them; for the others this is one check and nothing else.
      import { modelContext } from '@/lib/webmcp/context';
      if (modelContext()) import('@/lib/webmcp/tools').then(({ registerSiteTools }) => registerSiteTools());
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -999px;
    top: 8px;
    z-index: var(--z-skip-link);
    background: var(--color-highlight);
    color: var(--color-on-highlight);
    padding: 12px 16px;
    border: var(--border-thick) solid var(--color-ink);
    font-weight: 700;
  }
  .skip-link:focus { left: 8px; }
</style>
