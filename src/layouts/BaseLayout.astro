---
import '@/styles/global.css';
import '@fontsource/big-shoulders-display/900';
import '@fontsource-variable/archivo/wght.css';
import '@fontsource-variable/archivo/wght-italic.css';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import Tooltip from '@/components/ui/Tooltip.astro';
import { partyHighlightStyle, partyScaleStyle, readableTextColor, sphereStyle } from '@/lib/color';
import { DEFAULT_DESCRIPTION, SITE_NAME, THEME_STORAGE_KEY } from '@/lib/site';
import { routes } from '@/lib/routes';

interface Props {
  title: string;
  description?: string;
  /** Party color. When set with `accentLight`, the page takes the party theme. */
  accent?: string;
  accentLight?: string;
  /** Hide the page from search engines. */
  noindex?: boolean;
}

const { title, description = DEFAULT_DESCRIPTION, accent, accentLight, noindex = false } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = `${title} | ${SITE_NAME}`;

// Party theme: the accent takes the party color (and its readable text). The brand stays black and white,
// and the yellow highlight is the same on every page.
const onAccent = accent ? readableTextColor(accent) : undefined;
// Every page has a color scale for blocks and bars (`--party-1` to `--party-4`). A party page builds it
// from the party color, and its bars and hovers take that color too. Other pages get a neutral scale.
const partyTheme =
  accent && accentLight
    ? [
        `--color-accent:${accent}`,
        `--color-accent-light:${accentLight}`,
        `--color-on-accent:${onAccent}`,
        partyScaleStyle(accent, accentLight),
        partyHighlightStyle(accentLight),
        // The sphere of the party page and the dot of the wordmark take the two colors of the party.
        sphereStyle(accent, accentLight),
      ].join(';')
    : partyScaleStyle().replace(/;--color-bar:.*$/, '');

// Favicon: a black dot on a white square. A party page keeps the square and puts a dot in the party color (the same as the sphere),
// with a black ring so that a light color still shows on the white.
const partyFavicon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect width="64" height="64" fill="#fff"/><circle cx="32" cy="32" r="19" fill="${accent}" stroke="#000" stroke-width="5"/></svg>`;
const faviconHref = accent && accentLight ? `data:image/svg+xml,${encodeURIComponent(partyFavicon)}` : routes.asset('/favicon.svg');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href={routes.asset('/sitemap-index.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={faviconHref} type="image/svg+xml" />
    <!-- Apply the saved theme before the first paint, so the page does not flash. The `js` class lets the CSS
         fold the phone menu only when the script that opens it can run. -->
    <script is:inline define:vars={{ storageKey: THEME_STORAGE_KEY }}>
      document.documentElement.classList.add('js');
      try {
        const saved = localStorage.getItem(storageKey);
        if (saved) document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
  </head>
  <body style={partyTheme}>
    <a class="skip-link" href="#content">Saltar al contenido</a>
    <SiteHeader />
    <main id="content">
      <slot />
    </main>
    <SiteFooter />
    <Tooltip />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -999px;
    top: 8px;
    z-index: var(--z-skip-link);
    background: var(--color-highlight);
    color: var(--color-on-highlight);
    padding: 12px 16px;
    border: var(--border-thick) solid var(--color-ink);
    font-weight: 700;
  }
  .skip-link:focus { left: 8px; }
</style>
