---
/** Tells the reader that a program in another language has a translation, and where it is. */
import type { Program } from '@/lib/programs';
import { translationInfo } from '@/lib/translations';
import LanguageToggle from '@/components/party/LanguageToggle.astro';

interface Props {
  program: Program;
  /** On the page of the measures the hint says how to open it; on the party page it links there. */
  link?: string;
  /** Shows the original/Spanish toggle of the page. */
  toggle?: boolean;
}

const { program, link, toggle = false } = Astro.props;
const info = translationInfo(program.id);
---

{
  info && (
    <aside class="translation-notice" aria-label="Traducción al castellano">
      <p>
        <strong>El programa original está en {info.language}.</strong> Cada propuesta tiene una traducción automática al
        castellano, aparte: abre la propuesta y pulsa «Ver la traducción al castellano». {link && <a href={link}>Ver las propuestas</a>}
      </p>
      {toggle && <LanguageToggle program={program} />}
    </aside>
  )
}

<style>
  .translation-notice { margin: var(--space-3) 0; padding: 8px 12px; border: 2px dashed var(--color-ink); max-width: 60ch; }
  .translation-notice p { margin: 0; font-size: 0.9375rem; }
</style>
