---
/** Card of one party on the home page: acronym, a sphere that grows with the program, name, facts and the link. */
import { acronymWidths } from '@/lib/acronym-width';
import { measureNoun } from '@/lib/format';
import { presenceOf, provinceByCode, provincesOf } from '@/lib/presence';
import { relationSummary, relationsOf } from '@/lib/relations';
import { routes } from '@/lib/routes';
import { readableTextColor, sphereStyle } from '@/lib/color';
import type { Program } from '@/lib/programs';
import { announcedMeasures } from '@/lib/programs';

interface Props {
  program: Program;
}

const { program } = Astro.props;

const presence = presenceOf(program);
const provinceCodes = provincesOf(program);
const TOTAL_CONSTITUENCIES = 52;
const MAX_PROVINCES_LISTED = 3;

// Where it runs: the province names when there are few; otherwise a count.
const whereItRuns =
  provinceCodes.length === 0
    ? null
    : provinceCodes.length <= MAX_PROVINCES_LISTED
      ? provinceCodes.map((code) => provinceByCode[code]?.name ?? code).join(', ')
      : presence.scope === 'regional'
        ? `${provinceCodes.length} provincias de ${presence.regions.join(' y ')}`
        : `${provinceCodes.length} de ${TOTAL_CONSTITUENCIES} circunscripciones`;
const senateOnly = presence.congress.length === 0 && presence.senate.length > 0;
const relations = relationsOf(program);

// The announced measures (one source: `programs.ts`). A reserved number is told apart.
const count = announcedMeasures(program).length;
const reserved = program.measures.length - count;
const blockCount = program.blocks.length;
const isWeb = program.documentType === 'web';
// «249 medidas en 4 bloques, 82 páginas.» A program that lives on the party site has no pages.
const facts = [
  `${count} ${measureNoun(program, count)}${reserved ? ` (y ${reserved} por anunciar)` : ''} en ${blockCount} ${blockCount === 1 ? 'bloque' : 'bloques'}`,
  program.pageCount ? `${program.pageCount} páginas` : null,
]
  .filter(Boolean)
  .join(', ');

// The real width of the acronym in the display font, in em: the CSS gives it the biggest size that fits.
const acronym = acronymWidths(program.acronym);
// The sphere has the same size on every card. A party without a program has a small swatch.
const sphereSize = program.hasProgram ? 112 : 56;
---

<a
  class:list={['program-card', { 'is-unpublished': !program.hasProgram }]}
  href={routes.party(program.id)}
  style={`--party-color:${program.color}; --party-color-light:${program.lightColor}; --party-on-color:${readableTextColor(program.color)}; --acronym-line:${acronym.line}; --acronym-word:${acronym.word}; --sphere:${sphereSize}px; ${sphereStyle(program.color, program.lightColor)}`}
>
  <span class="program-card__top">
    <span class="program-card__acronym">{program.acronym.replace(/([+/-])/g, '$1​')}</span>
    {
      program.hasProgram ? (
        <span class="program-card__sphere" aria-hidden="true"><span></span></span>
      ) : (
        <span class="program-card__swatch" aria-hidden="true"></span>
      )
    }
  </span>
  <span class="program-card__party">{program.partyName}</span>
  {
    program.hasProgram ? (
      <>
        <h3>{program.programName}</h3>
        <span class="program-card__facts">{facts}.{isWeb ? ' Programa en la web del partido.' : ''}</span>
      </>
    ) : (
      <span class="program-card__facts">Aún no ha publicado su programa electoral.</span>
    )
  }
  {
    whereItRuns && (
      <span class="program-card__note">
        <strong>Se presenta {senateOnly ? 'al Senado ' : ''}en:</strong> {whereItRuns}
      </span>
    )
  }
  {
    relations.length > 0 && (
      <span class="program-card__note">
        <strong>Va junto a otros partidos:</strong>
        {relations.map((relation) => <span class="program-card__relation">{relationSummary(relation)}</span>)}
      </span>
    )
  }
  {program.notes[0] && <span class="program-card__warning">{program.notes[0]}</span>}
  <span class="program-card__link">{program.hasProgram ? 'Leer el programa' : 'Ver la ficha'}</span>
</a>

<style>
  /* The card is a size container: the acronym scales with its width (cqi). The grid around it draws the cell border. */
  .program-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    height: 100%;
    box-sizing: border-box;
    padding: 24px;
    color: var(--color-ink);
    text-decoration: none;
    container-type: inline-size;
  }
  .program-card:hover { background: var(--color-highlight); color: var(--color-on-highlight); }
  .program-card__top { position: relative; display: block; min-height: calc(var(--sphere) + 10px); }
  .program-card__acronym {
    display: block;
    max-width: calc(100% - var(--sphere) - 12px);
    font-family: var(--font-display);
    font-weight: 900;
    /* The acronym fits the space left of the sphere. `--acronym-line` is its real width in em on one line
       (`src/lib/acronym-width.ts`). When one line would need a size under 44px, the acronym breaks at a space,
       «-», «/» or «+», and its longest piece (`--acronym-word`) sets the size. A word never breaks inside. */
    --acronym-room: calc(100cqi - var(--sphere) - 12px);
    font-size: clamp(
      24px,
      max(calc(var(--acronym-room) / var(--acronym-line)), min(calc(var(--acronym-room) / var(--acronym-word)), 44px)),
      92px
    );
    line-height: 0.9;
    overflow-wrap: normal;
    /* The party color as a fine underline: it helps to find a party in the grid. */
    text-decoration: underline;
    text-decoration-color: var(--party-color);
    text-decoration-thickness: max(4px, 0.07em);
    text-underline-offset: 0.1em;
    text-decoration-skip-ink: none;
  }
  /* The sphere: a disc in the light color of the party with dots in its main color, lit from the top left. */
  .program-card__sphere {
    position: absolute;
    top: 0;
    right: 0;
    box-sizing: border-box;
    width: var(--sphere);
    height: var(--sphere);
    border: var(--border-thick) solid var(--color-ink);
    border-radius: 50%;
    overflow: hidden;
    background: var(--sphere-disc);
  }
  .program-card__sphere span {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, var(--sphere-dots) 1.7px, transparent 2.1px);
    background-size: 6px 6px;
    -webkit-mask-image: linear-gradient(135deg, transparent 30%, #000 95%);
    mask-image: linear-gradient(135deg, transparent 30%, #000 95%);
  }
  /* No program: no sphere. A light trama square, quiet and clearly not a program. */
  .program-card__swatch {
    position: absolute;
    top: 0;
    right: 0;
    box-sizing: border-box;
    width: var(--sphere);
    height: var(--sphere);
    border: var(--border-thick) solid var(--color-ink);
    color: inherit;
    background-image: var(--trama-light);
    background-size: var(--trama-size);
  }
  .program-card.is-unpublished { gap: 8px; }
  .program-card.is-unpublished .program-card__top { min-height: calc(var(--sphere) + 4px); }
  .program-card.is-unpublished .program-card__acronym {
    font-size: clamp(
      24px,
      max(calc(var(--acronym-room) / var(--acronym-line)), min(calc(var(--acronym-room) / var(--acronym-word)), 44px)),
      60px
    );
  }
  .program-card__party { font-size: 1rem; }
  .program-card h3 {
    font-family: var(--font-body);
    font-size: 1.5rem;
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: none;
    overflow-wrap: break-word;
  }
  .program-card__facts { font-size: 1rem; }
  .program-card__note { font-size: 0.9375rem; line-height: 1.4; }
  .program-card__note strong { font-weight: 700; }
  .program-card__relation { display: block; }
  .program-card__warning {
    border-left: var(--border-thick) solid var(--color-ink);
    padding-left: var(--space-3);
    font-size: 0.9375rem;
    line-height: 1.4;
  }
  .program-card__link {
    margin-top: auto;
    padding-top: 6px;
    font-weight: 700;
    font-size: 1.0625rem;
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 4px;
  }
  @media (max-width: 560px) {
    .program-card { padding: 18px; }
  }
</style>
