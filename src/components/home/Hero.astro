---
/**
 * Hero of the home page: the headline, the search and the halftone sphere.
 * The sphere is drawn at build time: one dot per measure of all the programs. It is a link to the categories:
 * there, the same sphere (same `view-transition-name`) turns into the pie chart of the categories, and each
 * slice goes to the page of its category.
 */
import { electionLabel } from '@eleccion/eleccion';
import { formatNumber } from '@/lib/format';
import { routes, SEARCH_PARAMS } from '@/lib/routes';
import { sphereCategories, sphereTotal } from '@/lib/sphere';
import HalftoneSphere from './HalftoneSphere.astro';

interface Props {
  /** JSON with the example parties for the placeholder of the search field. */
  examplesJson: string;
  /** Example reforms for the placeholder of the search field. */
  topics: string[];
}

const { examplesJson, topics } = Astro.props;

const total = formatNumber(sphereTotal);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__head">
      <p class="sr-only">{electionLabel}</p>
      <h1 id="hero-title" class="hero__title">
        <span>Lo que</span>
        <span>proponen,</span>
        <span>punto</span>
        <span>por punto</span>
      </h1>
      <p class="hero__lede">Cada punto de la esfera es una de las {total} medidas que publican los partidos que se presentan a las elecciones del 29 de noviembre.</p>
    </div>

    <div class="hero__sphere-wrap">
    <a
      class="hero__sphere"
      href={routes.categories()}
      aria-label={`Esfera de ${total} puntos: cada punto es una medida. Ver las medidas en ${sphereCategories.length} categorías.`}
    >
      <HalftoneSphere />
      <span class="hero__sphere-cta" aria-hidden="true">
        <strong>{sphereCategories.length}</strong>
        <span>categorías</span>
      </span>
    </a>
    <p class="hero__sphere-hint">Pulsa la esfera para ver las {total} medidas por categoría.</p>
    </div>

    <div class="hero__tools">
      <form class="hero__search" action={routes.search()} method="get" role="search">
        <label class="sr-only" for="hero-q">Busca un partido o una reforma</label>
        <input
          id="hero-q"
          name={SEARCH_PARAMS.query}
          type="search"
          placeholder="Busca un partido o una reforma: PP, Vivienda, IRPF…"
          data-examples={examplesJson}
          data-topics={JSON.stringify(topics)}
          autocomplete="off"
        />
        <button type="submit">Buscar</button>
      </form>

    </div>
  </div>
</section>

<style>
  .hero { padding: clamp(28px, 4vw, 40px) 0 clamp(32px, 4vw, 48px); }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(0, 1fr);
    grid-template-areas:
      'head sphere'
      'tools sphere';
    grid-template-rows: auto 1fr;
    gap: 20px clamp(24px, 3vw, 40px);
    align-items: start;
  }
  .hero__head { grid-area: head; min-width: 0; display: flex; flex-direction: column; gap: 20px; }
  .hero__tools { grid-area: tools; min-width: 0; display: flex; flex-direction: column; gap: 20px; }
  .hero__sphere-wrap { grid-area: sphere; min-width: 0; align-self: center; width: 100%; max-width: 680px; justify-self: end; }
  .hero__sphere {
    position: relative;
    display: block;
    width: 100%;
    border-radius: 50%;
    container-type: inline-size;
    color: var(--color-ink);
    text-decoration: none;
    view-transition-name: sphere;
  }
  .hero__sphere:hover { background: none; }
  .hero__sphere:focus-visible { outline-offset: 6px; }
  /* Hover: a paper plate with the number of categories says where the sphere goes. */
  .hero__sphere-cta {
    position: absolute;
    inset: 30%;
    display: grid;
    place-content: center;
    gap: 2px;
    border: var(--border-thick) solid var(--color-ink);
    border-radius: 50%;
    background: var(--color-paper);
    color: var(--color-ink);
    text-align: center;
    opacity: 0;
    transform: scale(0.88);
    transition: opacity var(--duration-base) var(--easing-out), transform var(--duration-base) var(--easing-out);
  }
  .hero__sphere-cta strong { font: 900 clamp(2.5rem, 16cqi, 5rem) / 0.9 var(--font-display); }
  .hero__sphere-cta span { font: 700 clamp(0.9375rem, 3.6cqi, 1.25rem) / 1.1 var(--font-body); }
  .hero__sphere:hover .hero__sphere-cta,
  .hero__sphere:focus-visible .hero__sphere-cta { opacity: 1; transform: none; }
  .hero__sphere-hint { margin: var(--space-2) 0 0; font-size: var(--text-sm); font-weight: 600; text-align: center; }

  .hero__title {
    margin: 0;
    font-size: clamp(3.75rem, 8.7vw, 7.375rem);
    line-height: 0.88;
  }
  .hero__title span { display: block; line-height: 0.86; }
  .hero__lede { margin: 0; max-width: 31em; font-size: 1.1875rem; font-weight: 600; }

  .hero__search {
    display: flex;
    align-items: stretch;
    max-width: 580px;
    border: var(--border-thick) solid var(--color-ink);
    background: var(--color-paper);
  }
  .hero__search input {
    flex: 1 1 auto;
    min-width: 0;
    height: 58px;
    border: 0;
    border-radius: 0;
    background: transparent;
    padding: 0 18px;
    color: var(--color-ink);
    font: 400 1.1875rem var(--font-body);
    text-overflow: ellipsis; /* a long placeholder ends in "…", it is not cut */
  }
  .hero__search input::placeholder { color: var(--color-ink-muted); opacity: 1; }
  .hero__search button {
    flex: 0 0 auto;
    min-width: 44px;
    padding: 0 28px;
    border: 0;
    border-radius: 0;
    background: var(--color-brand);
    color: var(--color-on-brand);
    font: 700 1.1875rem var(--font-body);
    cursor: pointer;
  }
  .hero__search button:hover { background: var(--color-highlight); color: var(--color-on-highlight); }
  /* The border of the form is the field: its outline sits inside, so it is not cut by the form. */
  .hero__search input:focus-visible { outline: 3px solid var(--color-ink); outline-offset: -8px; }
  .hero__search button:focus-visible { outline-color: var(--color-paper); outline-offset: -6px; }


  @media (prefers-reduced-motion: reduce) {
    .hero__sphere-cta { transition: none; }
  }

  @media (max-width: 820px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'head'
        'sphere'
        'tools';
      grid-template-rows: none;
    }
    .hero__sphere-wrap { justify-self: center; max-width: 420px; }
  }
  @media (max-width: 560px) {
    .hero__title { font-size: clamp(3.5rem, 19vw, 4.25rem); }
    .hero__lede { font-size: 1.0625rem; }
    .hero__search { flex-wrap: wrap; }
    .hero__search input { flex-basis: 100%; height: 54px; font-size: 1.0625rem; padding-inline: 14px; }
    .hero__search button { flex: 1 1 100%; min-height: 48px; }
    .hero__sphere-wrap { max-width: 300px; }
  }
</style>
