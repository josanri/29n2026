---
/**
 * Structure diagram: one row per section, one cell per measure.
 * The color identifies the block (with the block number beside it, never color alone).
 * Pending measures have diagonal hatching.
 */
import type { Program } from '@/lib/programs';
import { categoryById } from '@/lib/taxonomy';
import { padNumber } from '@/lib/format';
import { blockColor } from '@/lib/blocks';
import { routes } from '@/lib/routes';
import { tooltip } from '@/lib/tooltip';

interface Props {
  program: Program;
}

const { program } = Astro.props;
---

<div class="measure-map">
  {
    program.blocks.map((block) => (
      <section class="measure-map__block" style={`--block-color: ${blockColor(block.id)}`}>
        <h4 class="measure-map__block-title">
          <a href={routes.block(program.id, block.id)}>
            <span class="mono">{padNumber(block.id)}</span> {block.title}
          </a>
        </h4>
        {program.sections
          .filter((section) => section.blockId === block.id)
          .map((section) => {
            const sectionMeasures = program.measures.filter((measure) => measure.sectionId === section.id);
            return (
              <div class="measure-map__row">
                <a class="measure-map__section" href={routes.section(program.id, block.id, section.id)} title={section.title}>
                  <span class="mono">{section.id}</span>
                  <span class="measure-map__section-title">{section.phraseTitle}</span>
                </a>
                <div class="measure-map__cells">
                  {sectionMeasures.map((measure) => (
                    <a
                      class:list={['measure-map__cell', { 'is-pending': measure.isPending }]}
                      href={routes.measure(program.id, measure.number)}
                      aria-label={
                        measure.isPending
                          ? `Medida ${measure.number}: pendiente de anunciar`
                          : `Medida ${measure.number}: ${measure.phraseTitle}`
                      }
                      data-tooltip={
                        measure.isPending
                          ? tooltip(`Nº ${measure.number}`, `${program.measureUnit} pendiente de anunciar`)
                          : tooltip(`Nº ${measure.number} · ${categoryById[measure.categoryId].code}`, measure.phraseTitle)
                      }
                    />
                  ))}
                  <span class="measure-map__count mono">{sectionMeasures.length}</span>
                </div>
              </div>
            );
          })}
      </section>
    ))
  }
</div>

<style>
  .measure-map {
    display: grid;
    gap: 22px;
  }
  .measure-map__block-title {
    font-size: 1.25rem; /* large bold text: 3:1 is enough on the block color */
    margin-bottom: 10px;
    display: flex;
  }
  .measure-map__block-title a {
    text-decoration: none;
    background: var(--block-color);
    color: var(--color-on-block);
    border: var(--border-thick) solid var(--color-ink);
    padding: 6px 10px 4px;
    box-shadow: var(--shadow-sm);
  }
  .measure-map__block-title a:hover { background: var(--color-highlight); }
  .measure-map__row {
    display: grid;
    grid-template-columns: minmax(170px, 300px) 1fr;
    gap: 14px;
    align-items: center;
    padding: 5px 0;
    border-bottom: 1px dashed color-mix(in srgb, var(--color-ink) 30%, transparent);
  }
  .measure-map__section {
    display: flex;
    gap: var(--space-2);
    font-size: 0.8125rem;
    line-height: 1.2;
    text-decoration: none;
    min-width: 0;
  }
  .measure-map__section .mono { font-weight: 700; flex: 0 0 34px; }
  .measure-map__section-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .measure-map__section-title::first-letter { text-transform: uppercase; }
  .measure-map__cells {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    align-items: center;
  }
  .measure-map__cell {
    width: 22px;
    height: 22px;
    background: var(--block-color);
    border: var(--border-thin) solid var(--color-ink);
    display: block;
    transition: transform var(--duration-fast);
  }
  .measure-map__cell:hover,
  .measure-map__cell:focus-visible {
    background: var(--color-highlight);
    transform: translate(-2px, -2px);
    box-shadow: 3px 3px 0 var(--color-ink);
  }
  .measure-map__cell.is-pending {
    background: var(--color-paper) repeating-linear-gradient(45deg, var(--color-ink) 0 2px, transparent 2px 6px);
  }
  .measure-map__count {
    font-size: var(--text-xs);
    font-weight: 700;
    margin-left: 6px;
    color: var(--color-ink-subtle);
  }
  @media (max-width: 640px) {
    .measure-map__row { grid-template-columns: 1fr; gap: 6px; }
    .measure-map__cell { width: 18px; height: 18px; }
  }
</style>
