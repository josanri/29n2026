---
/**
 * Sorted horizontal bars (one series). The bar has the color of the party on a party page, and ink on other pages.
 * Each bar has its value as a direct label and a tooltip.
 */
import { percentOf } from '@/lib/format';
import { tooltip } from '@/lib/tooltip';

export interface BarItem {
  id: string;
  label: string;
  count: number;
  /** Short code shown before the label, for example a category code. */
  code?: string;
  href?: string;
  /** Replaces the default tooltip. Build it with `tooltip()`. */
  tooltip?: string;
}

interface Props {
  items: BarItem[];
  /** The whole that each bar is a share of. It feeds the tooltip. */
  total: number;
  max?: number;
  unit?: string;
  singularUnit?: string;
}

const { items, total, unit = 'medidas', singularUnit } = Astro.props;
const max = Astro.props.max ?? Math.max(...items.map((item) => item.count));
---

<ol class="bar-list">
  {
    items.map((item) => {
      const width = (item.count / max) * 100;
      const itemUnit = item.count === 1 && singularUnit ? singularUnit : unit;
      const itemTooltip =
        item.tooltip ?? tooltip(item.label, `${item.count} ${itemUnit} (${percentOf(item.count, total)} % del total)`);
      const Element = item.href ? 'a' : 'div';
      return (
        <li>
          <Element class="bar-list__row" href={item.href} data-tooltip={itemTooltip}>
            <span class="bar-list__label">
              {item.code && <span class="bar-list__code">{item.code}</span>}
              {item.label}
            </span>
            <span class="bar-list__track">
              <span class="bar-list__bar" style={`width:calc((100% - 44px) * ${Math.max(width, 1.5) / 100})`}></span>
              <span class="bar-list__value">{item.count}</span>
            </span>
          </Element>
        </li>
      );
    })
  }
</ol>

<style>
  /* One shared label column, as wide as the longest label (at most 45%): no empty space between the text and the bars. */
  .bar-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: fit-content(45%) minmax(0, 1fr);
    column-gap: var(--space-4);
    border-bottom: var(--border-thick) solid var(--color-ink);
  }
  .bar-list li,
  .bar-list__row {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
  }
  .bar-list li { border-top: var(--border-fine) solid var(--color-ink); }
  .bar-list li:first-child { border-top: 0; }
  .bar-list__row {
    align-items: center;
    min-height: 46px;
    padding: 4px 6px;
    text-decoration: none;
  }
  a.bar-list__row:hover { background: var(--color-highlight); color: var(--color-on-highlight); }
  .bar-list__label {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.2;
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }
  .bar-list__code {
    flex: none;
    display: inline-grid;
    place-items: center;
    min-width: 2.5rem;
    height: 1.375rem;
    padding: 0 4px;
    background: var(--color-ink);
    color: var(--color-paper);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  a.bar-list__row:hover .bar-list__code { background: var(--color-on-highlight); color: var(--color-highlight); }
  .bar-list__track {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-width: 0;
  }
  .bar-list__bar {
    height: 14px;
    flex: 0 0 auto;
    background: var(--color-bar);
  }
  a.bar-list__row:hover .bar-list__bar { background: var(--color-on-highlight); }
  .bar-list__value {
    font-size: 1rem;
    font-weight: 700;
    flex: 0 0 auto;
  }
  @media (max-width: 520px) {
    .bar-list, .bar-list li, .bar-list__row { grid-template-columns: minmax(0, 1fr); }
    .bar-list__row { row-gap: var(--space-1); }
  }
</style>
