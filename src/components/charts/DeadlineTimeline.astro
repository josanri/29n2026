---
/**
 * The commitments with an explicit deadline, grouped by kind, from the nearest to the farthest.
 * Each kind is a vertical list: a square node for each deadline, the deadline in the display font and its measures.
 */
import type { DeadlineEntry, Program } from '@/lib/programs';
import { compareText, measureNoun } from '@/lib/format';
import { unique } from '@/lib/collections';
import { routes } from '@/lib/routes';
import { deadlineKind, deadlineKindLabel, deadlineKindOrder, deadlineRank } from '@/lib/deadlines';

interface Props {
  program: Program;
}

const { program } = Astro.props;

const entries: DeadlineEntry[] =
  program.deadlines.length > 0
    ? program.deadlines
    : program.measures.flatMap((measure) =>
        measure.deadline
          ? [{ deadline: measure.deadline, text: measure.phraseTitle, measureNumber: measure.number }]
          : [],
      );

// Sorted by time, not by the order in the data file: the file order is not always chronological.
const order = unique(entries.map((entry) => entry.deadline)).sort(
  (a, b) => deadlineRank(a) - deadlineRank(b) || compareText(a, b),
);

const groups = deadlineKindOrder
  .map((kind) => ({
    kind,
    ...deadlineKindLabel[kind],
    milestones: order
      .filter((deadline) => deadlineKind(deadline) === kind)
      .map((deadline) => ({
        deadline,
        entries: entries.filter((entry) => entry.deadline === deadline),
      })),
  }))
  .filter((group) => group.milestones.length > 0);
---

{
  groups.map((group) => (
    <section class="timeline-group">
      <h3 class="timeline-group__title">{group.title}</h3>
      <p class="timeline-group__lead">{group.lead}</p>
      <ol class="timeline">
        {group.milestones.map((milestone, index) => (
          <li class="timeline__milestone" id={`plazo-${group.kind}-${index}`}>
            <div class="timeline__when">
              <span class="timeline__deadline">{milestone.deadline}</span>
              <span class="timeline__count">{milestone.entries.length} {measureNoun(program, milestone.entries.length)}</span>
            </div>
            <ul class="timeline__entries">
              {milestone.entries.map((entry) => (
                <li>
                  <span class="timeline__text">{entry.text}</span>
                  <a href={routes.measure(program.id, entry.measureNumber)}>
                    Medida {entry.measureNumber}<span class="sr-only">: {entry.text}</span>
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </section>
  ))
}

<style>
  .timeline-group + .timeline-group { margin-top: var(--space-7, 56px); }
  .timeline-group__title { font-size: 2.25rem; margin: 0; }
  .timeline-group__lead { margin: var(--space-1) 0 var(--space-4); max-width: 70ch; }

  /* The list: a vertical line on the left with a square node for each deadline. */
  .timeline {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0 0 0 48px;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 11px;
    top: 14px;
    bottom: 14px;
    width: 4px;
    background: var(--color-ink);
  }
  .timeline__milestone {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 260px) minmax(0, 1fr);
    column-gap: 24px;
    padding: var(--space-4) 0;
    scroll-margin-top: 96px;
  }
  .timeline__milestone + .timeline__milestone { border-top: var(--border-fine) solid var(--color-ink); }
  .timeline__milestone::before {
    content: '';
    position: absolute;
    left: -48px;
    top: calc(var(--space-4) + 2px);
    width: 26px;
    height: 26px;
    box-sizing: border-box;
    border: var(--border-thick) solid var(--color-ink);
    background: var(--color-highlight);
  }
  .timeline__milestone:target::before { background: var(--color-ink); }
  .timeline__when { display: grid; gap: 6px; align-content: start; }
  .timeline__deadline {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 2.25rem;
    line-height: 1;
    text-transform: uppercase;
    padding-top: 2px;
    overflow-wrap: anywhere;
  }
  .timeline__count { font: 700 0.9375rem var(--font-body); }
  .timeline__entries {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .timeline__entries li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 24px;
    min-height: 56px;
    border-top: var(--border-fine) solid var(--color-ink);
  }
  .timeline__entries li:first-child { border-top: 0; }
  .timeline__text { font-size: 1.1875rem; font-weight: 600; line-height: 1.3; padding-block: 6px; }
  .timeline__entries a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 4px;
  }
  @media (max-width: 720px) {
    .timeline { padding-left: 40px; }
    .timeline::before { left: 9px; }
    .timeline__milestone { grid-template-columns: minmax(0, 1fr); gap: var(--space-2); }
    .timeline__milestone::before { left: -40px; width: 22px; height: 22px; }
    .timeline__deadline { font-size: 1.875rem; }
    .timeline__entries li { grid-template-columns: minmax(0, 1fr); }
  }
</style>
