---
/**
 * Segmented bar: the weight of each block in the total of measures. Each block has one step of the
 * color scale of the party, from dark to light. Under the bar, one cell per block.
 */
import type { Program } from '@/lib/programs';
import { measureNoun, padNumber, percentOf } from '@/lib/format';
import { blockColor } from '@/lib/blocks';
import { routes } from '@/lib/routes';
import { tooltip } from '@/lib/tooltip';

interface Props {
  program: Program;
}

const { program } = Astro.props;
const total = program.measures.length;
const segments = program.blocks.map((block) => {
  const blockMeasures = program.measures.filter((measure) => measure.blockId === block.id);
  return {
    block,
    count: blockMeasures.length,
    pending: blockMeasures.filter((measure) => measure.isPending).length,
    sections: program.sections.filter((section) => section.blockId === block.id).length,
    color: blockColor(block.id).color,
  };
});
---

<div>
  <div
    class="block-bar"
    role="group"
    aria-label={`Distribución de ${program.measureUnitPlural} por bloque`}
  >
    {
      segments.map(({ block, count, pending, sections, color }) => (
        <a
          class="block-bar__segment"
          href={routes.block(program.id, block.id)}
          aria-label={`Bloque ${block.id}, ${block.title}: ${count} ${measureNoun(program, count)}`}
          style={`flex:${count} 1 0;background:${color}`}
          data-tooltip={tooltip(
            `${padNumber(block.id)}. ${block.title}`,
            `${count} ${measureNoun(program, count)} (${percentOf(count, total)} %)`,
            `${sections} secciones${pending ? `, ${pending} por anunciar` : ''}`,
          )}
        ></a>
      ))
    }
  </div>
  <div class="block-cells">
    {
      segments.map(({ block, count, color }) => (
        <a class="block-cells__cell" href={routes.block(program.id, block.id)}>
          <span class="block-cells__top">
            <span class="block-cells__number">{block.id}</span>
            <span class="block-cells__swatch" aria-hidden="true" style={`background:${color}`}></span>
          </span>
          <span class="block-cells__title">{block.title}</span>
          {block.motto && <span class="block-cells__motto">{block.motto}</span>}
          <span class="block-cells__count">
            {count} {measureNoun(program, count)} ({percentOf(count, total)} %)
          </span>
        </a>
      ))
    }
  </div>
</div>

<style>
  .block-bar {
    display: flex;
    height: 64px;
    border: var(--border-thick) solid var(--color-ink);
    color: var(--color-ink);
  }
  .block-bar__segment {
    border-right: var(--border-thick) solid var(--color-ink);
    min-width: 0;
  }
  .block-bar__segment:last-child { border-right: 0; }
  /* A program with many blocks: the border of the thin segments must not add up to more than the bar */
  @media (max-width: 560px) {
    .block-bar { overflow: hidden; }
    .block-bar__segment { border-right-width: var(--border-fine); }
  }
  /* Hover and focus: the segment keeps its color and gets a frame of paper and ink inside it. */
  .block-bar__segment:hover,
  .block-bar__segment:focus-visible {
    box-shadow: inset 0 0 0 var(--border-thick) var(--color-paper), inset 0 0 0 calc(var(--border-thick) * 2) var(--color-ink);
  }

  /* The cells of the blocks: they share their borders. */
  .block-cells {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 270px), 1fr));
    margin-top: var(--space-5);
    border-top: var(--border-thick) solid var(--color-ink);
    border-left: var(--border-thick) solid var(--color-ink);
  }
  .block-cells__cell {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 22px 24px;
    border-right: var(--border-thick) solid var(--color-ink);
    border-bottom: var(--border-thick) solid var(--color-ink);
    color: var(--color-ink);
    text-decoration: none;
  }
  .block-cells__cell:hover { background: var(--color-highlight); color: var(--color-on-highlight); }
  .block-cells__top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .block-cells__number { font-family: var(--font-display); font-weight: 900; font-size: 5.25rem; line-height: 0.9; }
  .block-cells__swatch {
    flex: none;
    box-sizing: border-box;
    width: 56px;
    height: 56px;
    border: var(--border-thick) solid var(--color-ink);
    color: inherit;
  }
  .block-cells__title { font-size: 1.4375rem; line-height: 1.18; font-weight: 700; overflow-wrap: anywhere; }
  .block-cells__motto { font-size: 1rem; line-height: 1.4; }
  .block-cells__count { margin-top: auto; font-weight: 700; }
</style>
