---
/**
 * The «rosa»: the sphere as a ring of petals, one per category, from the biggest, from the top and clockwise.
 * - Every category has the same angle. The AREA of its petal (from the hole) is its count, so a small category
 *   is as easy to see and to point at as a big one.
 * - The code and the share sit at the rim, horizontal, with no line. The list beside the rose has the full name
 *   and the count. No text is rotated and no text sits on the halftone.
 * - A petal and its row in the list are links to the same place. Pointing at one lights the two, and the hole
 *   shows the code, the share and the count.
 * On a wide screen the list is at the left and the rose at the right. On a narrow screen the list goes under the rose, the codes are bigger and the shares stay in the list only.
 * Colors: `--sphere-disc` of a party page; the yellow of the brand elsewhere.
 */
export interface RosePetal {
  id: string;
  href: string;
  code: string;
  name: string;
  count: number;
  /** Share of the total, as text: «8,6». */
  percent: string;
}

interface Props {
  petals: RosePetal[];
  /** What the hole shows when no petal is under the pointer: a figure and a word under it. */
  defaultFigure: string;
  defaultLabel: string;
  /** What an item is, for the accessible name of each petal: «medidas». */
  unit: string;
  label: string;
}

const { petals: given, defaultFigure, defaultLabel, unit, label } = Astro.props;
const petals = [...given].filter((petal) => petal.count > 0).sort((a, b) => b.count - a.count);
const max = Math.max(1, ...petals.map((petal) => petal.count));

// The drawing: a 580 × 580 box. The rim has a radius of 205; the codes sit outside it.
const SIZE = 580;
const C = SIZE / 2;
const RIM = 205;
const HOLE = 70;
const LABEL = 243;
const point = (angle: number, radius: number): [number, number] => [C + radius * Math.cos(angle), C + radius * Math.sin(angle)];
const fmt = ([x, y]: [number, number]) => `${x.toFixed(2)} ${y.toFixed(2)}`;
const wedge = (from: number, to: number, radius: number) =>
  `M${fmt(point(from, HOLE))} L${fmt(point(from, radius))} A${radius.toFixed(2)} ${radius.toFixed(2)} 0 0 1 ${fmt(point(to, radius))} L${fmt(point(to, HOLE))} A${HOLE} ${HOLE} 0 0 0 ${fmt(point(from, HOLE))} Z`;

const step = (2 * Math.PI) / Math.max(petals.length, 2);
const parts = petals.map((petal, index) => {
  const from = -Math.PI / 2 + index * step;
  const to = from + step;
  // The area of the petal, from the hole to its edge, is in proportion to the count.
  const radius = Math.sqrt(HOLE * HOLE + (RIM * RIM - HOLE * HOLE) * (petal.count / max));
  const [x, y] = point(from + step / 2, LABEL);
  return { ...petal, track: wedge(from, to, RIM), d: wedge(from, to, radius), x, y };
});
---

<div class="rose" data-rose>
  <div class:list={['rose__grid', { 'rose__grid--intro': Astro.slots.has('default') }]}>
    {/* Optional: the heading and the text of the host page, above the list and beside the rose. */}
    {Astro.slots.has('default') && <div class="rose__intro"><slot /></div>}
    <div class="rose__fig">
      <svg viewBox={`0 0 ${SIZE} ${SIZE}`} role="group" aria-label={label}>
        <defs>
          <pattern id="rose-track" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
            <rect width="7" height="7" class="rose__track-bg"></rect>
            <circle cx="3.5" cy="3.5" r="1" class="rose__track-dot"></circle>
          </pattern>
        </defs>
        {/* All the tracks go first, under all the petals: a track never covers the edge of the petal beside it. */}
        <g aria-hidden="true">{parts.map((part) => <path class="rose__track" d={part.track}></path>)}</g>
        {parts.map((part) => (
          <a
            href={part.href}
            data-category={part.id}
            data-code={part.code}
            data-share={`${part.percent} %`}
            data-count={`${part.count} ${unit}`}
            aria-label={`${part.name}: ${part.count} ${unit} (${part.percent} %)`}
          >
            <path class="rose__hit" d={part.track}></path>
            <path class="rose__petal" d={part.d}></path>
            <text class="rose__code" x={part.x.toFixed(2)} y={part.y.toFixed(2)} text-anchor="middle">{part.code}</text>
            <text class="rose__share" x={part.x.toFixed(2)} y={(part.y + 17).toFixed(2)} text-anchor="middle">{part.percent} %</text>
          </a>
        ))}
        <circle class="rose__rim" cx={C} cy={C} r={RIM}></circle>
      </svg>
      <span class="rose__hole" aria-hidden="true">
        <strong data-rose-figure data-default={defaultFigure}>{defaultFigure}</strong>
        <span data-rose-label data-default={defaultLabel}>{defaultLabel}</span>
        <small data-rose-count></small>
      </span>
    </div>
    <ol class="rose__list">
      {parts.map((part) => (
        <li>
          <a href={part.href} data-category={part.id} data-code={part.code} data-share={`${part.percent} %`} data-count={`${part.count} ${unit}`}>
            <span class="rose__list-code">{part.code}</span>
            <span class="rose__list-name">{part.name}</span>
            <span class="rose__list-count">{part.count}<span class="sr-only"> {unit}</span></span>
            <span class="rose__list-share">{part.percent} %</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</div>

<script>
  // A petal and its row are a pair: the one under the pointer or with focus lights the two, and the hole shows it.
  for (const rose of document.querySelectorAll<HTMLElement>('[data-rose]')) {
    const figure = rose.querySelector<HTMLElement>('[data-rose-figure]')!;
    const label = rose.querySelector<HTMLElement>('[data-rose-label]')!;
    const count = rose.querySelector<HTMLElement>('[data-rose-count]')!;
    const links = [...rose.querySelectorAll<HTMLElement | SVGAElement>('a[data-category]')];
    const show = (link: HTMLElement | SVGAElement | null) => {
      const id = link?.dataset.category;
      for (const other of links) other.classList.toggle('is-on', other.dataset.category === id);
      figure.textContent = link?.dataset.code ?? figure.dataset.default!;
      label.textContent = link?.dataset.share ?? label.dataset.default!;
      count.textContent = link?.dataset.count ?? count.dataset.default ?? '';
    };
    const linkOf = (target: EventTarget | null) => (target as Element | null)?.closest<HTMLElement | SVGAElement>('a[data-category]') ?? null;
    rose.addEventListener('pointerover', (event) => show(linkOf(event.target)));
    rose.addEventListener('pointerleave', () => show(null));
    rose.addEventListener('focusin', (event) => show(linkOf(event.target)));
    rose.addEventListener('focusout', () => show(null));
  }
</script>

<style>
  /* The rose is never taller than the window under the sticky header: the reader always sees all of it. */
  .rose { --rose-size: min(680px, calc(100svh - 150px)); width: 100%; container: rose / inline-size; }
  .rose__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-5); align-items: start; }
  .rose__intro { min-width: 0; }
  .rose__fig { position: relative; width: 100%; max-width: var(--rose-size); justify-self: center; container: rose-fig / inline-size; }
  .rose__fig svg { display: block; width: 100%; height: auto; overflow: visible; }
  /* A narrow space: the text, the rose and the list, one under the other.
     A wide space: the text and the list at the left, the rose at the right from the top. The rose gets its full
     size first; the list takes the rest. The rose stays in view while the reader goes down the list. */
  @container rose (min-width: 900px) {
    .rose__grid {
      grid-template-columns: minmax(300px, 1fr) minmax(0, var(--rose-size));
      grid-template-areas: 'list fig';
      gap: var(--space-5) clamp(24px, 4cqi, 64px);
    }
    .rose__grid--intro { grid-template-areas: 'intro fig' 'list fig'; grid-template-rows: auto 1fr; }
    .rose__intro { grid-area: intro; }
    .rose__list { grid-area: list; max-width: 760px; }
    .rose__fig { grid-area: fig; position: sticky; top: 96px; justify-self: end; }
  }

  /* The track: the room that the biggest category fills, in a light halftone. The petal: the color of the disc,
     with an ink edge, so it also reads on the paper of the two themes. */
  .rose__track-bg { fill: var(--color-paper); }
  .rose__track-dot { fill: var(--color-ink-muted); }
  .rose__track { fill: url(#rose-track); stroke: var(--color-paper); stroke-width: 1.5; }
  /* The whole sector of a category takes the pointer, also where its petal is short. */
  .rose__hit { fill: transparent; stroke: transparent; stroke-width: 2; stroke-linejoin: round; }
  .rose__petal { fill: var(--sphere-disc, var(--color-highlight)); stroke: var(--color-ink); stroke-width: 2; stroke-linejoin: round; }
  .rose__rim { fill: none; stroke: var(--color-ink); stroke-width: 3; pointer-events: none; }
  /* The codes and the shares: ink text on the paper of the page, never on the halftone. */
  .rose__code { fill: var(--color-ink); font: 800 15px var(--font-body); letter-spacing: 0.4px; }
  .rose__share { fill: var(--color-ink-muted); font: 600 14px var(--font-body); font-variant-numeric: tabular-nums; }
  .rose a { outline: none; cursor: pointer; }
  /* The petal under the pointer, with focus or with its row under the pointer is solid ink; its code has the
     yellow marker. */
  .rose svg a:is(:hover, :focus-visible, .is-on, .is-active) .rose__petal { fill: var(--color-ink); }
  .rose svg a:is(:hover, :focus-visible, .is-on, .is-active) .rose__hit { stroke: var(--color-ink); }
  .rose svg a:is(:hover, :focus-visible, .is-on, .is-active) .rose__code { paint-order: stroke; stroke: var(--color-highlight); stroke-width: 8px; stroke-linejoin: round; fill: var(--color-on-highlight); }
  .rose svg a:is(:hover, :focus-visible, .is-on, .is-active) .rose__share { fill: var(--color-ink); font-weight: 800; }

  /* The hole: paper with an ink ring. Its size follows the rose (a radius of 70 of the 580 units). */
  .rose__hole {
    position: absolute;
    left: 50%;
    top: 50%;
    width: calc(100cqi * 140 / 580);
    height: calc(100cqi * 140 / 580);
    transform: translate(-50%, -50%);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    overflow: hidden;
    border: var(--border-thin) solid var(--color-ink);
    border-radius: 50%;
    background: var(--color-paper);
    color: var(--color-ink);
    text-align: center;
    white-space: nowrap;
    pointer-events: none;
  }
  .rose__hole strong { font: 900 clamp(1.375rem, 6.4cqi, 2.375rem) / 1 var(--font-display); }
  .rose__hole span { font: 700 clamp(0.875rem, 2.9cqi, 1.0625rem) / 1.1 var(--font-body); font-variant-numeric: tabular-nums; }
  .rose__hole small { font: 600 0.875rem / 1.1 var(--font-body); }
  .rose__hole small:empty { display: none; }

  /* A narrow rose: the codes are bigger, and the shares and the count stay in the list only. */
  @container rose-fig (max-width: 479px) {
    .rose__code { font-size: 24px; dominant-baseline: middle; }
    .rose__share, .rose__hole small { display: none; }
  }

  /* The list: the full name and the count of each petal, in the same order. */
  .rose__list { list-style: none; margin: 0; padding: 0; min-width: 0; border-bottom: var(--border-fine) solid var(--color-ink); }
  .rose__list a {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr) auto 4.2em;
    align-items: center;
    gap: 12px;
    padding: 3px 6px;
    border-top: var(--border-fine) solid var(--color-ink);
    color: var(--color-ink);
    font: 600 var(--text-sm) / 1.25 var(--font-body);
    text-decoration: none;
  }
  .rose__list a:is(:hover, :focus-visible, .is-on):not(.is-active) { background: var(--color-highlight); color: var(--color-on-highlight); }
  /* The active filter of the host page: ink, like a pressed button. */
  .rose__list a.is-active { background: var(--color-ink); color: var(--color-paper); }
  .rose__list a.is-active .rose__list-code { background: var(--color-paper); color: var(--color-ink); }
  .rose__list-code {
    display: grid;
    place-items: center;
    height: 22px;
    background: var(--color-ink);
    color: var(--color-paper);
    font: 700 var(--text-xs) var(--font-body);
    letter-spacing: 0.04em;
  }
  .rose__list a:is(:hover, :focus-visible, .is-on):not(.is-active) .rose__list-code { background: var(--color-on-highlight); color: var(--color-highlight); }
  .rose__list-name { font-weight: 700; overflow-wrap: anywhere; }
  .rose__list-count, .rose__list-share { text-align: right; font-variant-numeric: tabular-nums; }
  .rose__list-count { font-weight: 800; }
  /* A touch screen: each row is tall enough for a finger. */
  @media (pointer: coarse), (max-width: 760px) {
    .rose__list a { min-height: 44px; padding-block: 8px; }
  }
</style>
