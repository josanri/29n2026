---
/**
 * A hemicycle: one circle for each seat (the 350 of the Congress by default), from the left to the right.
 * The page script gives each circle its color and its tooltip (`data-seat` is the index of the seat).
 * Color is never the only sign: the legend and the tooltip name the group of each seat.
 */
import { HEMICYCLE, hemicyclePositions } from '@/lib/simulator';

interface Props {
  /** Accessible name of the figure. The script updates it with the numbers. */
  label: string;
  id?: string;
  /** Number of seats: the 350 of the Congress when it is not given (the 208 elected senators on /resultados/). */
  seats?: number;
  /** Rows of seats: fewer seats need fewer rows to keep the same gaps. */
  rows?: number;
}

const { label, id, seats, rows } = Astro.props;
const { positions, seatRadius } = hemicyclePositions(seats, rows);
---

<svg
  {id}
  class="hemicycle"
  viewBox={`0 0 ${HEMICYCLE.width} ${HEMICYCLE.height}`}
  role="img"
  aria-label={label}
>
  {positions.map((position, index) => <circle data-seat={index} cx={position.x} cy={position.y} r={seatRadius} />)}
  <!-- The page puts its own text in the middle of the hemicycle. -->
  <slot />
</svg>

<style>
  .hemicycle { display: block; width: 100%; height: auto; overflow: visible; }
  .hemicycle :global(circle) {
    fill: var(--color-paper);
    stroke: var(--color-ink);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    transition: fill var(--duration-fast);
  }
  @media (prefers-reduced-motion: reduce) {
    .hemicycle :global(circle) { transition: none; }
  }
</style>
