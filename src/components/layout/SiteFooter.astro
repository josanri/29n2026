---
import { election } from '@eleccion/eleccion';
import { routes } from '@/lib/routes';
import { SOCIAL_ACCOUNTS } from '@/lib/site';
import XIcon from '@/assets/icons/x.svg';
import InstagramIcon from '@/assets/icons/instagram.svg';

// The official marks of each network (see `src/assets/icons/README.md`), drawn in the color of the text.
// Astro imports each SVG file as a component and puts the SVG inline.
const icons = { x: XIcon, instagram: InstagramIcon } satisfies Record<(typeof SOCIAL_ACCOUNTS)[number]['id'], unknown>;
import Wordmark from './Wordmark.astro';
---

<footer class="site-footer">
  <!-- data-nosnippet: the same footer is on every page; a search result quotes the page, not this text. -->
  <div class="container site-footer__row" data-nosnippet>
    <div class="site-footer__top">
      <Wordmark class="site-footer__mark" />
      <p>
        Lectura y análisis de los programas electorales para las {election.name.toLowerCase()} del {election.longDate}. El
        texto de cada medida es el del documento oficial del partido. Las categorías, los colectivos y las palancas son una
        clasificación editorial de esta web.
      </p>
    </div>
    <p class="site-footer__legal" role="note">
      <strong>Aviso legal:</strong> esta web es informativa e independiente. No está vinculada a ningún partido, a la
      Administración electoral ni a ningún organismo público. No es una fuente oficial ni ofrece asesoramiento de voto.
      Puede haber errores de extracción o de clasificación: consulta siempre el programa oficial de cada partido antes de
      citarlo o de tomar una decisión.
    </p>
    <ul class="site-footer__meta">
      <li><a href={routes.accessibility()}>Accesibilidad</a></li>
      <li><a href={routes.legal()}>Aviso legal</a></li>
      <li><a href={routes.feed()} type="application/rss+xml">RSS<span class="sr-only">: programas, encuestas y debates</span></a></li>
      {SOCIAL_ACCOUNTS.map((account) => {
        const NetworkIcon = icons[account.id];
        return (
          <li>
            <a class="site-footer__social" href={account.url} rel="me noopener" target="_blank">
              <span class="site-footer__icon"><NetworkIcon /></span>
              <span class="sr-only">{account.network}: </span>{account.handle}<span class="sr-only"> (se abre en otra pestaña)</span>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 96px;
    border-top: var(--border-thick) solid var(--color-ink);
    background: var(--color-paper);
    color: var(--color-ink);
  }
  .site-footer__row {
    padding-top: 32px;
    padding-bottom: 36px;
    font-size: 1rem;
    max-width: var(--layout-width);
  }
  .site-footer__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
  }
  .site-footer :global(.site-footer__mark) { font-size: 2rem; }
  .site-footer p { max-width: 60ch; margin: 0; }
  .site-footer__legal {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: var(--border-fine) solid var(--color-ink);
    font-size: 0.9375rem;
  }
  /* Accessibility and the accounts of the site on X and Instagram, in one row that wraps. */
  .site-footer__meta { display: flex; flex-wrap: wrap; gap: 0 var(--space-4); margin: var(--space-3) 0 0; padding: 0; list-style: none; font-weight: 700; }
  .site-footer__meta a { display: inline-flex; align-items: center; min-height: 44px; }
  /* The mark of the network, beside the handle: the icon says where the link goes, the handle says which account. */
  .site-footer__social { gap: 8px; }
  .site-footer__icon { display: inline-flex; flex: none; }
  .site-footer__icon :global(svg) { width: 1.25em; height: 1.25em; }

  /* Phone: the mark and the text go in one column, the text uses the full width, and the page ends
     above the bars of the phone (safe area), so the last line is not cut. */
  @media (max-width: 560px) {
    .site-footer { margin-top: var(--space-8); }
    .site-footer__row {
      padding-top: var(--space-5);
      padding-bottom: calc(var(--space-6) + env(safe-area-inset-bottom, 0px));
    }
    .site-footer__top { flex-direction: column; align-items: flex-start; gap: var(--space-3); }
    .site-footer p { max-width: none; overflow-wrap: anywhere; }
    .site-footer__legal { font-size: 1rem; }
  }
</style>
