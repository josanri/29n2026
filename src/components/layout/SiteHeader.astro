---
import { publishedFirst, type Program } from '@/lib/programs';
import { nationalPrograms, regionalPrograms, regionalRegions, regionalProgramsIn } from '@/lib/presence';
import { routes } from '@/lib/routes';
import { jointListMembers } from '@/lib/relations';
import { categories } from '@/lib/taxonomy';
import Wordmark from './Wordmark.astro';
import { siteTests } from '@/lib/tests';
import { debates } from '@/lib/debates';

const path = Astro.url.pathname;
const isCurrent = (program: Program) => path.startsWith(routes.party(program.id));
const plural = (count: number, one: string, many: string) => `${count} ${count === 1 ? one : many}`;
const slug = (text: string) =>
  text.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

// ---- «Programas»: the national parties, the regional parties by region, and the link to the categories ----
const nationalSorted = publishedFirst(nationalPrograms);
const nationalGroups = [
  { title: 'Con programa analizado', parties: nationalSorted.filter((party) => party.hasProgram) },
  { title: 'Listas conjuntas, sin programa propio', parties: nationalSorted.filter((party) => !party.hasProgram && jointListMembers(party)) },
  { title: 'Sin programa publicado', parties: nationalSorted.filter((party) => !party.hasProgram && !jointListMembers(party)) },
].filter((group) => group.parties.length > 0);
const regions = regionalRegions.map((region) => {
  const parties = publishedFirst(regionalProgramsIn(region));
  const withProgram = parties.filter((party) => party.hasProgram).length;
  return {
    id: slug(region),
    name: region,
    parties,
    summary: `${plural(parties.length, 'partido', 'partidos')} · ${withProgram} con programa analizado`,
  };
});
// The region that the panel shows first: the region of the party of this page, else the first region.
const activeRegion = (regions.find((region) => region.parties.some(isCurrent)) ?? regions[0])?.id;
const programsCurrent =
  nationalPrograms.some(isCurrent) || regionalPrograms.some(isCurrent) || path.startsWith(routes.categories());

// ---- «Previsiones»: the polls and the simulator, the two ways to look ahead at the result ----
const toolLinks = [
  {
    href: routes.polls(),
    label: 'Encuestas',
    text: 'Sondeos y su evolución',
    // A line that goes up and down over an axis.
    icon: '<path d="M2 2v12h12"/><path d="m5 9.5 2.5-3.5 2.5 2 3.5-4.5"/>',
  },
  {
    href: routes.simulator(),
    label: 'Simulador',
    text: 'Reparte los escaños con tus porcentajes',
    icon: '<path d="M2 12.5a6 6 0 0 1 12 0"/><circle cx="5.2" cy="11.5" r="1.25" fill="currentColor" stroke="none"/><circle cx="8" cy="9.2" r="1.25" fill="currentColor" stroke="none"/><circle cx="10.8" cy="11.5" r="1.25" fill="currentColor" stroke="none"/>',
  },
];

// ---- «Guía»: the dates and how to vote ----
const guideLinks = [
  {
    href: routes.calendar(),
    label: 'Calendario',
    text: 'Fechas clave y horario',
    icon: '<rect x="2" y="3.5" width="12" height="10.5"/><path d="M2 7h12M5.5 1.5v2M10.5 1.5v2"/><rect x="8.8" y="9.3" width="2.7" height="2.7" fill="currentColor" stroke="none"/>',
  },
  {
    href: routes.info(),
    label: 'Info',
    text: 'Cómo votar y el escrutinio',
    // A circle with an «i»: a solid square dot and a stem, matching the site icons.
    icon: '<circle cx="8" cy="8" r="6"/><rect x="6.9" y="4.3" width="2.2" height="2.2" fill="currentColor" stroke="none"/><path d="M8 8.2v3.5"/>',
  },
];
const toolsCurrent = toolLinks.some((link) => path.startsWith(link.href));
const guideCurrent = guideLinks.some((link) => path.startsWith(link.href));

// ---- «Debates y tests»: each debate with its date and who took part, newest first, and the tests ----
// A draft debate shows only on the dev server.
const debateDay = (date: string) =>
  new Date(`${date}T12:00:00Z`).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', timeZone: 'UTC' });
const siteDebates = debates.map((debate) => {
  const names = debate.speakers
    .filter((speaker) => speaker.words > 0 && speaker.partyId)
    .map((speaker) => speaker.name.split(' ').slice(-1)[0]);
  const who = names.length > 1 ? `${names.slice(0, -1).join(', ')} y ${names[names.length - 1]}` : names.join('');
  return {
    href: routes.debate(debate.slug),
    name: debate.title,
    text: [debate.date && debateDay(debate.date), debate.channel, who].filter(Boolean).join(' · '),
  };
});
const mixCurrent = path.startsWith(routes.debate()) || path.startsWith(routes.tests());

// Icons: the inner markup of a 16×16 stroke SVG.
const icons = {
  // A page with lines: a program.
  programs: '<path d="M3 1.5h7l3 3v10H3z"/><path d="M10 1.5v3h3M5.5 8h5M5.5 11h5"/>',
  // A building with columns, like the Congress: the parties of the whole country.
  national: '<path d="M2 6 8 2.5 14 6z"/><path d="M4.5 8.5v4.5M8 8.5v4.5M11.5 8.5v4.5M2 13.5h12"/>',
  // A map pin: the parties of one territory.
  regional: '<path d="M8 14.5s4.8-4.2 4.8-8a4.8 4.8 0 0 0-9.6 0c0 3.8 4.8 8 4.8 8z"/><circle cx="8" cy="6.5" r="1.6" fill="currentColor" stroke="none"/>',
  categories: '<rect x="2" y="2" width="12" height="12"/><path d="M8 2v12M2 8h12"/>',
  // A ballot box with a ballot that goes in, with a check mark on it: the count of the votes.
  results: '<path d="M4.5 8V2h7v6"/><path d="m6.3 5 1.4 1.4L10 4"/><path d="M1.5 8h13v6.5h-13z"/><path d="M6 11h4"/>',
  // A circle with an «i»: the guide.
  guide: '<circle cx="8" cy="8" r="6"/><rect x="6.9" y="4.3" width="2.2" height="2.2" fill="currentColor" stroke="none"/><path d="M8 8.2v3.5"/>',
  // Two speech bubbles that face each other.
  debates: '<path d="M2 2h8.5v5.5H5.5L3 9.5v-2H2z"/><path d="M12 6.5h2V12h-1.5v2L10 12H7"/>',
  // A box with a check mark: a test.
  tests: '<path d="M10 2H2v12h12V8.5"/><path d="m5.5 7.8 2.5 2.5L14 3.5"/>',
  search: '<circle cx="6.5" cy="6.5" r="4.5"/><path d="m10 10 4.5 4.5"/>',
};
const chevronDown = '<path d="m1 1 5 5 5-5"></path>';
const chevronRight = '<path d="m1.5 1.5 5.5 5.5-5.5 5.5"></path>';
const chevronLeft = '<path d="M7.5 1.5 2 7l5.5 5.5"></path>';
---

<header class="site-header">
  <!-- data-nosnippet: the menu (party names, «Sin programa») is never the text of a search result. -->
  <div class="container site-header__row" data-nosnippet>
    <a class="logo" href={routes.home()}>
      <Wordmark /><span class="sr-only">, inicio</span>
    </a>
    <!-- `data-screen`: on a phone the menu shows one screen at a time (the script changes it). -->
    <nav class="nav" id="site-nav" aria-label="Principal" data-screen="root">
      <details class="nav-dropdown nav-dropdown--programs">
        <summary aria-current={programsCurrent ? 'page' : undefined}>
          <svg class="nav__icon" viewBox="0 0 16 16" aria-hidden="true" set:html={icons.programs} />
          Programas
          <svg class="nav-dropdown__chevron" viewBox="0 0 12 8" aria-hidden="true" set:html={chevronDown} />
        </summary>
        <div class="nav-dropdown__panel">
          <p class="nav-section__title" aria-hidden="true">Programas</p>
          <div class="programs">
            <!-- Phone: the three ways into the programs. Each party list opens as its own screen. -->
            <div class="nav-rows programs__openers">
              <button class="nav-row" type="button" data-screen-target="national" aria-controls="nav-national">
                <svg class="nav__icon" viewBox="0 0 16 16" aria-hidden="true" set:html={icons.national} />
                <span class="nav-row__label">Estatales</span>
                <span class="nav-row__count">{plural(nationalPrograms.length, 'partido', 'partidos')}</span>
                <svg class="nav-row__go" viewBox="0 0 9 14" aria-hidden="true" set:html={chevronRight} />
              </button>
              <button class="nav-row" type="button" data-screen-target="regional" aria-controls="nav-regional">
                <svg class="nav__icon" viewBox="0 0 16 16" aria-hidden="true" set:html={icons.regional} />
                <span class="nav-row__label">Autonómicos</span>
                <span class="nav-row__count">{plural(regions.length, 'comunidad', 'comunidades')}</span>
                <svg class="nav-row__go" viewBox="0 0 9 14" aria-hidden="true" set:html={chevronRight} />
              </button>
              <a class="nav-row" href={routes.categories()} aria-current={path.startsWith(routes.categories()) ? 'page' : undefined}>
                <svg class="nav__icon" viewBox="0 0 16 16" aria-hidden="true" set:html={icons.categories} />
                <span class="nav-row__label">Por tema</span>
                <span class="nav-row__count">{plural(categories.length, 'categoría', 'categorías')}</span>
                <svg class="nav-row__go" viewBox="0 0 9 14" aria-hidden="true" set:html={chevronRight} />
              </a>
            </div>

            <section class="programs__col programs__national" id="nav-national" aria-labelledby="nav-national-title">
              <button class="nav-back" type="button" data-screen-target="root">
                <svg viewBox="0 0 9 14" aria-hidden="true" set:html={chevronLeft} />Menú
              </button>
              <h2 id="nav-national-title">Estatales</h2>
              {nationalGroups.map((group) => (
                <>
                  <h3>{group.title}</h3>
                  <div class="party-list party-list--two">
                    {group.parties.map((party) => (
                      <a
                        href={routes.party(party.id)}
                        class:list={{ 'is-unpublished': !party.hasProgram }}
                        aria-current={isCurrent(party) ? 'page' : undefined}
                        style={`--party-color:${party.color}`}
                      >
                        <b>{party.acronym}</b>
                        <span>{party.partyName}</span>
                      </a>
                    ))}
                  </div>
                </>
              ))}
            </section>

            <section class="programs__col programs__regions" id="nav-regional" aria-labelledby="nav-regional-title">
              <button class="nav-back" type="button" data-screen-target="root">
                <svg viewBox="0 0 9 14" aria-hidden="true" set:html={chevronLeft} />Menú
              </button>
              <h2 id="nav-regional-title">Autonómicos</h2>
              <h3>Por comunidad</h3>
              <div class="region-list">
                {regions.map((region) => (
                  <button
                    class:list={['region-button', { 'is-active': region.id === activeRegion }]}
                    type="button"
                    data-region={region.id}
                    aria-controls={`nav-region-${region.id}`}
                    aria-expanded={region.id === activeRegion ? 'true' : 'false'}
                  >
                    <span class="region-button__name">{region.name}</span>
                    <span class="region-button__count">{region.parties.length}</span>
                    <svg viewBox="0 0 9 14" aria-hidden="true" set:html={chevronRight} />
                  </button>
                ))}
              </div>
            </section>

            <div class="programs__col programs__region">
              <button class="nav-back" type="button" data-screen-target="regional">
                <svg viewBox="0 0 9 14" aria-hidden="true" set:html={chevronLeft} />Autonómicos
              </button>
              {regions.map((region) => (
                <section
                  class:list={['region-panel', { 'is-active': region.id === activeRegion }]}
                  id={`nav-region-${region.id}`}
                  data-region={region.id}
                  aria-labelledby={`nav-region-${region.id}-title`}
                >
                  <h2 id={`nav-region-${region.id}-title`}>{region.name}</h2>
                  <h3>{region.summary}</h3>
                  <div class="party-list">
                    {region.parties.map((party) => (
                      <a
                        href={routes.party(party.id)}
                        class:list={{ 'is-unpublished': !party.hasProgram }}
                        aria-current={isCurrent(party) ? 'page' : undefined}
                        style={`--party-color:${party.color}`}
                      >
                        <b>{party.acronym}</b>
                        <span>{party.partyName}</span>
                        {!party.hasProgram && <small>{jointListMembers(party) ? 'Lista conjunta' : 'Sin programa'}</small>}
                      </a>
                    ))}
                  </div>
                </section>
              ))}
            </div>

            <a class="programs__topics" href={routes.categories()} aria-current={path.startsWith(routes.categories()) ? 'page' : undefined}>
              <svg class="nav__icon" viewBox="0 0 16 16" aria-hidden="true" set:html={icons.categories} />
              <b>Por tema</b>
              <span>Compara lo que dicen los programas en {categories.length} categorías.</span>
            </a>
          </div>
        </div>
      </details>

      <a class="nav__link nav__results" href={routes.results()} aria-current={path.startsWith(routes.results()) ? 'page' : undefined}>
        <svg class="nav__icon" viewBox="0 0 16 16" aria-hidden="true" set:html={icons.results} />
        <span class="nav__results-label">Resultados</span>
        <span class="nav__results-text">Escaños del Congreso y del Senado</span>
      </a>

      <!-- On a wide screen a menu like «Guía»; on a phone, two tiles under the results. -->
      <details class="nav-dropdown nav-dropdown--tools">
        <summary aria-current={toolsCurrent ? 'page' : undefined}>
          <svg class="nav__icon" viewBox="0 0 16 16" aria-hidden="true" set:html={toolLinks[0].icon} />
          Previsiones
          <svg class="nav-dropdown__chevron" viewBox="0 0 12 8" aria-hidden="true" set:html={chevronDown} />
        </summary>
        <div class="nav-dropdown__panel">
          <p class="nav-section__title" aria-hidden="true">Previsiones</p>
          <div class="guide guide--tiles">
            {toolLinks.map((link) => (
              <a href={link.href} aria-current={path.startsWith(link.href) ? 'page' : undefined}>
                <svg class="nav__icon" viewBox="0 0 16 16" aria-hidden="true" set:html={link.icon} />
                <b>{link.label}</b>
                <span>{link.text}</span>
              </a>
            ))}
          </div>
        </div>
      </details>

      <details class="nav-dropdown nav-dropdown--mix">
        <summary aria-current={mixCurrent ? 'page' : undefined}>
          <svg class="nav__icon" viewBox="0 0 16 16" aria-hidden="true" set:html={icons.debates} />
          Debates y tests
          <svg class="nav-dropdown__chevron" viewBox="0 0 12 8" aria-hidden="true" set:html={chevronDown} />
        </summary>
        <div class="nav-dropdown__panel">
          <p class="nav-section__title" aria-hidden="true">Debates y tests</p>
          <div class="mix nav-rows">
            <section>
              <a class="nav-row mix__title" href={routes.debate()} aria-current={path === routes.debate() ? 'page' : undefined}>
                <svg class="nav__icon" viewBox="0 0 16 16" aria-hidden="true" set:html={icons.debates} />
                <span class="nav-row__label">Debates</span>
                <span class="nav-row__count">{plural(siteDebates.length, 'debate', 'debates')}</span>
                <svg class="nav-row__go" viewBox="0 0 9 14" aria-hidden="true" set:html={chevronRight} />
              </a>
              <div class="nav-tests">
                {siteDebates.map((debate) => (
                  <a href={debate.href} aria-current={path.startsWith(debate.href) ? 'page' : undefined}>
                    <b>{debate.name}</b>
                    <span>{debate.text}</span>
                  </a>
                ))}
              </div>
            </section>
            <section>
              <a class="nav-row mix__title" href={routes.tests()} aria-current={path === routes.tests() ? 'page' : undefined}>
                <svg class="nav__icon" viewBox="0 0 16 16" aria-hidden="true" set:html={icons.tests} />
                <span class="nav-row__label">Tests</span>
                <span class="nav-row__count">{plural(siteTests.length, 'test', 'tests')}</span>
                <svg class="nav-row__go" viewBox="0 0 9 14" aria-hidden="true" set:html={chevronRight} />
              </a>
              <div class="nav-tests">
                {siteTests.map((test) => (
                  <a href={test.href} aria-current={path.startsWith(test.href) ? 'page' : undefined}>
                    <b>{test.name}</b>
                    <span>{test.text}</span>
                  </a>
                ))}
              </div>
            </section>
          </div>
        </div>
      </details>

      <details class="nav-dropdown nav-dropdown--guide">
        <summary aria-current={guideCurrent ? 'page' : undefined}>
          <svg class="nav__icon" viewBox="0 0 16 16" aria-hidden="true" set:html={icons.guide} />
          Guía
          <svg class="nav-dropdown__chevron" viewBox="0 0 12 8" aria-hidden="true" set:html={chevronDown} />
        </summary>
        <div class="nav-dropdown__panel">
          <p class="nav-section__title" aria-hidden="true">Guía</p>
          <div class="guide nav-rows">
            {guideLinks.map((link) => (
              <a href={link.href} aria-current={path.startsWith(link.href) ? 'page' : undefined}>
                <svg class="nav__icon" viewBox="0 0 16 16" aria-hidden="true" set:html={link.icon} />
                <b>{link.label}</b>
                <span>{link.text}</span>
                <svg class="nav-row__go" viewBox="0 0 9 14" aria-hidden="true" set:html={chevronRight} />
              </a>
            ))}
          </div>
        </div>
      </details>

      <a href={routes.search()} class="nav__link nav__link--search" aria-current={path.startsWith(routes.search()) ? 'page' : undefined}>
        <svg class="nav__icon" viewBox="0 0 16 16" aria-hidden="true" set:html={icons.search} />
        Buscar
        <span class="nav__hint">partidos y medidas</span>
      </a>
    </nav>
    <!-- The theme is a setting of every page, not a section: it stays in the header row, also on a phone with the
         menu closed. -->
    <button class="theme-toggle" type="button" aria-label="Cambiar tema claro u oscuro" title="Tema claro / oscuro"></button>
    <!-- Only on a phone: it opens and closes the nav. -->
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <svg class="nav__icon" viewBox="0 0 16 16" aria-hidden="true">
        <path class="menu-toggle__bars" d="M2 4h12M2 8h12M2 12h12"></path>
        <path class="menu-toggle__close" d="m3 3 10 10M13 3 3 13"></path>
      </svg>
      <span class="menu-toggle__label">Menú</span>
    </button>
  </div>
</header>

<script>
  import { THEME_STORAGE_KEY } from '@/lib/site';

  const header = document.querySelector<HTMLElement>('.site-header')!;
  const nav = header.querySelector<HTMLElement>('#site-nav')!;
  const menuToggle = header.querySelector<HTMLButtonElement>('.menu-toggle')!;
  const dropdowns = [...nav.querySelectorAll<HTMLDetailsElement>('.nav-dropdown')];
  // Below this width the nav is a sheet: every menu shows as a section, and the party lists open as screens.
  const compactQuery = matchMedia('(max-width: 1259px)');
  const isCompact = () => compactQuery.matches;

  // ---- Wide screen: one menu open at a time, under its own button ----
  // The panel starts at the left edge of its button and moves left only as far as it must to stay on the screen.
  const placePanel = (dropdown: HTMLDetailsElement) => {
    const panel = dropdown.querySelector<HTMLElement>('.nav-dropdown__panel');
    if (!panel || getComputedStyle(panel).position !== 'absolute') return;
    const row = dropdown.closest<HTMLElement>('.site-header__row')!;
    const rowBox = row.getBoundingClientRect();
    const button = dropdown.querySelector('summary')!.getBoundingClientRect();
    const gutter = parseFloat(getComputedStyle(row).paddingLeft) || 16;
    const width = panel.offsetWidth;
    const left = Math.max(gutter, Math.min(button.left - rowBox.left, rowBox.width - gutter - width));
    panel.style.left = `${left}px`;
    panel.style.right = 'auto';
  };
  for (const dropdown of dropdowns) {
    dropdown.addEventListener('toggle', () => {
      if (isCompact() || !dropdown.open) return;
      for (const other of dropdowns) if (other !== dropdown) other.open = false;
      placePanel(dropdown);
    });
  }
  addEventListener('resize', () => {
    if (isCompact()) return;
    for (const dropdown of dropdowns) if (dropdown.open) placePanel(dropdown);
  });

  // ---- The regions of «Programas»: a button shows the parties of its region ----
  const regionButtons = [...nav.querySelectorAll<HTMLButtonElement>('.region-button')];
  const regionPanels = [...nav.querySelectorAll<HTMLElement>('.region-panel')];
  const showRegion = (id: string) => {
    for (const button of regionButtons) {
      const active = button.dataset.region === id;
      button.classList.toggle('is-active', active);
      button.setAttribute('aria-expanded', String(active));
    }
    for (const panel of regionPanels) panel.classList.toggle('is-active', panel.dataset.region === id);
  };

  // ---- Phone: the screens of the sheet ----
  // `root` is the menu; `national` and `regional` are the party lists; `region` is the parties of one region.
  // Without `focusTarget` the focus goes to the back button of the new screen; with `null` it does not move.
  const setScreen = (screen: string, focusTarget?: HTMLElement | null) => {
    nav.dataset.screen = screen;
    nav.scrollTop = 0;
    const selector = screenFocus[screen];
    const target = focusTarget !== undefined ? focusTarget : selector ? nav.querySelector<HTMLElement>(selector) : null;
    target?.focus();
  };
  // Where the focus goes when a screen opens: its back button.
  const screenFocus: Record<string, string> = {
    national: '.programs__national .nav-back',
    regional: '.programs__regions .nav-back',
    region: '.programs__region .nav-back',
  };
  nav.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-screen-target]');
    if (button) {
      const from = nav.dataset.screen;
      const to = button.dataset.screenTarget!;
      // Going back puts the focus on the button that opened the screen.
      const opener =
        to === 'root' ? nav.querySelector<HTMLElement>(`.programs__openers [data-screen-target="${from}"]`)
        : to === 'regional' ? nav.querySelector<HTMLElement>('.region-button.is-active')
        : null;
      setScreen(to, opener);
      return;
    }
    const region = (event.target as HTMLElement).closest<HTMLButtonElement>('.region-button');
    if (region) {
      showRegion(region.dataset.region!);
      if (isCompact()) setScreen('region');
    }
  });
  // On a wide screen the parties of a region show when the pointer or the focus reaches its button.
  for (const button of regionButtons) {
    const preview = () => {
      if (!isCompact()) showRegion(button.dataset.region!);
    };
    button.addEventListener('pointerenter', preview);
    button.addEventListener('focus', preview);
  }

  // In the sheet every menu is open (the CSS hides its button). On a wide screen they all start closed.
  const syncMode = () => {
    for (const dropdown of dropdowns) dropdown.open = isCompact();
    setScreen('root', null);
    if (!isCompact()) setMenuOpen(false);
  };

  // Phone menu: the button opens and closes the nav. The CSS shows the button only on a narrow screen.
  const setMenuOpen = (open: boolean) => {
    header.classList.toggle('is-menu-open', open);
    menuToggle.setAttribute('aria-expanded', String(open));
    if (!open) {
      nav.dataset.screen = 'root';
      if (!isCompact()) for (const dropdown of dropdowns) dropdown.open = false;
    }
  };
  menuToggle.addEventListener('click', () => setMenuOpen(!header.classList.contains('is-menu-open')));
  compactQuery.addEventListener('change', syncMode);
  for (const dropdown of dropdowns) dropdown.open = isCompact();

  document.addEventListener('click', (event) => {
    if (!isCompact()) {
      for (const dropdown of dropdowns) {
        if (dropdown.open && !dropdown.contains(event.target as Node)) dropdown.open = false;
      }
    }
    if (header.classList.contains('is-menu-open') && !header.contains(event.target as Node)) setMenuOpen(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    if (isCompact()) {
      // Escape goes back one screen, and closes the menu from the first screen.
      const screen = nav.dataset.screen;
      if (screen === 'region') {
        setScreen('regional', nav.querySelector<HTMLElement>('.region-button.is-active'));
        return;
      }
      if (screen && screen !== 'root') {
        setScreen('root', nav.querySelector<HTMLElement>(`.programs__openers [data-screen-target="${screen}"]`));
        return;
      }
      if (header.classList.contains('is-menu-open')) {
        setMenuOpen(false);
        menuToggle.focus();
      }
      return;
    }
    // Escape closes an open menu and puts the focus back on its button.
    const openDropdown = dropdowns.find((dropdown) => dropdown.open);
    if (openDropdown) {
      openDropdown.open = false;
      openDropdown.querySelector('summary')?.focus();
    }
  });

  // Light / dark theme
  document.querySelector('.theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const isDarkNow =
      root.dataset.theme === 'dark' || (!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
    const next = isDarkNow ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem(THEME_STORAGE_KEY, next);
    } catch {
      // Storage can be blocked. The theme still changes for this visit.
    }
  });
</script>

