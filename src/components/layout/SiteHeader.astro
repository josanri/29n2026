---
import { publishedFirst, type Program } from '@/lib/programs';
import { nationalPrograms, regionalPrograms, regionalRegions, regionalProgramsIn } from '@/lib/presence';
import { routes } from '@/lib/routes';
import { SITE_NAME } from '@/lib/site';
import Wordmark from './Wordmark.astro';
import { siteTests } from '@/lib/tests';

const path = Astro.url.pathname;
const isCurrent = (program: Program) => path.startsWith(routes.party(program.id));

const nationalSorted = publishedFirst(nationalPrograms);
const menus = [
  {
    id: 'national',
    label: 'Estatales',
    // A building with columns, like the Congress: the parties of the whole country.
    icon: '<path d="M2 6 8 2.5 14 6"/><path d="M2.5 6.5h11M4.5 7.5v5M8 7.5v5M11.5 7.5v5M1.5 13.5h13"/>',
    isCurrent: nationalPrograms.some(isCurrent),
    groups: [
      { title: 'Con programa analizado', parties: nationalSorted.filter((party) => party.hasProgram) },
      { title: 'Sin programa publicado', parties: nationalSorted.filter((party) => !party.hasProgram) },
    ],
  },
  {
    id: 'regional',
    label: 'Autonómicos',
    // A map pin: the parties of one territory.
    icon: '<path d="M8 15s5-4.6 5-8.5a5 5 0 0 0-10 0C3 10.4 8 15 8 15z"/><circle cx="8" cy="6.5" r="1.8"/>',
    isCurrent: regionalPrograms.some(isCurrent),
    groups: regionalRegions.map((region) => ({
      title: region,
      parties: publishedFirst(regionalProgramsIn(region)),
    })),
  },
];

// Plain links of the nav. Each icon is the inner markup of a 16×16 stroke SVG.
const links = [
  {
    href: routes.categories(),
    label: 'Categorías',
    icon: '<rect x="2" y="2" width="5" height="5"/><rect x="9" y="2" width="5" height="5"/><rect x="2" y="9" width="5" height="5"/><rect x="9" y="9" width="5" height="5"/>',
  },
  {
    href: routes.polls(),
    label: 'Encuestas',
    // A line that goes up and down over an axis.
    icon: '<path d="M1.5 1.5v13h13"/><path d="m4 10 3-4 3 2 4-5"/>',
  },
  {
    href: routes.calendar(),
    label: 'Calendario',
    icon: '<rect x="2" y="3" width="12" height="11"/><path d="M2 7h12M5 1v4M11 1v4"/>',
  },
  {
    href: routes.simulator(),
    label: 'Simulador',
    icon: '<path d="M1 13a7 7 0 0 1 14 0M4.5 13a3.5 3.5 0 0 1 7 0M1 13h14"/>',
  },
  {
    href: routes.search(),
    label: 'Buscar',
    // In the compact menu the search takes the first row, with a hint of what it finds.
    hint: 'partidos y medidas',
    className: 'nav__link--search',
    icon: '<circle cx="6.5" cy="6.5" r="4.5"/><path d="m10 10 4.5 4.5"/>',
  },
];
// The «Tests» menu goes between the sections and the search. It opens a short list of the tests.
const sectionLinks = links.filter((link) => link.href !== routes.search());
const searchLinks = links.filter((link) => link.href === routes.search());
const testsCurrent = path.startsWith(routes.tests());
---

<header class="site-header">
  <div class="container site-header__row">
    <a class="logo" href={routes.home()} aria-label={`${SITE_NAME}, inicio`}>
      <Wordmark />
    </a>
    <nav class="nav" id="site-nav" aria-label="Principal">
      {menus.map((menu) => (
        <details class:list={['nav-dropdown', `nav-dropdown--${menu.id}`]}>
          <summary aria-current={menu.isCurrent ? 'page' : undefined}>
            <svg class="nav__icon" viewBox="0 0 16 16" aria-hidden="true" set:html={menu.icon} />
            {menu.label}
            <svg class="nav-dropdown__chevron" viewBox="0 0 12 8" aria-hidden="true">
              <path d="m1 1 5 5 5-5"></path>
            </svg>
          </summary>
          <div class="nav-dropdown__panel">
            <div class="nav-dropdown__groups">
              {menu.groups.filter((group) => group.parties.length > 0).map((group) => (
                <section>
                  <h2>{group.title}</h2>
                  <div class="nav-dropdown__list">
                    {group.parties.map((party) => (
                      <a
                        href={routes.party(party.id)}
                        class:list={{ 'is-unpublished': !party.hasProgram }}
                        aria-current={isCurrent(party) ? 'page' : undefined}
                        style={`--party-color:${party.color}`}
                      >
                        <b>{party.acronym}</b>
                        <span>{party.partyName}</span>
                        {!party.hasProgram && menu.id === 'regional' && <small>Sin programa</small>}
                      </a>
                    ))}
                  </div>
                </section>
              ))}
            </div>
          </div>
        </details>
      ))}
      {sectionLinks.map((link) => (
        <a href={link.href} class={link.className} aria-current={path.startsWith(link.href) ? 'page' : undefined}>
          <svg class="nav__icon" viewBox="0 0 16 16" aria-hidden="true" set:html={link.icon} />
          {link.label}
        </a>
      ))}
      <details class="nav-dropdown nav-dropdown--tests">
        <summary aria-current={testsCurrent ? 'page' : undefined}>
          <!-- A box with a check mark: a test. -->
          <svg class="nav__icon" viewBox="0 0 16 16" aria-hidden="true"><rect x="2" y="2" width="12" height="12"></rect><path d="m5 8.2 2.2 2.2L11.2 6"></path></svg>
          Tests
          <svg class="nav-dropdown__chevron" viewBox="0 0 12 8" aria-hidden="true">
            <path d="m1 1 5 5 5-5"></path>
          </svg>
        </summary>
        <div class="nav-dropdown__panel">
          <div class="nav-tests">
            {siteTests.map((test) => (
              <a href={test.href} aria-current={path.startsWith(test.href) ? 'page' : undefined}>
                <b>{test.name}</b>
                <span>{test.text}</span>
              </a>
            ))}
            <a class="nav-tests__all" href={routes.tests()}>Todos los tests</a>
          </div>
        </div>
      </details>
      {searchLinks.map((link) => (
        <a href={link.href} class={link.className} aria-current={path.startsWith(link.href) ? 'page' : undefined}>
          <svg class="nav__icon" viewBox="0 0 16 16" aria-hidden="true" set:html={link.icon} />
          {link.label}
          {link.hint && <span class="nav__hint">{link.hint}</span>}
        </a>
      ))}
      <!-- The visible label shows only in the phone menu. The accessible name contains it. -->
      <button class="theme-toggle" type="button" aria-label="Cambiar tema claro u oscuro" title="Tema claro / oscuro">
        <span class="theme-toggle__icon" aria-hidden="true"></span>
        <span class="theme-toggle__label">Cambiar tema</span>
      </button>
    </nav>
    <!-- Only on a phone: it opens and closes the nav. -->
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <svg class="nav__icon" viewBox="0 0 16 16" aria-hidden="true">
        <path class="menu-toggle__bars" d="M2 4h12M2 8h12M2 12h12"></path>
        <path class="menu-toggle__close" d="m3 3 10 10M13 3 3 13"></path>
      </svg>
      <span class="menu-toggle__label">Menú</span>
    </button>
  </div>
</header>

<script>
  import { THEME_STORAGE_KEY } from '@/lib/site';

  // Party menus: only one open at a time. They close on an outside click or on Escape.
  const dropdowns = [...document.querySelectorAll<HTMLDetailsElement>('.nav-dropdown')];
  for (const dropdown of dropdowns) {
    dropdown.addEventListener('toggle', () => {
      if (!dropdown.open) return;
      for (const other of dropdowns) if (other !== dropdown) other.open = false;
    });
  }
  // Phone menu: the button opens and closes the nav. The CSS shows the button only on a narrow screen.
  const header = document.querySelector<HTMLElement>('.site-header')!;
  const menuToggle = header.querySelector<HTMLButtonElement>('.menu-toggle')!;
  const setMenuOpen = (open: boolean) => {
    header.classList.toggle('is-menu-open', open);
    menuToggle.setAttribute('aria-expanded', String(open));
    if (!open) for (const dropdown of dropdowns) dropdown.open = false;
  };
  menuToggle.addEventListener('click', () => setMenuOpen(!header.classList.contains('is-menu-open')));

  document.addEventListener('click', (event) => {
    for (const dropdown of dropdowns) {
      if (dropdown.open && !dropdown.contains(event.target as Node)) dropdown.open = false;
    }
    if (header.classList.contains('is-menu-open') && !header.contains(event.target as Node)) setMenuOpen(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    // Escape first closes an open party menu, and then the phone menu.
    const openDropdown = dropdowns.find((dropdown) => dropdown.open);
    if (openDropdown) {
      openDropdown.open = false;
      openDropdown.querySelector('summary')?.focus();
      return;
    }
    if (header.classList.contains('is-menu-open')) {
      setMenuOpen(false);
      menuToggle.focus();
    }
  });

  // Light / dark theme
  document.querySelector('.theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const isDarkNow =
      root.dataset.theme === 'dark' || (!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
    const next = isDarkNow ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem(THEME_STORAGE_KEY, next);
    } catch {
      // Storage can be blocked. The theme still changes for this visit.
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: var(--color-paper);
    border-bottom: var(--border-thick) solid var(--color-ink);
  }
  .site-header__row {
    position: relative; /* the dropdown panels position against this row, not against their button */
    display: flex;
    align-items: center;
    gap: 6px;
    min-height: 72px;
  }
  /* The logo goes to the left. The nav (and, on a phone, the menu button) go to the right. */
  .logo {
    display: flex;
    align-items: center;
    min-height: 48px;
    margin-right: auto;
    padding-right: 10px;
    text-decoration: none;
  }
  .logo:hover { background: none; color: inherit; }
  .nav {
    display: flex;
    align-items: center;
    gap: 4px 20px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  /* The links of the nav are plain bold text, 44px tall. The current page is underlined. */
  .nav a,
  .nav-dropdown > summary {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
    font-size: 1.0625rem;
    text-decoration: none;
    background: transparent;
    color: var(--color-ink);
  }
  .nav__icon {
    flex: none;
    width: 14px;
    height: 14px;
    margin-right: 6px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: square;
  }
  /* Every item of the nav has its icon: it helps to find a section at a glance. Between 1180 and 1379px the row is
     full: only the search keeps its magnifier there. The phone menu (under 1180px) shows them all. */
  @media (min-width: 1180px) and (max-width: 1379px) {
    .nav { column-gap: 12px; }
    .nav > a:not(.nav__link--search) .nav__icon,
    .nav-dropdown > summary .nav__icon { display: none; }
  }
  .nav a[aria-current='page'],
  .nav-dropdown > summary[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 6px;
  }
  .nav-dropdown { position: static; }
  .nav-dropdown > summary { list-style: none; cursor: pointer; }
  .nav-dropdown > summary::-webkit-details-marker { display: none; }
  .nav-dropdown__chevron {
    width: 10px;
    height: 7px;
    margin-left: 7px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: square;
  }
  .nav-dropdown[open] .nav-dropdown__chevron { transform: rotate(180deg); }
  /* Hover and open: the yellow marker with black text. The links need their own rule: `.nav a` is scoped
     and so more specific than the base `a:hover`. */
  .nav-dropdown[open] > summary,
  .nav-dropdown > summary:hover,
  .nav a:hover {
    background: var(--color-highlight);
    color: var(--color-on-highlight);
  }

  /* The theme button: a 44px square split in paper and ink, like the two themes. */
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: var(--border-thick) solid var(--color-ink);
    border-radius: 0;
    background: linear-gradient(90deg, var(--color-paper) 50%, var(--color-ink) 50%);
    color: var(--color-ink);
    font: inherit;
    cursor: pointer;
  }
  .theme-toggle:hover { outline: 3px solid var(--color-highlight); outline-offset: -3px; }
  .theme-toggle__icon { display: none; }
  .theme-toggle__label { display: none; }

  .menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 14px;
    border: 0;
    border-radius: 0;
    background: var(--color-brand);
    color: var(--color-on-brand);
    font: 700 1.0625rem var(--font-body);
    cursor: pointer;
  }
  .menu-toggle .nav__icon { display: none; }
  .menu-toggle:hover { background: var(--color-highlight); color: var(--color-on-highlight); }
  .nav__hint { display: none; }

  .nav-dropdown__panel {
    position: absolute;
    z-index: var(--z-dropdown);
    top: calc(100% + 4px);
    right: var(--gutter);
    display: grid;
    gap: 20px;
    width: min(820px, calc(100vw - 2 * var(--gutter)));
    max-height: min(75vh, 640px);
    overflow: auto;
    padding: 18px;
    border: var(--border-thick) solid var(--color-ink);
    background: var(--color-paper);
  }
  .nav-dropdown__groups { display: grid; gap: 20px; }
  /* The tests: a short panel, one row per test with its name and what it does. */
  .nav-dropdown--tests .nav-dropdown__panel { width: min(440px, calc(100vw - 2 * var(--gutter))); }
  .nav-tests { display: grid; }
  .nav .nav-dropdown__panel .nav-tests a {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 4px;
    min-height: 44px;
    padding: 10px 6px;
    border-top: var(--border-fine) solid var(--color-ink);
    font-size: 0.9375rem;
    font-weight: 400;
  }
  .nav-tests b { font: 900 1.5rem / 1 var(--font-display); text-transform: uppercase; }
  .nav .nav-tests a.nav-tests__all { font-weight: 700; border-top-width: var(--border-thick); }
  .nav .nav-tests a[aria-current='page'] { background: var(--color-highlight); color: var(--color-on-highlight); }
  /* Text columns: a long region (Canarias) leaves no gaps in the others. The columns sit in
     a wrapper with no maximum height, so the panel scrolls vertically and never sideways. */
  .nav-dropdown--regional .nav-dropdown__groups {
    display: block;
    columns: 3 220px;
    column-gap: 20px;
  }
  .nav-dropdown--regional .nav-dropdown__groups section {
    break-inside: avoid;
    padding-bottom: 20px;
  }
  .nav-dropdown__panel h2 {
    margin: 0 0 var(--space-2);
    padding-bottom: var(--space-1);
    border-bottom: var(--border-thick) solid var(--color-ink);
    font-size: 1.5rem;
  }
  .nav-dropdown__list { display: grid; gap: 0; }
  .nav-dropdown--national .nav-dropdown__list {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr));
    column-gap: 20px;
  }
  .nav .nav-dropdown__panel a {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    gap: 2px 8px;
    width: 100%;
    min-height: 44px;
    padding: 7px 4px;
    border-top: var(--border-fine) solid var(--color-ink);
    font-size: 0.9375rem;
    font-weight: 400;
    text-align: left;
  }
  /* The acronym has a fine underline in the party color, so the parties are easy to tell apart. */
  .nav-dropdown__panel a b {
    font-family: var(--font-display);
    font-size: 1.375rem;
    line-height: 1;
    font-weight: 900;
    text-decoration: underline;
    text-decoration-color: var(--party-color);
    text-decoration-thickness: 3px;
    text-underline-offset: 3px;
    text-decoration-skip-ink: none;
  }
  .nav-dropdown__panel a span { overflow-wrap: anywhere; }
  .nav-dropdown__panel a small { grid-column: 1 / -1; font-size: 0.8125rem; }
  /* No program: quieter. The text keeps its full contrast. */
  .nav .nav-dropdown__panel a.is-unpublished { font-style: italic; }
  .nav .nav-dropdown__panel a[aria-current='page'] { background: var(--color-highlight); color: var(--color-on-highlight); }

  /* Compact header: below 1180px the nav does not fit on one line next to the logo. The header keeps
     one row (logo and menu button) and a fixed height, so the sticky filter bars of the pages stay
     under it. The nav opens as a sheet over the page, under the header:
     - the party menus take a full row each and open in place;
     - the sections fill a grid of two columns, or four from 720px.
     Without JavaScript (no `js` class), the nav stays open in the header and the menu button stays hidden. */
  @media (max-width: 1179px) {
    .site-header__row { flex-wrap: wrap; }
    :global(.js) .menu-toggle { display: inline-flex; }

    .nav {
      order: 1;
      flex-basis: 100%;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 6px;
      padding: 4px 0 12px;
    }
    .nav > a, .nav > .theme-toggle { height: 48px; }
    .nav > a {
      justify-content: flex-start;
      padding: 0 12px;
      border: var(--border-thick) solid var(--color-ink);
      white-space: nowrap;
    }
    .nav > a .nav__icon { display: inline; }
    /* The theme button is a setting, not a page: it takes the last row on its own. */
    .nav > .theme-toggle {
      grid-column: 1 / -1;
      width: 100%;
      gap: 7px;
      background: var(--color-paper);
      justify-content: flex-start;
      padding: 0 12px;
    }
    .theme-toggle__icon {
      display: inline-block;
      width: 18px;
      height: 18px;
      border: var(--border-thick) solid var(--color-ink);
      background: linear-gradient(90deg, var(--color-paper) 50%, var(--color-ink) 50%);
    }
    .theme-toggle__label { display: inline; font-weight: 700; font-size: 1.0625rem; }
    .nav-dropdown { grid-column: 1 / -1; }
    /* The search goes first, across the full width. The party menus follow, then the sections, then the theme. */
    .nav > .nav__link--search { order: -1; grid-column: 1 / -1; margin-bottom: 6px; }
    .nav__hint { display: inline; margin-left: 6px; font-weight: 400; font-size: 0.9375rem; }
    /* The icon and the label at the left, like the other rows; the arrow at the right. */
    .nav-dropdown > summary {
      width: 100%;
      min-height: 48px;
      justify-content: flex-start;
      padding: 0 12px;
      border: var(--border-thick) solid var(--color-ink);
    }
    .nav-dropdown > summary .nav-dropdown__chevron { margin-left: auto; }
    .nav-dropdown__panel {
      position: static;
      width: auto;
      max-height: none;
      margin-top: 6px;
      padding: 12px;
    }

    /* The sheet: it starts under the border of the header and scrolls if it is taller than the screen. */
    :global(.js) .nav {
      position: absolute;
      top: calc(100% + var(--border-thick));
      left: 0;
      right: 0;
      max-height: calc(100dvh - 100px);
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: 12px var(--gutter) 16px;
      background: var(--color-paper);
      border-bottom: var(--border-thick) solid var(--color-ink);
    }
    :global(.js) .site-header:not(.is-menu-open) .nav { display: none; }
  }

  /* Folding phone or tablet: the sections in one row. */
  @media (min-width: 720px) and (max-width: 1179px) {
    .nav { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  /* Phone: a smaller logo. */
  @media (max-width: 560px) {
    .site-header__row { min-height: 0; padding-top: 8px; padding-bottom: 8px; }
    .logo { min-height: 44px; }
    .logo :global(.wordmark) { font-size: 2rem; }
    .nav-dropdown--regional .nav-dropdown__groups { columns: 1; }
  }
  @media (max-width: 374px) {
    .logo { padding-right: 0; }
    .logo :global(.wordmark) { font-size: 1.75rem; }
  }
</style>
