---
/**
 * Map of the 52 provinces, with the Canary Islands and Ceuta and Melilla in insets.
 * Each province is a link. The page connects the map with `setupProvinceMap` (src/lib/province-map.ts),
 * which marks the selected province and draws the focus outline.
 * Ceuta, Melilla and the islands have an invisible halo that also reacts to the pointer.
 * In the inset of the Canary Islands the whole frame is a halo: a click or a tap picks the nearest province (see `setupProvinceMap`).
 */
import { geography, MAP_HIT_MARGIN } from '@/lib/geography';

interface Props {
  /** Accessible name of the map. */
  label: string;
  /** Accessible name of the link of one province. */
  linkLabel: (provinceName: string) => string;
  /** Address of the link of one province, for a reader without JavaScript. */
  href: (provinceCode: string) => string;
  id?: string;
}

const { label, linkLabel, href, id } = Astro.props;
const { provinces, canaryIslands, cityInset } = geography;
---

<svg class="province-map" {id} viewBox={`0 0 ${geography.width} ${geography.height}`} role="group" aria-label={label}>
  <rect class="province-map__frame province-map__frame--canarias" x={canaryIslands.x} y={canaryIslands.y} width={canaryIslands.width} height={canaryIslands.height} />
  <text class="province-map__label" x={canaryIslands.x + 10} y={canaryIslands.y + 24} aria-hidden="true">CANARIAS</text>
  <rect class="province-map__frame" x={cityInset.x} y={cityInset.y} width={cityInset.width} height={cityInset.height} />
  {provinces.map((province) => (
    <a
      href={href(province.code)}
      class:list={['province-map__province', { 'is-city': Boolean(province.marker) }]}
      data-province={province.code}
      data-canarian={province.isCanarian ? '' : undefined}
      aria-label={linkLabel(province.name)}
    >
      <title>{province.name}</title>
      {province.marker && (
        <circle class="province-map__hit-area" cx={province.marker.x} cy={province.marker.y} r={province.marker.radius + MAP_HIT_MARGIN} />
      )}
      {province.isIsland && (
        <path class="province-map__hit-area" d={province.path} style={`stroke-width:${MAP_HIT_MARGIN * 2}`} />
      )}
      <path d={province.path} />
      {province.marker && (
        <text class="province-map__label" x={province.marker.x} y={province.marker.labelY} text-anchor="middle" aria-hidden="true">
          {province.name.toUpperCase()}
        </text>
      )}
    </a>
  ))}
  <path class="province-map__selection" aria-hidden="true" />
  <path class="province-map__focus-back" aria-hidden="true" />
  <path class="province-map__focus" aria-hidden="true" />
</svg>

<style>
  /* Strokes do not scale with the SVG: they always measure the same on screen. */
  .province-map {
    --province-hover: color-mix(in srgb, var(--color-highlight) 55%, var(--color-paper-alt));
    display: block;
    width: 100%;
    height: auto;
    margin-top: var(--space-4);
    overflow: visible;
  }
  .province-map path {
    fill: var(--color-paper-alt);
    stroke: var(--color-ink);
    stroke-width: 1;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .province-map__province { cursor: pointer; }
  .province-map__province:focus-visible { outline: none; box-shadow: none; }
  .province-map__province:hover path,
  .province-map__province:focus-visible path,
  .province-map__province.is-near path { fill: var(--province-hover); }
  /* The pointer is in the inset of the Canary Islands: a click picks the nearest province. */
  .province-map.is-near-canary { cursor: pointer; }
  .province-map__province.is-selected path { fill: var(--color-highlight); }
  /* The halo that reacts to the pointer: a circle around each city, and a wide border in map units around each island.
     It stays invisible, also on hover. */
  .province-map .province-map__hit-area,
  .province-map__province:hover .province-map__hit-area,
  .province-map__province:focus-visible .province-map__hit-area,
  .province-map__province.is-selected .province-map__hit-area { fill: transparent; stroke: transparent; vector-effect: none; }
  .province-map circle.province-map__hit-area { stroke: none; }
  .province-map__label {
    fill: var(--color-ink-muted);
    font: 700 1.1875rem var(--font-mono);
    letter-spacing: 0.04em;
  }
  .province-map__province.is-city .province-map__label { fill: var(--color-ink); }
  .province-map__frame {
    fill: none;
    stroke: var(--color-ink-subtle);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  .province-map path.province-map__selection,
  .province-map path.province-map__focus-back,
  .province-map path.province-map__focus { fill: none; pointer-events: none; }
  .province-map path.province-map__selection { stroke: var(--color-on-highlight); stroke-width: 2.5; }
  .province-map path.province-map__focus-back { stroke: var(--color-ink); stroke-width: 7; }
  .province-map path.province-map__focus { stroke: var(--color-highlight); stroke-width: 3; }
</style>
