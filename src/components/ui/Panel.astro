---
/** Panel: a box with an optional title and lead line, then free content. */
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  title?: string;
  lead?: string;
}

const { title, lead, class: className, ...attrs } = Astro.props;
---

<div class:list={['box', 'panel', className]} {...attrs}>
  {title && <h3 class="panel__title">{title}</h3>}
  {lead && <p class="panel__lead">{lead}</p>}
  <slot />
</div>

<style>
  .panel { padding: 22px; }
  .panel__title { font-size: 2rem; margin-bottom: 8px; }
  .panel__lead {
    font-size: 1rem;
    margin-bottom: 18px;
  }
</style>
