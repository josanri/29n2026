---
/** Panel: a box with an optional title and lead line, then free content. */
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  title?: string;
  lead?: string;
  as?: 'h2' | 'h3';
}

const { title, lead, as = 'h3', class: className, ...attrs } = Astro.props;
const Heading = as;
---

<div class:list={['box', 'panel', className]} {...attrs}>
  {title && (
    <Heading class:list={['panel__title', { 'panel__title--icon': Astro.slots.has('icon') }]}>
      {Astro.slots.has('icon') && <span class="panel__icon"><slot name="icon" /></span>}
      <span>{title}</span>
    </Heading>
  )}
  {lead && <p class="panel__lead">{lead}</p>}
  <slot />
</div>

<style>
  .panel { padding: 22px; }
  .panel__title { display: flex; align-items: center; gap: 12px; font-size: 2rem; margin-bottom: 8px; }
  .panel__title--icon { margin-bottom: 18px; }
  .panel__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border: var(--border-thick) solid var(--color-ink);
    background: var(--color-paper);
    color: var(--color-ink);
  }
  .panel__lead {
    font-size: 1rem;
    margin-bottom: 18px;
  }
</style>
