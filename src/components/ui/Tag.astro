---
/**
 * Tag: a short label. Renders a link when `href` is set.
 * - `default`: a 1.5px ink border (levers, groups).
 * - `ink`: ink background with paper text (the category of a measure).
 * - `bold`: a 3px ink border and bold text (a deadline).
 * - `highlight`: yellow marker with black ink.
 * - `party`: the party color. A parent sets `--party-color` and `--party-on-color`
 *   (the readable text color, black or white).
 */
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'span'> {
  variant?: 'default' | 'ink' | 'bold' | 'highlight' | 'party';
  size?: 'md' | 'sm' | 'lg';
  href?: string;
}

const { variant = 'default', size = 'md', href, class: className, ...attrs } = Astro.props;
const Element = href ? 'a' : 'span';
---

<Element class:list={['tag', `tag--${variant}`, `tag--${size}`, className]} href={href} {...attrs}>
  <slot />
</Element>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    padding: 2px 10px;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.25;
    border: var(--border-fine) solid var(--color-ink);
    border-radius: 0;
    background: var(--color-paper);
    color: var(--color-ink);
    max-width: 100%; /* on narrow screens the tag wraps instead of overflowing */
  }
  a.tag { text-decoration: none; }
  a.tag:hover,
  a.tag--ink:hover { background: var(--color-highlight); color: var(--color-on-highlight); }
  .tag--ink { background: var(--color-ink); color: var(--color-paper); font-weight: 700; }
  .tag--bold { border-width: var(--border-thick); font-weight: 700; }
  .tag--highlight { background: var(--color-highlight); color: var(--color-on-highlight); font-weight: 700; }
  .tag--party { background: var(--party-color); color: var(--party-on-color, var(--color-fixed-light)); border-width: var(--border-thick); font-weight: 700; }
  .tag--sm { min-height: 26px; font-size: 0.875rem; padding: 1px 8px; }
  .tag--lg { min-height: 36px; font-size: 1.0625rem; }
</style>
