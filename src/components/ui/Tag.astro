---
/**
 * Tag: a short mono label. Renders a link when `href` is set.
 * - `default`: paper surface.
 * - `ink`: inverted surface.
 * - `highlight`: yellow marker with black ink.
 * - `party`: the party color. A parent sets `--party-color` and `--party-on-color`
 *   (the readable text color, black or white).
 */
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'span'> {
  variant?: 'default' | 'ink' | 'highlight' | 'party';
  size?: 'md' | 'sm' | 'lg';
  href?: string;
}

const { variant = 'default', size = 'md', href, class: className, ...attrs } = Astro.props;
const Element = href ? 'a' : 'span';
---

<Element class:list={['tag', `tag--${variant}`, `tag--${size}`, className]} href={href} {...attrs}>
  <slot />
</Element>

<style>
  .tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 3px 8px;
    border: var(--border-thin) solid var(--color-ink);
    background: var(--color-paper);
    line-height: 1.3;
    max-width: 100%; /* on narrow screens the tag wraps instead of overflowing */
  }
  a.tag { text-decoration: none; }
  .tag--ink { background: var(--color-ink); color: var(--color-paper); }
  .tag--highlight { background: var(--color-highlight); color: var(--color-on-highlight); }
  .tag--party { background: var(--party-color); color: var(--party-on-color, #fff); }
  .tag--sm { font-size: var(--text-2xs); padding: 2px 6px; }
  .tag--lg { font-size: var(--text-sm); }
</style>
