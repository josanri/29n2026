---
/**
 * The one tooltip of the page. Any element with a `data-tooltip` attribute shows
 * its HTML on hover or focus. Build the attribute value with `tooltip()` from `@/lib/tooltip`.
 * Text that the CSS cuts with an ellipsis shows its full text in the same bubble.
 *
 * Contrast: the bubble uses fixed colors (white on black, 21:1) in both themes.
 * The bold title is black on yellow (13:1). In the light theme the white border sets the bubble apart;
 * in the dark theme the bubble is black on black and the white border outlines it.
 */
---

<div id="tooltip" class="tooltip" role="tooltip" aria-label="Información adicional"></div>

<script>
  const bubble = document.getElementById('tooltip')!;
  let currentTarget: Element | null = null;

  const escapeHtml = (text: string) =>
    text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

  // Text that the CSS cuts with an ellipsis (one line or a line clamp) shows in full on hover.
  // Only an element that is really cut gets the tooltip.
  const isCut = (element: Element) => {
    const style = getComputedStyle(element);
    if (style.textOverflow === 'ellipsis' && element.scrollWidth > element.clientWidth) return true;
    const clamp = style.getPropertyValue('-webkit-line-clamp');
    return clamp !== '' && clamp !== 'none' && element.scrollHeight > element.clientHeight + 1;
  };
  const MAX_DEPTH = 4;
  const findCut = (start: Element) => {
    let node: Element | null = start;
    for (let depth = 0; node && depth < MAX_DEPTH && node !== document.body; depth += 1, node = node.parentElement) {
      if (isCut(node)) return node;
    }
    return null;
  };

  // The element that owns a tooltip: one with `data-tooltip`, or a text that is cut.
  const htmlOf = (target: Element) => {
    const html = target.getAttribute('data-tooltip');
    if (html) return html;
    const text = target.textContent?.replace(/\s+/g, ' ').trim();
    return text ? escapeHtml(text) : null;
  };
  const targetOf = (start: Element | null) => start?.closest?.('[data-tooltip]') ?? (start ? findCut(start) : null);

  const show = (target: Element, x: number, y: number) => {
    const html = htmlOf(target);
    if (!html) return;
    if (currentTarget !== target) {
      bubble.innerHTML = html;
      // An ARIA tooltip needs an accessible name: use its own text.
      bubble.setAttribute('aria-label', bubble.textContent?.trim() ?? '');
      currentTarget = target;
    }
    const box = bubble.getBoundingClientRect();
    let left = x + 14;
    let top = y + 16;
    if (left + box.width > window.innerWidth - 8) left = x - box.width - 14;
    if (top + box.height > window.innerHeight - 8) top = y - box.height - 12;
    bubble.style.left = `${Math.max(8, left)}px`;
    bubble.style.top = `${Math.max(8, top)}px`;
    bubble.classList.add('visible');
  };

  const hide = () => {
    bubble.classList.remove('visible');
    currentTarget = null;
  };

  document.addEventListener('pointermove', (event) => {
    const target = targetOf(event.target as Element);
    if (target) show(target, event.clientX, event.clientY);
    else if (currentTarget) hide();
  });
  document.addEventListener('focusin', (event) => {
    const target = targetOf(event.target as Element);
    if (!target) return;
    const box = target.getBoundingClientRect();
    show(target, box.left + box.width / 2, box.bottom);
  });
  document.addEventListener('focusout', hide);
  window.addEventListener('scroll', hide, { passive: true });
</script>

<style>
  .tooltip {
    position: fixed;
    z-index: var(--z-tooltip);
    pointer-events: none;
    max-width: 300px;
    /* Fixed colors, the same in both themes: the yellow label always sits on a dark bubble. */
    background: var(--color-fixed-dark);
    color: var(--color-fixed-light);
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.4;
    padding: 8px 10px;
    border: var(--border-fine) solid var(--color-fixed-light);
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.1s, transform 0.1s;
  }
  .tooltip.visible { opacity: 1; transform: none; }
  /* Emphasis as a yellow label with black ink, on the dark bubble */
  .tooltip :global(b) {
    display: inline-block;
    background: var(--color-highlight);
    color: var(--color-on-highlight);
    font-weight: 700;
    padding: 0 4px;
    margin-bottom: 3px;
  }
</style>
