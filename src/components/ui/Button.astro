---
/**
 * Button. Renders a link when `href` is set, and a <button> when it is not.
 * - `default`: secondary, a 3px ink border on paper.
 * - `ink`: primary, ink background with paper text.
 * Square corners, no shadow, at least 44px tall.
 */
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  variant?: 'default' | 'ink';
  size?: 'md' | 'sm';
  type?: 'button' | 'submit' | 'reset';
  /** Use `span` for a button that looks the same but sits inside another link. */
  as?: 'a' | 'button' | 'span';
}

const { variant = 'default', size = 'md', href, type = 'button', as, class: className, ...attrs } = Astro.props;
const Element = as ?? (href ? 'a' : 'button');
---

<Element
  class:list={['button', `button--${variant}`, `button--${size}`, className]}
  href={Element === 'a' ? href : undefined}
  type={Element === 'button' ? type : undefined}
  {...attrs}
>
  <slot />
</Element>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 50px;
    padding: 0 22px;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
    border: var(--border-thick) solid var(--color-ink);
    border-radius: 0;
    background: var(--color-paper);
    color: var(--color-ink);
    cursor: pointer;
  }
  .button:hover {
    background: var(--color-highlight);
    color: var(--color-on-highlight);
  }
  .button--ink {
    background: var(--color-brand);
    color: var(--color-on-brand);
  }
  .button--sm {
    min-height: 44px;
    padding: 0 16px;
    font-size: 1rem;
  }
</style>
