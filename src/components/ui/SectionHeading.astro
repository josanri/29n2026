---
/**
 * Section heading: a big <h2>, and (in the default slot)
 * a description paragraph or an action at the right.
 */
interface Props {
  title: string;
  headingId?: string;
}

const { title, headingId } = Astro.props;
---

<div class="section-heading">
  <h2 id={headingId}>{title}</h2>
  <slot />
</div>

<style>
  .section-heading {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    max-width: 44em;
    margin: var(--space-8) 0 var(--space-5);
  }
  .section-heading h2 { font-size: clamp(2.75rem, 8vw, 4.75rem); line-height: 0.9; }
  .section-heading :global(p) {
    margin: 0;
    max-width: 46em;
    font-size: 1.0625rem;
  }
  /* An action in the slot (a button) sits under the title. */
  .section-heading :global(.button) { margin-top: var(--space-2); }
</style>
