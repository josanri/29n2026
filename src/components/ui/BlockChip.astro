---
/**
 * Block chip: a swatch with the color of the block, followed by text.
 * The text is always there, because the color alone must never carry the meaning.
 */
import { blockColor } from '@/lib/blocks';

interface Props {
  blockId: number;
  title?: string;
}

const { blockId, title } = Astro.props;
const { color } = blockColor(blockId);
---

<span class="block-chip" title={title}>
  <i style={`background: ${color}`}></i>
  <slot />
</span>

<style>
  .block-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9375rem;
    font-weight: 700;
  }
  .block-chip i {
    width: 18px;
    height: 18px;
    border: var(--border-thick) solid var(--color-ink);
    display: inline-block;
    color: var(--color-ink);
  }
</style>
