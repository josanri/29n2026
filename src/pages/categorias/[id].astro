---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { election } from '@eleccion/eleccion';
import MeasureCard from '@/components/measures/MeasureCard.astro';
import BarList from '@/components/charts/BarList.astro';
import Button from '@/components/ui/Button.astro';
import Panel from '@/components/ui/Panel.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { announcedMeasures, programs } from '@/lib/programs';
import { categories, categoryById, targetGroupById } from '@/lib/taxonomy';
import { countBy } from '@/lib/collections';
import { compareText, measureNoun } from '@/lib/format';
import { routes } from '@/lib/routes';

export function getStaticPaths() {
  return categories.map((category) => ({ params: { id: category.id } }));
}

const category = categoryById[Astro.params.id!];
// Only programs with measures in this category, from the most to the fewest measures.
const groups = programs
  .map((program) => ({ program, measures: announcedMeasures(program).filter((measure) => measure.categoryId === category.id) }))
  .filter((group) => group.measures.length > 0)
  .sort((a, b) => b.measures.length - a.measures.length || compareText(a.program.acronym, b.program.acronym));
// The groups already hold only announced measures (one source: `programs.ts`).
const publishedMeasures = groups.flatMap((group) => group.measures);
const byTargetGroup = countBy(publishedMeasures, (measure) => measure.targetGroupIds).map(([id, count]) => ({
  id,
  label: targetGroupById[id].name,
  count,
}));
// The longest group fills the bar of its row; the others are a part of it.
const mostMeasures = Math.max(1, ...groups.map((group) => group.measures.length));
const nextCategory = categories[(categories.findIndex((item) => item.id === category.id) + 1) % categories.length];
---

<BaseLayout
  title={category.name}
  description={`Medidas sobre ${category.name.toLowerCase()} en los programas electorales del ${election.shortName}.`}
>
  <section class="page-hero">
    <div class="container page-hero__grid">
      <div>
        <p class="breadcrumb"><a href={routes.categories()}>Categorías</a> / {category.code}</p>
        <h1 class="headline">{category.name}</h1>
        <p class="page-hero__description">{category.description}</p>
      </div>
      <div class="total box">
        <span class="total__label">Medidas y propuestas</span>
        <strong>{publishedMeasures.length}</strong>
      </div>
    </div>
  </section>

  <div class="container">
    {groups.length > 0 && (
      <section class="parties" data-parties aria-labelledby="parties-title">
        <SectionHeading title="Por partido" headingId="parties-title">
          <p>
            {groups.length} {groups.length === 1 ? 'programa tiene' : 'programas tienen'} medidas en esta categoría. Abre uno para
            leerlas, o busca el partido que te interesa.
          </p>
        </SectionHeading>
        <div class="parties__bar box" role="group" aria-label="Lista de partidos">
          <label class="parties__search">
            <span>Buscar un partido</span>
            <input type="search" data-party-search placeholder="PP, PSOE, Vox…" autocomplete="off" />
          </label>
          <div class="parties__sort" role="group" aria-label="Ordenar">
            <button type="button" data-sort="count" aria-pressed="true">Más medidas</button>
            <button type="button" data-sort="alpha" aria-pressed="false">A–Z</button>
          </div>
          <button type="button" class="parties__toggle" data-toggle-all aria-pressed="false">Abrir todos</button>
          <p class="parties__status" data-party-status aria-live="polite"></p>
        </div>

        <!-- One row per party, collapsed. The row is an index: the acronym, the name, a bar and the count. -->
        <ul class="parties__list" data-party-list>
          {groups.map(({ program, measures }, index) => (
            <li data-party-row data-name={`${program.acronym} ${program.partyName}`.toLowerCase()} data-acronym={program.acronym} data-order={index}>
              <details class="party" id={`programa-${program.id}`} style={`--party-color:${program.color}`}>
                <summary class="party__summary">
                  <span class="party__chevron" aria-hidden="true"></span>
                  <span class="party__dot" aria-hidden="true"></span>
                  <span class="party__names">
                    <b>{program.acronym}</b>
                    {program.partyName !== program.acronym && <span>{program.partyName}</span>}
                  </span>
                  <span class="party__bar" aria-hidden="true"><span style={`width:${(measures.length / mostMeasures) * 100}%`}></span></span>
                  <span class="party__count"><b>{measures.length}</b> <span>{measureNoun(program, measures.length)}</span></span>
                </summary>
                <div class="party__body">
                  <p class="party__actions">
                    <Button size="sm" href={routes.measures(program.id, { category: category.id })}>Ver en el explorador</Button>
                    <Button size="sm" href={routes.party(program.id)}>Ficha de {program.acronym}</Button>
                  </p>
                  <div class="measure-list">
                    {measures.map((measure) => (
                      <MeasureCard measure={measure} program={program} showParty={programs.length > 1} showCategory={false} />
                    ))}
                  </div>
                </div>
              </details>
            </li>
          ))}
        </ul>
        <p class="parties__empty" data-party-empty hidden>Ningún partido con medidas en esta categoría coincide con la búsqueda.</p>
      </section>
    )}

    {byTargetGroup.length > 0 && (
      <div class="target-groups">
        <Panel title="Colectivos citados" lead="En las medidas de esta categoría.">
          <BarList items={byTargetGroup} total={publishedMeasures.length} />
        </Panel>
      </div>
    )}

    <nav class="pager">
      <Button variant="ink" href={routes.category(nextCategory.id)}>Siguiente: {nextCategory.name}</Button>
    </nav>
  </div>
</BaseLayout>

<script>
  // The list of parties: a search, an order, and a button that opens or closes every party.
  for (const root of document.querySelectorAll<HTMLElement>('[data-parties]')) {
    const list = root.querySelector<HTMLElement>('[data-party-list]')!;
    const rows = [...list.querySelectorAll<HTMLElement>('[data-party-row]')];
    const details = rows.map((row) => row.querySelector('details')!);
    const search = root.querySelector<HTMLInputElement>('[data-party-search]')!;
    const toggleAll = root.querySelector<HTMLButtonElement>('[data-toggle-all]')!;
    const status = root.querySelector<HTMLElement>('[data-party-status]')!;
    const empty = root.querySelector<HTMLElement>('[data-party-empty]')!;
    const sortButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-sort]')];
    // Without accents and case: «compromis» finds «Compromís».
    const plain = (text: string) => text.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();

    const visible = () => rows.filter((row) => !row.hidden);
    const update = () => {
      const shown = visible();
      const open = shown.filter((row) => row.querySelector('details')!.open).length;
      const allOpen = shown.length > 0 && open === shown.length;
      toggleAll.textContent = allOpen ? 'Cerrar todos' : 'Abrir todos';
      toggleAll.setAttribute('aria-pressed', String(allOpen));
      status.textContent = search.value.trim() ? `${shown.length} de ${rows.length} partidos` : `${rows.length} partidos`;
      empty.hidden = shown.length > 0;
    };

    search.addEventListener('input', () => {
      const query = plain(search.value);
      for (const row of rows) row.hidden = query !== '' && !plain(row.dataset.name!).includes(query);
      // A search that leaves one party opens it.
      const shown = visible();
      if (shown.length === 1) shown[0].querySelector('details')!.open = true;
      update();
    });
    toggleAll.addEventListener('click', () => {
      const open = toggleAll.getAttribute('aria-pressed') !== 'true';
      for (const row of visible()) row.querySelector('details')!.open = open;
      update();
    });
    for (const button of sortButtons) {
      button.addEventListener('click', () => {
        for (const other of sortButtons) other.setAttribute('aria-pressed', String(other === button));
        const sorted = [...rows].sort((a, b) =>
          button.dataset.sort === 'alpha'
            ? a.dataset.acronym!.localeCompare(b.dataset.acronym!, 'es', { sensitivity: 'base' })
            : Number(a.dataset.order) - Number(b.dataset.order),
        );
        list.append(...sorted);
      });
    }
    for (const item of details) item.addEventListener('toggle', update);

    // A link to a party (#programa-pp) opens it and goes to it.
    const openFromHash = () => {
      const target = details.find((item) => `#${item.id}` === location.hash);
      if (!target) return;
      target.open = true;
      target.scrollIntoView({ block: 'start' });
    };
    window.addEventListener('hashchange', openFromHash);
    openFromHash();
    update();
  }
</script>

<style>
  .page-hero { border-bottom: var(--border-thick) solid var(--color-ink); padding: 40px 0; }
  .page-hero__grid {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-5);
    flex-wrap: wrap;
  }
  .breadcrumb { font-size: 1rem; font-weight: 700; }
  /* «INFRAESTRUCTURAS» is about 8 em wide in the display font: 10 cqi keeps it whole */
  .page-hero__grid > :first-child { min-width: 0; }
  .page-hero h1 { font-size: clamp(2.75rem, 10cqi, 8rem); margin: 14px 0; }
  .page-hero__description { font-size: var(--text-lg); font-weight: 600; max-width: 56ch; margin: 0; }
  .total { padding: 14px 22px; display: grid; }
  .total__label { font-size: 1rem; font-weight: 700; }
  .total strong { font-family: var(--font-display); font-weight: 900; font-size: 5rem; line-height: 0.9; }
  /* The list of parties: a bar of tools, then one collapsed row per party. */
  .parties { margin-top: 8px; }
  .parties + .target-groups { margin-top: 56px; }
  .parties__bar { display: flex; flex-wrap: wrap; align-items: end; gap: 12px 20px; padding: 14px var(--space-4); margin-bottom: var(--space-3); }
  .parties__search { display: grid; gap: 6px; font-weight: 700; flex: 1 1 240px; max-width: 360px; }
  .parties__search input {
    min-height: 48px;
    padding: 0 12px;
    border: var(--border-thick) solid var(--color-ink);
    border-radius: 0;
    background: var(--color-paper);
    color: var(--color-ink);
    font: 600 1rem var(--font-body);
  }
  .parties__sort { display: flex; }
  .parties__sort button, .parties__toggle {
    min-height: 48px;
    padding: 0 16px;
    border: var(--border-thick) solid var(--color-ink);
    background: var(--color-paper);
    color: var(--color-ink);
    font: 700 1rem var(--font-body);
    cursor: pointer;
  }
  .parties__sort button + button { border-left: 0; }
  .parties__sort button:hover, .parties__toggle:hover { background: var(--color-highlight); color: var(--color-on-highlight); }
  .parties__sort button[aria-pressed='true'] { background: var(--color-ink); color: var(--color-paper); }
  .parties__status { margin: 0 0 12px auto; font-weight: 700; }
  .parties__empty { font-weight: 600; }

  .parties__list { list-style: none; margin: 0; padding: 0; border-top: var(--border-thick) solid var(--color-ink); }
  .parties__list > li { border-bottom: var(--border-fine) solid var(--color-ink); }
  .parties__list > li[hidden] { display: none; }
  .party { scroll-margin-top: 96px; }
  .party__summary {
    display: grid;
    /* Every row is its own grid: the bar and the count have fixed widths, so the bars of all the rows align. */
    grid-template-columns: 20px 14px minmax(0, 1fr) clamp(60px, 18vw, 200px) 14ch;
    align-items: center;
    gap: 14px;
    min-height: 56px;
    padding: 8px 12px;
    cursor: pointer;
    list-style: none;
  }
  .party__summary::-webkit-details-marker { display: none; }
  .party__summary:hover { background: var(--color-highlight); color: var(--color-on-highlight); }
  .party[open] > .party__summary { background: var(--color-ink); color: var(--color-paper); }
  /* The chevron: a square-ended arrow that turns down when the party is open. */
  .party__chevron { width: 10px; height: 10px; margin-left: 4px; border-right: 3px solid currentColor; border-bottom: 3px solid currentColor; transform: rotate(-45deg); }
  .party[open] .party__chevron { transform: rotate(45deg); margin-top: -6px; }
  .party__dot { width: 14px; height: 14px; border-radius: 50%; background: var(--party-color); border: var(--border-fine) solid currentColor; }
  .party__names { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 10px; min-width: 0; }
  .party__names b { font: 900 1.375rem / 1.1 var(--font-display); }
  .party__names span { font-size: 0.9375rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 100%; }
  .party__bar { height: 10px; border: var(--border-fine) solid currentColor; }
  .party__bar span { display: block; height: 100%; background: currentColor; }
  /* The number at the right of its own column and the word at the left: «42 propuestas» and «5 medidas» align. */
  .party__count { display: grid; grid-template-columns: 4ch 1fr; gap: 0.4ch; align-items: baseline; white-space: nowrap; }
  .party__count b { font-weight: 800; font-variant-numeric: tabular-nums; text-align: right; }
  .party__count span { font-weight: 500; }
  /* The open party: a band in its color at the left joins its measures to its row. */
  .party__body { padding: var(--space-3) 0 var(--space-5) 16px; border-left: 6px solid var(--party-color); margin-left: 12px; }
  .party__actions { display: flex; flex-wrap: wrap; gap: 10px; margin: 0 0 var(--space-3); }
  @media (max-width: 640px) {
    .party__summary { grid-template-columns: 16px 12px minmax(0, 1fr) 14ch; gap: 10px; }
    .party__bar { display: none; }
    .party__names span { display: none; }
    .parties__status { margin: 0; }
  }
  .target-groups { margin-top: 40px; }
  .measure-list { display: grid; gap: 18px; padding-left: 4px; }
  .pager { margin-top: 56px; display: flex; justify-content: flex-end; }
</style>
