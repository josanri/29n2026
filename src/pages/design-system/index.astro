---
/**
 * The design system, documented with live components.
 * Colors and contrast ratios come from `src/styles/tokens.css` at build time.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE_NAME } from '@/lib/site';
import BarList from '@/components/charts/BarList.astro';
import Wordmark from '@/components/layout/Wordmark.astro';
import BlockChip from '@/components/ui/BlockChip.astro';
import Button from '@/components/ui/Button.astro';
import Panel from '@/components/ui/Panel.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Tag from '@/components/ui/Tag.astro';
import Icon from '@/components/ui/Icon.astro';
import CategoryBars from '@/components/charts/CategoryBars.astro';
import { colorToken, contrastBetween } from '@/lib/design-tokens';
import { tooltip } from '@/lib/tooltip';

const swatchGroups = [
  { title: 'Blanco y negro (el tema oscuro los invierte)', names: ['paper', 'ink', 'ink-muted'] },
  { title: 'El acento de la marca: amarillo con texto negro en los dos temas', names: ['highlight', 'on-highlight'] },
  { title: 'Acento (amarillo; una página de partido lo cambia por el color del partido)', names: ['accent', 'on-accent'] },
  { title: 'Marca (botón principal, esfera de la portada)', names: ['brand', 'on-brand'] },
  { title: 'Fijos (iguales en los dos temas)', names: ['fixed-light', 'fixed-dark'] },
  { title: 'Respuestas del juego «Sin siglas»', names: ['answer-yes', 'answer-no', 'on-answer'] },
].map((group) => ({ ...group, tokens: group.names.map(colorToken) }));

// Text and background pairs the site uses. `needs` is the WCAG minimum for that use.
const pairs = [
  { use: 'Texto principal', fg: 'ink', bg: 'paper', needs: 4.5 },
  { use: 'Texto secundario (se usa poco)', fg: 'ink-muted', bg: 'paper', needs: 4.5 },
  { use: 'Texto invertido (etiqueta de categoría, botón principal)', fg: 'paper', bg: 'ink', needs: 4.5 },
  { use: 'Texto del tooltip (fijo en los dos temas)', fg: 'fixed-light', bg: 'fixed-dark', needs: 4.5 },
  { use: 'Texto sobre amarillo (banda, provincia elegida, hover)', fg: 'on-highlight', bg: 'highlight', needs: 4.5 },
  { use: 'Texto sobre el acento por defecto', fg: 'on-accent', bg: 'accent', needs: 4.5 },
  { use: 'Texto sobre la marca', fg: 'on-brand', bg: 'brand', needs: 4.5 },
  { use: 'Respuesta «Sí» del juego', fg: 'on-answer', bg: 'answer-yes', needs: 4.5 },
  { use: 'Respuesta «No» del juego', fg: 'on-answer', bg: 'answer-no', needs: 4.5 },
].map((pair) => ({ ...pair, ratio: contrastBetween(pair.fg, pair.bg) }));

const typeScale = [
  { token: '--text-xs', size: '14px', use: 'Lo más pequeño: leyendas y notas' },
  { token: '--text-sm', size: '15px', use: 'Texto de apoyo' },
  { token: '--text-md', size: '16px', use: 'Texto de medidas' },
  { token: '--text-base', size: '17px', use: 'Texto del cuerpo' },
  { token: '--text-lg', size: '19px', use: 'Entradillas y títulos de medida' },
  { token: '--text-xl', size: '28px', use: 'Títulos pequeños' },
];

const spaceScale = ['--space-1', '--space-2', '--space-3', '--space-4', '--space-5', '--space-6', '--space-7', '--space-8'];
const layers = ['--z-raised', '--z-sticky', '--z-header', '--z-dropdown', '--z-tooltip', '--z-skip-link'];

const sampleBars = [
  { id: 'a', label: 'Vivienda', count: 24, code: 'VIV' },
  { id: 'b', label: 'Sanidad y cuidados', count: 17, code: 'SAN' },
  { id: 'c', label: 'Educación', count: 9, code: 'EDU' },
];
const ratioLabel = (value: number) => `${value.toFixed(2)}:1`;
const sampleCategories = [
  { href: '#components', code: 'SOC', name: 'Pensiones y cohesión social', count: 248, percent: '8,6' },
  { href: '#components', code: 'VIV', name: 'Vivienda', count: 156, percent: '5,4' },
  { href: '#components', code: 'DEF', name: 'Defensa', count: 38, percent: '1,3' },
];
const iconNames = ['measures', 'blocks', 'download', 'external', 'summary', 'search'] as const;
const iconLabels: Record<(typeof iconNames)[number], string> = {
  measures: 'Explorar las medidas',
  blocks: 'Leer por bloques',
  download: 'Descargar',
  external: 'Fuente oficial',
  summary: 'Resumen',
  search: 'Buscar',
};
---

<BaseLayout
  noindex
  title="Sistema de diseño"
  description={`Tokens, componentes y reglas de uso del diseño de ${SITE_NAME}, con ejemplos en vivo en los temas claro y oscuro.`}
>
  <section class="hero">
    <div class="container">
      <h1 class="headline">Trama: blanco, negro y un punto por medida</h1>
      <p class="hero__lede">
        Un sistema de tokens CSS y pocos componentes. Todo se lee en los dos temas: el botón de la cabecera cambia entre claro
        y oscuro para comprobarlo.
      </p>
      <ol class="toc">
        <li><a href="#principles">Principios</a></li>
        <li><a href="#lessons">Lo aprendido</a></li>
        <li><a href="#brand">Marca</a></li>
        <li><a href="#color">Color</a></li>
        <li><a href="#trama">Trama</a></li>
        <li><a href="#contrast">Contraste</a></li>
        <li><a href="#type">Tipografía</a></li>
        <li><a href="#space">Espacio, bordes y capas</a></li>
        <li><a href="#components">Componentes</a></li>
        <li><a href="#files">Dónde está cada cosa</a></li>
      </ol>
    </div>
  </section>

  <div class="container">
    <SectionHeading title="Cómo se decide" headingId="principles" />
    <ul class="principles">
      <li class="box"><h3>Tokens, no valores</h3><p>Los componentes leen <code>var(--color-*)</code>, <code>--space-*</code> y similares. Un valor escrito a mano es un error de diseño.</p></li>
      <li class="box"><h3>Dos temas, un valor</h3><p>Cada token de color usa <code>light-dark()</code>. El tema oscuro invierte el blanco y el negro.</p></li>
      <li class="box"><h3>Nada de grises planos</h3><p>Un tono intermedio se imprime con puntos: la trama. Nunca se pone texto encima de una trama.</p></li>
      <li class="box"><h3>Un acento y el color del partido</h3><p>El amarillo es la marca. El color de un partido aparece en su esfera, su banda y sus puntos. Sin sombras y sin esquinas redondas.</p></li>
    </ul>

    <SectionHeading title="Lo aprendido" headingId="lessons">
      <p>Reglas que salen de errores reales de la web. Cada una dice qué hacer y por qué.</p>
    </SectionHeading>
    <ul class="principles">
      <li class="box"><h3>Quesitos sin texto girado</h3><p>Una tarta con códigos de tres letras girados dentro de las porciones cuesta leerla. Los «quesitos» (<code>CategoryDonut</code>) llevan cada etiqueta fuera del anillo, en horizontal, con código, nombre completo y porcentaje, unida a su porción por una línea fina. Porción, línea y etiqueta son un solo enlace. En un móvil no caben: el anillo va solo y debajo una lista de barras (<code>CategoryBars</code>) o botones.</p></li>
      <li class="box"><h3>Un partido que cambia de nombre cambia de color</h3><p>Sumar es magenta hasta el 16 de octubre de 2026; desde ese día es Frente Amplio, en bermellón. Las encuestas usan el nombre de su fecha y el simulador usa Sumar en el Congreso actual y en 2023, y Frente Amplio en «Todo a cero».</p></li>
      <li class="box"><h3>El color del partido subraya, no escribe</h3><p>Las siglas llevan un subrayado fino del color del partido (<code>text-decoration-color</code>). El texto sigue en tinta: un color claro no da contraste como texto.</p></li>
      <li class="box"><h3>Líneas con contorno de tinta</h3><p>En una gráfica, cada línea de color lleva debajo otra de tinta más ancha y cada punto un aro de tinta. Así VOX (verde claro) se lee sobre blanco y Podemos (morado) sobre negro, aunque el color solo no llegue a 3:1.</p></li>
      <li class="box"><h3>La incertidumbre es un halo</h3><p>El margen de error o la horquilla de escaños se dibuja como un área suave del color de la serie (opacidad 0,16), bajo la línea. Las líneas se suavizan sin pasarse de los datos (curva monótona).</p></li>
      <li class="box"><h3>Las cifras de una frase, en placa</h3><p>En la banda amarilla, los números van en Big Shoulders sobre una placa negra con texto amarillo (14,5:1 en los dos temas). Añade los espacios con <code>{'{\' \'}'}</code>: Astro quita el espacio al principio de una línea.</p></li>
      <li class="box"><h3>Partes proporcionales sin relleno</h3><p>En una barra de partes con <code>flex-grow</code>, las partes no llevan <code>padding</code> y una parte vacía se oculta. Si no, el relleno ocupa sitio y la barra deja un hueco al final.</p></li>
      <li class="box"><h3>Una esfera que viaja</h3><p>La esfera de la portada y la de un partido son enlaces. En la página de destino, un elemento con el mismo <code>view-transition-name</code> recibe la esfera. Solo con <code>prefers-reduced-motion: no-preference</code>.</p></li>
      <li class="box"><h3>Desplegables que se notan</h3><p>Lo que se abre es un botón con borde, icono y flecha que gira. Un texto suelto («Filtros avanzados») no parece que se pueda pulsar.</p></li>
    </ul>

    <SectionHeading title="Marca" headingId="brand">
      <p>El nombre se escribe en Big Shoulders Display 900. La letra O es un punto macizo del color de la tinta.</p>
    </SectionHeading>
    <div class="brand-row">
      <div class="brand-tile box"><Wordmark /></div>
      <div class="brand-tile brand-tile--inverted"><Wordmark /></div>
    </div>

    <SectionHeading title="Color" headingId="color">
      <p>Cada muestra usa el token real: cambia con el tema. Debajo, el valor en claro y en oscuro.</p>
    </SectionHeading>
    {swatchGroups.map((group) => (
      <section class="swatch-group">
        <h3>{group.title}</h3>
        <ul class="swatches">
          {group.tokens.map((token) => (
            <li class="swatch">
              <span class="swatch__chip" style={`background: var(${token.name})`}></span>
              <code class="swatch__name">{token.name}</code>
              <span class="swatch__values">
                {token.light === token.dark ? token.light : `${token.light} en claro, ${token.dark} en oscuro`}
              </span>
            </li>
          ))}
        </ul>
      </section>
    ))}
    <p class="note">
      Los colores de partido no son tokens: llegan con los datos.
    </p>

    <SectionHeading title="Trama" headingId="trama">
      <p>
        Puntos de la tinta en una celda de 7 px, en tres densidades. Se usan como fondo de barras, de casillas y de bloques. Los
        tokens son <code>--trama-light</code>, <code>--trama-medium</code>, <code>--trama-dense</code> y <code>--trama-size</code>.
      </p>
    </SectionHeading>
    <div class="trama-row">
      <div><span class="trama-sample trama--light"></span><b>Trama clara</b></div>
      <div><span class="trama-sample trama--medium"></span><b>Trama media</b></div>
      <div><span class="trama-sample trama--dense"></span><b>Trama densa</b></div>
    </div>

    <SectionHeading title="Contraste" headingId="contrast">
      <p>Razón de contraste WCAG calculada con los tokens. Mínimo 4,5:1 en texto pequeño y 3:1 en texto grande en negrita.</p>
    </SectionHeading>
    <div class="table-wrap" tabindex="0" role="region" aria-label="Tabla de contraste por tema">
      <table class="contrast-table">
        <thead>
          <tr><th scope="col">Uso</th><th scope="col">Mínimo</th><th scope="col">Claro</th><th scope="col">Oscuro</th></tr>
        </thead>
        <tbody>
          {pairs.map((pair) => (
            <tr>
              <th scope="row">{pair.use}<small>{pair.fg} sobre {pair.bg}</small></th>
              <td>{ratioLabel(pair.needs)}</td>
              <td data-pass={String(pair.ratio.light >= pair.needs)}>{ratioLabel(pair.ratio.light)} {pair.ratio.light >= pair.needs ? '✓' : '✗'}</td>
              <td data-pass={String(pair.ratio.dark >= pair.needs)}>{ratioLabel(pair.ratio.dark)} {pair.ratio.dark >= pair.needs ? '✓' : '✗'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note">
      Cada superficie de partido calcula su color de texto (negro o blanco) con <code>readableTextColor()</code> en
      <code>src/lib/color.ts</code>, y el mapa de presencia oscurece o aclara el color hasta 3:1 con
      <code>shiftForContrast()</code>.
    </p>

    <SectionHeading title="Tipografía" headingId="type" />
    <div class="grid grid--2">
      <Panel title="Display" lead="--font-display, Big Shoulders Display 900">
        <p class="sample sample--display">Punto por punto</p>
        <p>Titulares, siglas y cifras grandes. En mayúsculas, interlineado entre 0,88 y 0,9.</p>
      </Panel>
      <Panel title="Texto" lead="--font-body, Archivo 400, 600 y 700">
        <p class="sample sample--body">Cada programa, descompuesto en sus medidas.</p>
        <p>Cuerpo de texto, etiquetas y botones. Sin etiquetas pequeñas en mayúsculas.</p>
      </Panel>
    </div>
    <ul class="type-scale">
      {typeScale.map((step) => (
        <li>
          <code>{step.token}</code>
          <span>{step.size}</span>
          <span style={`font-size: var(${step.token})`}>{step.use}</span>
        </li>
      ))}
    </ul>

    <SectionHeading title="Espacio, bordes y capas" headingId="space" />
    <div class="grid grid--2">
      <Panel title="Espacio" lead="Rejilla de 4 px.">
        <ul class="space-scale">
          {spaceScale.map((token) => (
            <li>
              <code>{token}</code>
              <span class="space-scale__bar" style={`width: var(${token})`}></span>
            </li>
          ))}
        </ul>
      </Panel>
      <Panel title="Bordes" lead="Continuos y de esquinas cuadradas. Sin sombras.">
        <div class="borders">
          <div class="borders__item" style="border: var(--border-thick) solid var(--color-ink)"><code>--border-thick</code> 3 px: cajas y controles</div>
          <div class="borders__item" style="border: var(--border-fine) solid var(--color-ink)"><code>--border-fine</code> 1,5 px: filas de listas y etiquetas de palanca</div>
        </div>
        <p class="note">Capas: {layers.map((layer, index) => <><code>{layer}</code>{index < layers.length - 1 ? ', ' : ''}</>)}.</p>
        <p class="note">Movimiento: <code>--duration-fast</code>, <code>--duration-base</code>, <code>--duration-slow</code> y <code>--easing-out</code>. Se desactiva con <code>prefers-reduced-motion</code>.</p>
      </Panel>
    </div>

    <SectionHeading title="Componentes" headingId="components" />

    <Panel title="Button" lead="src/components/ui/Button.astro, variant: default | ink, size: md | sm">
      <div class="demo-row">
        <Button>Por defecto</Button>
        <Button variant="ink">Principal</Button>
        <Button size="sm">Pequeño</Button>
        <Button href="#components">Enlace</Button>
      </div>
      <p class="note">El principal es de tinta con texto de papel. El secundario tiene un borde de 3 px. Con <code>href</code> es un enlace; sin él, un <code>&lt;button&gt;</code>. Con <code>as="span"</code> se dibuja igual dentro de otro enlace.</p>
    </Panel>

    <div class="stack">
      <Panel title="Tag" lead="src/components/ui/Tag.astro, variant: default | ink | bold | highlight | party, size: sm | md | lg">
        <div class="demo-row">
          <Tag variant="ink">Administración y gasto</Tag>
          <Tag variant="bold">Plazo: 100 días</Tag>
          <Tag>Gasto e inversión</Tag>
          <Tag variant="highlight">Oficial</Tag>
          <Tag size="sm" href="#components">Enlace pequeño</Tag>
          <span class="demo-party"><Tag variant="party" size="lg">PP</Tag></span>
        </div>
        <p class="note">La categoría va en tinta, el plazo con borde grueso y negrita, y las palancas y los colectivos con borde fino.</p>
      </Panel>

      <Panel title="BlockChip" lead="src/components/ui/BlockChip.astro, muestra de trama y texto, siempre juntos">
        <div class="demo-row">
          <BlockChip blockId={1}>01</BlockChip>
          <BlockChip blockId={2}>02 Economía</BlockChip>
          <BlockChip blockId={3}>03</BlockChip>
          <BlockChip blockId={4}>04</BlockChip>
          <BlockChip blockId={5}>05 (repite el ciclo)</BlockChip>
        </div>
      </Panel>

      <Panel title="Panel y SectionHeading" lead="src/components/ui/Panel.astro y src/components/ui/SectionHeading.astro">
        <p>Este recuadro es un <code>Panel</code> con título y línea de apoyo. Los títulos de sección de esta página son <code>SectionHeading</code>.</p>
      </Panel>

      <Panel title="BarList" lead="src/components/charts/BarList.astro, una serie en trama; pasa el ratón por una barra">
        <BarList items={sampleBars} total={50} unit="medidas" singularUnit="medida" />
      </Panel>

      <Panel title="Icon" lead="src/components/ui/Icon.astro, rejilla de 20 × 20, trazo de 2,2 y puntas cuadradas">
        <div class="demo-row">
          {iconNames.map((name) => <Button size="sm"><Icon name={name} />{iconLabels[name]}</Button>)}
        </div>
        <p class="note">El icono toma el color del texto, así que sigue el hover del botón. Los puntos y bloques macizos usan la clase <code>icon__dot</code>. Un icono va siempre con su texto.</p>
      </Panel>

      <Panel title="CategoryBars" lead="src/components/charts/CategoryBars.astro, las categorías en una lista de barras">
        <CategoryBars items={sampleCategories} unit="medidas" label="Ejemplo de categorías" />
        <p class="note">La barra es la parte de la categoría más grande; el número es la parte real del total. Cada fila es un enlace de 44 px o más.</p>
      </Panel>

      <Panel title="Botones de opción" lead="Grupos de botones con aria-pressed: orden, cámara, encuestadora, porcentaje o escaños">
        <div class="demo-segmented" role="group" aria-label="Ejemplo">
          <button type="button" aria-pressed="true">Oficial</button>
          <button type="button" aria-pressed="false">A–Z</button>
          <button type="button" aria-pressed="false">Z–A</button>
        </div>
        <p class="note">Botones pegados, con un solo borde entre ellos. El activo va en tinta con texto de papel; el hover, en amarillo.</p>
      </Panel>

      <Panel title="Siglas con el color del partido" lead="Menús, tarjetas de la portada y posturas de «Temas que dividen»">
        <div class="demo-row">
          <b class="demo-acronym" style="--party-color:#135898">PP</b>
          <b class="demo-acronym" style="--party-color:#7cbd2a">VOX</b>
          <b class="demo-acronym" style="--party-color:#f5b400">ERC</b>
          <b class="demo-acronym" style="--party-color:#1476a8">BNG</b>
        </div>
      </Panel>

      <Panel title="Tooltip" lead="src/components/ui/Tooltip.astro, cualquier elemento con data-tooltip">
        <p>
          <a
            href="#components"
            data-tooltip={tooltip('Nº 144', 'El texto del tooltip se escapa siempre.')}
          >Pasa el ratón o enfoca este enlace</a>
        </p>
        <p class="note">Se construye con <code>tooltip(titulo, ...lineas)</code> de <code>src/lib/tooltip.ts</code>. El globo usa colores fijos (<code>--color-fixed-light</code> sobre <code>--color-fixed-dark</code>), iguales en los dos temas, y el título es negro sobre amarillo. Si un texto se corta con puntos suspensivos, el tooltip muestra el texto completo sin <code>data-tooltip</code>.</p>
      </Panel>

      <Panel title="Superficies de objeto" lead="src/styles/objects.css, .box, .box--interactive, .trama, .grid, .container, .headline">
        <div class="demo-row">
          <div class="box demo-box">.box</div>
          <a class="box box--interactive demo-box" href="#components">.box--interactive</a>
          <div class="trama demo-box demo-box--trama"></div>
        </div>
      </Panel>
    </div>

    <SectionHeading title="Dónde está cada cosa" headingId="files" />
    <ul class="files">
      <li><code>src/styles/tokens.css</code> <span>Todos los tokens. Único sitio con valores.</span></li>
      <li><code>src/styles/base.css</code> <span>Reinicio y elementos HTML.</span></li>
      <li><code>src/styles/objects.css</code> <span>Contenedor, caja, rejillas, trama.</span></li>
      <li><code>src/components/ui/</code> <span>Piezas reutilizables sin datos: Button, Tag, Panel, SectionHeading, BlockChip, Tooltip.</span></li>
      <li><code>src/components/home/</code> <span>La portada: titular, buscador y esfera de puntos.</span></li>
      <li><code>src/components/charts/</code> <span>Gráficos de un programa.</span></li>
      <li><code>src/components/candidacies/</code> <span>Mapas de provincias y candidaturas.</span></li>
      <li><code>src/components/simulator/</code> <span>Piezas del simulador de escaños: hemiciclo e iconos.</span></li>
      <li><code>src/components/layout/</code> <span>Cabecera, pie y logotipo.</span></li>
      <li><code>src/lib/</code> <span>Datos, rutas, formato y color. Sin marcado.</span></li>
      <li><code>src/lib/tests.ts</code> <span>La lista de tests del menú «Tests» y de <code>/tests/</code>.</span></li>
      <li><code>src/data/temas.ts</code> <span>Los temas que dividen, comunes a todas las elecciones; las posturas, en <code>src/data/&lt;año&gt;/&lt;tipo&gt;/posturas.ts</code>.</span></li>
      <li><code>src/data/&lt;año&gt;/&lt;tipo&gt;/encuestas.ts</code> <span>Encuestas: porcentaje, muestra, escaños y enlace a la fuente.</span></li>
    </ul>
  </div>
</BaseLayout>

<style>
  .hero { border-bottom: var(--border-thick) solid var(--color-ink); padding: clamp(40px, 8vw, 80px) 0 var(--space-6); }
  .hero h1 { font-size: clamp(3rem, 9cqi, 7rem); line-height: 0.9; margin: 0 0 var(--space-5); }
  .hero__lede { font-size: clamp(1.125rem, 2.2vw, 1.375rem); font-weight: 600; max-width: 56ch; }
  .toc { list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-2); margin: var(--space-5) 0 0; padding: 0; }
  .toc a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font: 700 1rem var(--font-body);
    text-decoration: none;
    border: var(--border-thick) solid var(--color-ink);
    padding: 0 12px;
  }
  .toc a:hover { background: var(--color-highlight); color: var(--color-on-highlight); }
  .demo-segmented { display: flex; }
  .demo-segmented button {
    min-height: 44px;
    padding: 0 14px;
    border: var(--border-thick) solid var(--color-ink);
    background: var(--color-paper);
    color: var(--color-ink);
    font: 700 1rem var(--font-body);
  }
