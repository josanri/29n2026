---
import BaseLayout from '@/layouts/BaseLayout.astro';
import MeasureCard from '@/components/measures/MeasureCard.astro';
import BarList from '@/components/charts/BarList.astro';
import Button from '@/components/ui/Button.astro';
import Panel from '@/components/ui/Panel.astro';
import { getProgram, programs } from '@/lib/programs';
import { categoryById } from '@/lib/taxonomy';
import { countBy } from '@/lib/collections';
import { measureNoun, padNumber, splitParagraphs } from '@/lib/format';
import { blockColor } from '@/lib/blocks';
import { SECTION_ID_PREFIX, routes } from '@/lib/routes';

export function getStaticPaths() {
  return programs.flatMap((program) =>
    program.blocks.map((block) => ({ params: { party: program.id, id: String(block.id) } })),
  );
}

const program = getProgram(Astro.params.party!);
const blockId = Number(Astro.params.id);
const block = program.blocks.find((candidate) => candidate.id === blockId)!;
const sections = program.sections.filter((section) => section.blockId === blockId);
const blockMeasures = program.measures.filter((measure) => measure.blockId === blockId);
const previousBlock = program.blocks.find((candidate) => candidate.id === blockId - 1);
const nextBlock = program.blocks.find((candidate) => candidate.id === blockId + 1);

const bySection = sections.map((section) => ({
  id: section.id,
  label: `${section.id} ${section.phraseTitle}`,
  count: blockMeasures.filter((measure) => measure.sectionId === section.id).length,
  href: `#${SECTION_ID_PREFIX}${section.id}`,
}));
const introParagraphs = splitParagraphs(block.intro);
// A block with a single section: its bar says the same as the total, so the panel is not shown.
const showSections = sections.length > 1;
const byCategory = countBy(blockMeasures, (measure) => measure.categoryId).map(([id, count]) => ({
  id,
  label: categoryById[id].name,
  code: categoryById[id].code,
  count,
  href: routes.measures(program.id, { block: blockId, category: id }),
}));
---

<BaseLayout
  title={`${padNumber(blockId)} ${block.title} · ${program.acronym}`}
  accent={program.color}
  accentLight={program.lightColor}
>
  <section class="block-hero" style={`--block-color: ${blockColor(blockId)}`}>
    <div class="container block-hero__grid" style={!block.quote ? 'grid-template-columns: 1fr' : undefined}>
      <div>
        <p class="breadcrumb mono">
          <a href={routes.party(program.id)}>{program.acronym} · {program.programName}</a> / bloque {blockId}
        </p>
        <span class="block-hero__number">{padNumber(blockId)}</span>
        <h1 class="headline">{block.title}</h1>
        {block.motto && <p class="block-hero__motto">«{block.motto}»</p>}
      </div>
      {
        block.quote && (
          <blockquote class="quote box">
            <p>{block.quote}</p>
            <footer class="mono">Compromiso del candidato · pág. {block.page}</footer>
          </blockquote>
        )
      }
    </div>
  </section>

  <div class="container">
    <nav class="block-nav" aria-label="Bloques">
      {
        program.blocks.map((item) => (
          <a
            href={routes.block(program.id, item.id)}
            aria-current={item.id === blockId ? 'page' : undefined}
            style={`--block-color: ${blockColor(item.id)}`}
          >
            <span class="mono">{padNumber(item.id)}</span> {item.title}
          </a>
        ))
      }
    </nav>

    <!-- Without an intro text there is no left column: the panels use the full width, side by side. -->
    <div class:list={['intro-grid', { 'intro-grid--summary': introParagraphs.length === 0 }]}>
      {
        introParagraphs.length > 0 && (
          <div class="intro">
            {introParagraphs.map((paragraph, index) => <p class:list={{ 'drop-cap': index === 0 }}>{paragraph}</p>)}
          </div>
        )
      }
      <aside class="grid summary">
        {
          showSections && (
            <Panel title={`${blockMeasures.length} ${measureNoun(program, blockMeasures.length)}`} lead="Por sección. Pulsa para saltar.">
              <BarList
                items={bySection}
                total={blockMeasures.length}
                color={blockColor(blockId)}
                unit={program.measureUnitPlural}
                singularUnit={program.measureUnit}
              />
            </Panel>
          )
        }
        <Panel
          title={showSections ? 'Categorías' : `${blockMeasures.length} ${measureNoun(program, blockMeasures.length)}`}
          lead={showSections ? 'Temas del bloque.' : 'Por categoría: los temas del bloque.'}
        >
          <BarList
            items={byCategory}
            total={blockMeasures.length}
            unit={program.measureUnitPlural}
            singularUnit={program.measureUnit}
          />
        </Panel>
      </aside>
    </div>

    {
      sections.map((section) => {
        const sectionMeasures = blockMeasures.filter((measure) => measure.sectionId === section.id);
        return (
          <section class="section" id={`${SECTION_ID_PREFIX}${section.id}`}>
            <header class="section__head">
              <span class="section__number">{section.id}</span>
              <h2>{section.title}</h2>
              <span class="mono section__count">
                {sectionMeasures.length} {measureNoun(program, sectionMeasures.length)}
                {section.page ? ` · pág. ${section.page}` : ''}
              </span>
            </header>
            {section.intro && <p class="section__intro">{section.intro}</p>}
            {section.subsections.length > 0 ? (
              section.subsections.map((subsection, index) => (
                <div class="subsection">
                  <h3 class="subsection__title">{subsection.title}</h3>
                  <p class="subsection__intro">{subsection.intro}</p>
                  <div class="measure-list">
                    {sectionMeasures
                      .filter((measure) => measure.subsectionIndex === index)
                      .map((measure) => <MeasureCard measure={measure} program={program} open />)}
                  </div>
                </div>
              ))
            ) : (
              <div class="measure-list">
                {sectionMeasures.map((measure) => <MeasureCard measure={measure} program={program} open />)}
              </div>
            )}
          </section>
        );
      })
    }

    <nav class="pager">
      {
        previousBlock ? (
          <Button href={routes.block(program.id, previousBlock.id)}>
            {`Anterior: ${padNumber(previousBlock.id)} ${previousBlock.title}`}
          </Button>
        ) : (
          <span></span>
        )
      }
      {
        nextBlock ? (
          <Button variant="ink" href={routes.block(program.id, nextBlock.id)}>
            {`Siguiente: ${padNumber(nextBlock.id)} ${nextBlock.title}`}
          </Button>
        ) : (
          <Button variant="ink" href={routes.party(program.id)}>Volver al análisis</Button>
        )
      }
    </nav>
  </div>
</BaseLayout>

<style>
  /* The hero sits on the block color: its text and surfaces use the fixed colors, never the theme ones. */
  .block-hero {
    background: var(--block-color);
    color: var(--color-fixed-dark);
    border-bottom: var(--border-thick) solid var(--color-ink);
    padding: 36px 0 44px;
  }
  .block-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(260px, 1fr);
    gap: 36px;
    align-items: end;
  }
  .breadcrumb {
    font-size: 0.8125rem;
    font-weight: 700;
    display: inline-block;
    background: var(--color-fixed-light);
    color: var(--color-fixed-dark);
    border: var(--border-thin) solid var(--color-fixed-dark);
    padding: 2px var(--space-2);
  }
  .breadcrumb a { color: var(--color-fixed-dark); }
  .block-hero__number {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(5.625rem, 16vw, 12.5rem);
    line-height: 0.8;
    margin-top: 18px;
    -webkit-text-stroke: 4px var(--color-fixed-dark);
    color: transparent;
  }
  /* The column is about 58 % wide, and «DEMOCRACIA» / «AUTOESTIMA» are about 8 em: 6.6 cqi */
  .block-hero h1 { font-size: clamp(1.75rem, 6.6cqi, 5.5rem); margin-top: var(--space-2); }
  .block-hero__motto { font-size: clamp(1.25rem, 2.6vw, 1.75rem); font-weight: 800; font-style: italic; margin: 14px 0 0; }
  .quote {
    margin: 0;
    padding: 22px;
    background: var(--color-fixed-light);
    color: var(--color-fixed-dark);
    border-color: var(--color-fixed-dark);
    box-shadow: 6px 6px 0 var(--color-fixed-dark);
    position: relative;
  }
  .quote::before {
    content: '“';
    position: absolute;
    top: -38px;
    left: var(--space-3);
    font-family: var(--font-display);
    font-size: 6rem;
    line-height: 1;
  }
  .quote p { font-size: 1.1875rem; font-weight: 800; line-height: 1.3; }
  .quote footer { font-size: var(--text-2xs); font-weight: 700; text-transform: uppercase; }

  .block-nav { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: 28px 0 0; }
  .block-nav a {
    text-decoration: none;
    font-weight: 800;
    font-size: 0.8125rem;
    border: var(--border-thin) solid var(--color-ink);
    padding: 6px 10px;
    border-left: 12px solid var(--block-color);
  }
  .block-nav a[aria-current='page'] { background: var(--color-ink); color: var(--color-paper); }

  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(300px, 1fr);
    gap: 40px;
    margin-top: 40px;
    align-items: start;
  }
  .intro { font-size: var(--text-lg); max-width: 64ch; }
  /* No intro: one column, and the panels sit side by side when there is room. */
  .intro-grid--summary { grid-template-columns: minmax(0, 1fr); }
  .intro-grid--summary .summary { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); gap: var(--space-5); align-items: start; }
  .drop-cap::first-letter {
    font-family: var(--font-display);
    float: left;
    font-size: 4.875rem;
    line-height: 0.8;
    padding: 6px 10px 0 0;
  }

  .section { margin-top: var(--space-8); }
  .section__head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 4px 18px;
    align-items: end;
    border-bottom: var(--border-thick) solid var(--color-ink);
    padding-bottom: var(--space-3);
    margin-bottom: 22px;
  }
  .section__number {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 6vw, 4.5rem);
    line-height: 0.85;
    background: var(--color-ink);
    color: var(--color-paper);
    padding: var(--space-2) var(--space-3) var(--space-1);
    grid-row: span 2;
  }
  .section__head h2 { font-size: clamp(1.375rem, 3.2vw, 2.25rem); overflow-wrap: anywhere; }
  .section__count { font-size: var(--text-xs); font-weight: 700; }
  .section__intro { font-size: var(--text-base); max-width: 70ch; }
  .subsection { margin-top: var(--space-6); }
  .subsection__title {
    font-size: 1.25rem;
    display: inline-block;
    background: var(--color-highlight);
    color: var(--color-on-highlight);
    border: var(--border-thin) solid var(--color-ink);
    padding: 6px 10px 4px;
  }
  .subsection__intro { font-size: var(--text-md); max-width: 70ch; margin: var(--space-3) 0 18px; font-style: italic; }
  .measure-list { display: grid; gap: 18px; }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: 64px;
  }

  @media (max-width: 900px) {
    .block-hero__grid,
    .intro-grid { grid-template-columns: minmax(0, 1fr); }
    .block-hero h1 { font-size: clamp(1.75rem, 10cqi, 5.5rem); }
  }
</style>
