---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BarList from '@/components/charts/BarList.astro';
import BlockBar from '@/components/charts/BlockBar.astro';
import MeasureMap from '@/components/charts/MeasureMap.astro';
import DeadlineTimeline from '@/components/charts/DeadlineTimeline.astro';
import PresenceMap from '@/components/candidacies/PresenceMap.astro';
import UnpublishedNotice from '@/components/party/UnpublishedNotice.astro';
import RelatedParties from '@/components/party/RelatedParties.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import Panel from '@/components/ui/Panel.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { getProgram, programs } from '@/lib/programs';
import { categoryById, leverById, targetGroupById } from '@/lib/taxonomy';
import { countBy } from '@/lib/collections';
import { deadlineKind, deadlineKindLabel, deadlineKindOrder } from '@/lib/deadlines';
import { allOf, capitalize, formatLongDate, measureNoun, percentOf, splitParagraphs } from '@/lib/format';
import { readableTextColor } from '@/lib/color';
import { methodNote } from '@/lib/method-note';
import { routes, withBase } from '@/lib/routes';
import { tooltip } from '@/lib/tooltip';
import { keyFindingsByParty, type KeyFinding } from '@eleccion/analysis';
import { downloadFileNames, summaryDownloadFileName } from '@eleccion/download-names';

export function getStaticPaths() {
  return programs.map((program) => ({ params: { party: program.id } }));
}

const program = getProgram(Astro.params.party!);
const total = program.measures.length;
const plural = program.measureUnitPlural;
const singular = program.measureUnit;
const publishedMeasures = program.measures.filter((measure) => !measure.isPending);
const pendingMeasures = program.measures.filter((measure) => measure.isPending);
const withFigures = program.measures.filter((measure) => measure.figures.length).length;
const withDeadline = program.measures.filter((measure) => measure.deadline).length;
// The kinds of deadline this program has, for the lead of «Lo que tiene fecha» (same source as the timeline).
const deadlineValues =
  program.deadlines.length > 0
    ? program.deadlines.map((entry) => entry.deadline)
    : program.measures.flatMap((measure) => (measure.deadline ? [measure.deadline] : []));
const deadlineKindNames = deadlineKindOrder
  .filter((kind) => deadlineValues.some((deadline) => deadlineKind(deadline) === kind))
  .map((kind) => deadlineKindLabel[kind].title.toLowerCase());
const deadlineKindsText =
  deadlineKindNames.length > 1
    ? `Se separan en ${deadlineKindNames.length === 2 ? 'dos' : 'tres'} tipos: ${deadlineKindNames.slice(0, -1).join(', ')} y ${deadlineKindNames.at(-1)}. Dentro de cada tipo, van de lo más inmediato a lo más lejano.`
    : 'Van de lo más inmediato a lo más lejano.';
const repealingMeasures = program.measures.filter((measure) => measure.repeals);
const measureByNumber = Object.fromEntries(program.measures.map((measure) => [measure.number, measure]));

// Editorial findings when they exist. Otherwise the three biggest categories.
const keyFindings: KeyFinding[] =
  keyFindingsByParty[program.id] ??
  countBy(program.measures, (measure) => measure.categoryId)
    .slice(0, 3)
    .map(([id, count]) => ({
      title: `${categoryById[id].name}: ${count} ${measureNoun(program, count)}`,
      text: `${count === total ? `${capitalize(allOf(program, total))} está clasificada` : `${count} de ${allOf(program, total)} (${percentOf(count, total)} %) están clasificadas`} en esta categoría. Es un recuento basado en la clasificación temática editorial del programa.`,
      measureNumbers: program.measures
        .filter((measure) => measure.categoryId === id)
        .slice(0, 5)
        .map((measure) => measure.number),
    }));

const byCategory = countBy(program.measures, (measure) => measure.categoryId).map(([id, count]) => ({
  id,
  label: categoryById[id].name,
  code: categoryById[id].code,
  count,
  href: routes.measures(program.id, { category: id }),
}));
const byTargetGroup = countBy(publishedMeasures, (measure) => measure.targetGroupIds).map(([id, count]) => ({
  id,
  label: targetGroupById[id].name,
  count,
  href: routes.measures(program.id, { targetGroup: id }),
}));
const byLever = countBy(publishedMeasures, (measure) => measure.leverIds).map(([id, count]) => ({
  id,
  label: leverById[id].name,
  count,
  href: routes.measures(program.id, { lever: id }),
  tooltip: tooltip(
    leverById[id].name,
    `${count} de ${publishedMeasures.length} ${plural} publicadas`,
    leverById[id].description,
  ),
}));
const byTerritory = countBy(publishedMeasures, (measure) => measure.territories).map(([id, count]) => ({
  id,
  label: id,
  count,
  href: routes.measures(program.id, { search: id }),
}));
const byVerb = program.verbs.map(({ verb, count }) => ({
  id: verb,
  label: capitalize(verb),
  count,
  tooltip: tooltip(`«${verb}»`, `aparece ${count} veces en el texto de ${allOf(program, total)}`),
}));

const isLocalDocument = program.documentType !== 'web' && program.documentUrl.startsWith('/');
const isWebProgram = program.documentType === 'web';
const hasFigures = program.figures.length > 0;
const hasMoreData = repealingMeasures.length > 0 || pendingMeasures.length > 0 || program.verbs.length > 0;
const documentLabel = isWebProgram ? 'Programa oficial' : isLocalDocument ? 'Descargar programa completo' : 'PDF original';

// Masculine units ("compromiso") take "uno": «cada uno con su texto original».
const eachOne = singular.endsWith('o') ? 'cada uno' : 'cada una';
const documentDate = program.documentDate ? formatLongDate(program.documentDate) : null;
const heroSentence = [
  isWebProgram
    ? 'El programa se publica en la web del partido.'
    : program.pageCount
      ? `El programa oficial tiene ${program.pageCount} páginas${documentDate ? ` y es del ${documentDate}` : ''}.`
      : null,
  `Aquí está dividido en ${allOf(program, total)}, ${eachOne} con su texto original.`,
]
  .filter(Boolean)
  .join(' ');

// The band: the program in one sentence, from the counts of its own data.
const biggestBlock = Math.max(0, ...program.blocks.map((block) => program.measures.filter((measure) => measure.blockId === block.id).length));
const countParts = [
  `${withFigures} ${withFigures === 1 ? 'tiene' : 'tienen'} una cifra`,
  `${withDeadline} ${withDeadline === 1 ? 'tiene' : 'tienen'} un plazo`,
  repealingMeasures.length > 0 ? `${repealingMeasures.length} ${repealingMeasures.length === 1 ? 'deroga' : 'derogan'} una ley` : null,
].filter(Boolean) as string[];
const bandSentence = [
  `De ${allOf(program, total)}, ${countParts.slice(0, -1).join(', ')} y ${countParts.at(-1)}.`,
  `Se reparten en ${program.blocks.length} ${program.blocks.length === 1 ? 'bloque' : 'bloques'} y ${program.sections.length} ${program.sections.length === 1 ? 'sección' : 'secciones'}.`,
  `El bloque más largo tiene ${biggestBlock} ${biggestBlock === 1 ? singular : plural}.`,
  pendingMeasures.length > 0 ? `Quedan ${pendingMeasures.length} por anunciar durante la campaña.` : null,
]
  .filter(Boolean)
  .join(' ');
// The title scales with its longest word, so that no word breaks in the middle.
const longestWord = Math.max(1, ...program.programName.split(/\s+/).map((word) => word.length));
const FIRST_FIGURES = 12;
// Figures of the same measure with the same quote go in one card, so the quote shows once.
// The unit shows only if the value does not already say it («48 horas» + «horas»).
type FigureCard = { values: { value: string; unit: string }[]; text: string; context?: string; measureNumber: number };
const figureCards: FigureCard[] = [];
for (const figure of program.figures) {
  const value = { value: figure.value, unit: figure.value.toLowerCase().includes(figure.unit.toLowerCase()) ? '' : figure.unit };
  const same = figureCards.find(
    (card) => card.measureNumber === figure.measureNumber && card.context === figure.context && card.text === figure.text,
  );
  if (same) same.values.push(value);
  else figureCards.push({ values: [value], text: figure.text, context: figure.context, measureNumber: figure.measureNumber });
}
---

<BaseLayout
  title={`${program.acronym}: ${program.programName || program.partyName}`}
  description={`Análisis del programa electoral del ${program.partyName}: ${program.programName}.`}
  accent={program.color}
  accentLight={program.lightColor}
>
  {
    !program.hasProgram ? (
      <>
        <UnpublishedNotice program={program} />
        <div class="container">
          <SectionHeading title="Dónde se presenta">
            <p>Provincias en las que {program.acronym} presenta candidatura al Congreso o al Senado, según la proclamación oficial.</p>
          </SectionHeading>
          <Panel>
            <PresenceMap program={program} />
            <RelatedParties program={program} />
          </Panel>
        </div>
      </>
    ) : (
      <>
        <section
          class="hero"
          style={`--party-color:${program.color}; --party-color-light:${program.lightColor}; --party-on-color:${readableTextColor(program.color)}; --word-length:${longestWord}`}
        >
          <div class="container hero__grid">
            <div class="hero__main">
              <p class="hero__party">
                <span class="hero__acronym">{program.acronym}</span>
                <span class="hero__party-name">{program.partyName}</span>
              </p>
              <h1 class="hero__title">{program.programName}</h1>
              <p class="hero__subtitle">{program.subtitle}</p>
              <p class="hero__sentence">{heroSentence}</p>
              <div class="hero__actions">
                <Button variant="ink" href={routes.measures(program.id)}><Icon name="measures" />{`Explorar ${allOf(program, total)}`}</Button>
                <Button href={routes.block(program.id, 1)}><Icon name="blocks" />Leer por bloques</Button>
                <Button
                  href={program.documentUrl}
                  target={isLocalDocument ? undefined : '_blank'}
                  rel={isLocalDocument ? undefined : 'noopener'}
                  download={isWebProgram ? undefined : downloadFileNames[program.id]}
                ><Icon name={isLocalDocument ? 'download' : 'external'} />{documentLabel}</Button>
                {program.summaryUrl && (
                  <Button href={program.summaryUrl} download={summaryDownloadFileName}><Icon name="summary" />Resumen: las 29 medidas</Button>
                )}
                {program.sourceUrl && (
                  <Button
                    href={withBase(program.sourceUrl)}
                    target="_blank"
                    rel="noopener"
                    title={isLocalDocument ? 'El documento original, en la web del partido' : undefined}
                  ><Icon name="external" />{isLocalDocument && /\.pdf($|\?)/i.test(program.sourceUrl) ? 'PDF original del partido' : 'Fuente oficial'}</Button>
                )}
              </div>
            </div>
            <div class="party-sphere-wrap">
              <!-- The sphere goes to the measures: there it turns into the wheel of the categories, which filters them. -->
              <a class="party-sphere" href={routes.measures(program.id)} aria-label={`Explorar ${allOf(program, total)} por categoría`}>
                <span class="party-sphere__dots" aria-hidden="true"></span>
                <span class="party-sphere__cta" aria-hidden="true">
                  <strong>{total}</strong>
                  <span>{plural} por categoría</span>
                </span>
              </a>
              <p class="party-sphere__hint">Pulsa la esfera para filtrar {allOf(program, total)} por categoría.</p>
            </div>
          </div>
        </section>

        <!-- The program in one sentence, on the party color. The text color is the readable one for that color. -->
        <section
          class="band"
          aria-label="El programa en una frase"
          style={`--band-color:${program.color}; --band-on-color:${readableTextColor(program.color)}`}
        >
          <p class="container">{bandSentence}</p>
        </section>

        {program.notes.map((note) => (
          <div class="container notes">
            <aside class="box notes__body">
              <strong>Nota sobre el documento</strong>
              <p>{note}</p>
            </aside>
          </div>
        ))}

        <div class="container">
          <SectionHeading title="Las claves">
            <p>
              Ideas basadas en el análisis editorial o, cuando este aún no está disponible, en la distribución temática. Cada una
              enlaza con las {plural} en las que se apoya.
            </p>
          </SectionHeading>
          <ol class="findings">
            {
              keyFindings.map((finding) => (
                <li class="finding">
                  <h3>{finding.title}</h3>
                  <p>{finding.text}</p>
                  <p class="finding__refs">
                    <span class="finding__refs-label">Leer:</span>
                    {finding.measureNumbers.filter((number) => measureByNumber[number]).map((number) => (
                      <a
                        href={routes.measure(program.id, number)}
                        aria-label={`Leer la ${singular} ${number}`}
                        data-tooltip={tooltip(
                          `Nº ${number}`,
                          measureByNumber[number].isPending ? 'Pendiente de anunciar' : measureByNumber[number].phraseTitle,
                        )}
                      >
                        {number}
                      </a>
                    ))}
                  </p>
                </li>
              ))
            }
          </ol>

          {hasFigures && (
            <>
            <SectionHeading title="Los números del programa">
              <p>Los compromisos que el programa cuantifica. Pulsa una ficha para leer la {singular} completa.</p>
            </SectionHeading>
            {
              (() => {
                const shown = figureCards.slice(0, FIRST_FIGURES);
                const hidden = figureCards.slice(FIRST_FIGURES);
                const card = (figure: FigureCard) => (
                  <a
                    class:list={['figure-card on-ink', figure.values.length > 1 && 'figure-card--many']}
                    href={routes.measure(program.id, figure.measureNumber)}
                  >
                    <span class="figure-card__values">
                      {figure.values.map(({ value, unit }) => (
                        <span class="figure-card__head">
                          <span class="figure-card__value">{value}</span>
                          {unit && <span class="figure-card__unit">{unit}</span>}
                        </span>
                      ))}
                    </span>
                    <span class="figure-card__text">{figure.text}</span>
                    {figure.context && <span class="figure-card__context">«{figure.context}»</span>}
                    <span class="figure-card__link">Leer la {singular} {figure.measureNumber}</span>
                  </a>
                );
                return (
                  <>
                    <p class="figures-hint" aria-hidden="true">Desliza para ver más cifras →</p>
                    <div class="figures" tabindex="0" role="region" aria-label="Cifras del programa: desliza para ver más">{shown.map((figure) => card(figure))}</div>
                    {hidden.length > 0 && (
                      <details class="figures-more">
                        <summary class="figures-more__toggle">
                          Ver las {hidden.reduce((sum, figure) => sum + figure.values.length, 0)} cifras restantes
                        </summary>
                        <div class="figures figures--compact">{hidden.map((figure) => card(figure))}</div>
                      </details>
                    )}
                  </>
                );
              })()
            }
            </>
          )}

          <SectionHeading title="Cómo se reparte">
            <p>
              El programa tiene {program.blocks.length} {program.blocks.length === 1 ? 'bloque' : 'bloques'}. La barra muestra la
              parte de {allOf(program, total)} que tiene cada bloque, y cada bloque tiene un tono del color del partido. El mapa, bajo la barra, resume cada bloque y se amplía con un botón: una casilla por {singular}, una fila por sección.
            </p>
          </SectionHeading>
          <BlockBar program={program} />
          <div class="map-panel">
            <Panel
              title={`Mapa de ${allOf(program, total)}`}
              lead={`Un resumen de los bloques, con un punto por ${singular}. Pulsa «Ampliar el mapa» para ver una casilla por ${singular}, con su número, y pasa el ratón sobre una casilla para leerla.${pendingMeasures.length > 0 ? ` Las casillas con trama son las ${pendingMeasures.length} ${plural} que el partido anunciará durante la campaña.` : ''}`}
            >
              <MeasureMap program={program} />
            </Panel>
          </div>

          <SectionHeading title={`${capitalize(plural)} por categoría`}>
            <p>
              Clasificación temática común a todos los programas. Cada {singular} tiene una categoría principal. Pulsa una barra
              para filtrar.
            </p>
          </SectionHeading>
          <BarList items={byCategory} total={total} unit={plural} singularUnit={singular} />

          <SectionHeading title="Colectivos y palancas">
            <p>
              Detección automática por palabras clave sobre el texto de cada {singular}. Una {singular} puede citar varios
              colectivos y usar varias palancas.
            </p>
          </SectionHeading>
          <div class="pair">
            <div class="pair__col">
              <h3>A quién se dirige</h3>
              <p>{capitalize(plural)} que citan a cada colectivo (de {publishedMeasures.length} publicadas).</p>
              <BarList items={byTargetGroup} total={publishedMeasures.length} unit={plural} singularUnit={singular} />
            </div>
            <div class="pair__col">
              <h3>Con qué palanca</h3>
              <p>El instrumento que usa cada {singular}. Una {singular} puede usar más de uno.</p>
              <BarList items={byLever} total={publishedMeasures.length} unit={plural} singularUnit={singular} />
              <h3 class="pair__second">Territorios citados</h3>
              <p>{capitalize(plural)} que nombran un territorio concreto.</p>
              <BarList items={byTerritory} total={publishedMeasures.length} unit={plural} singularUnit={singular} />
            </div>
          </div>

          {withDeadline > 0 && (
            <>
              <SectionHeading title="Lo que tiene fecha">
                <p>
                  {total === 1 ? `${capitalize(allOf(program, total))} fija un plazo.` : `Solo ${withDeadline} de ${allOf(program, total)} fijan un plazo.`} {deadlineKindsText}
                </p>
              </SectionHeading>
              <DeadlineTimeline program={program} />
            </>
          )}

          {hasMoreData && (
            <>
              <SectionHeading title="Deroga, reserva y repite" />
              <div class="grid grid--3">
                {repealingMeasures.length > 0 && (
                  <Panel title="Leyes que deroga" lead="Derogaciones explícitas.">
                    <ul class="repeals">
                      {repealingMeasures.map((measure) => (
                        <li>
                          <a href={routes.measure(program.id, measure.number)}>
                            <s>{measure.repeals}</s>
                            <span>Medida {measure.number}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </Panel>
                )}
                {pendingMeasures.length > 0 && (
                  <Panel title="Por anunciar" lead="Números reservados para la campaña, con la sección en la que van.">
                    <ul class="pending">
                      {pendingMeasures.map((measure) => {
                        const section = program.sections.find((candidate) => candidate.id === measure.sectionId)!;
                        return (
                          <li>
                            <span class="pending__swatch" aria-hidden="true"></span>
                            <a href={routes.measure(program.id, measure.number)}>
                              <strong>Nº {measure.number}</strong>: {categoryById[measure.categoryId].name}
                            </a>
                            <span class="pending__section">{section.id} {section.phraseTitle}</span>
                          </li>
                        );
                      })}
                    </ul>
                  </Panel>
                )}
                {byVerb.length > 0 && (
                  <Panel title="El programa en verbos" lead="Los verbos en futuro más repetidos.">
                    <BarList items={byVerb} total={total} unit="veces" />
                  </Panel>
                )}
              </div>
            </>
          )}

          <div class="details details--first">
            <Panel>
              <details>
                <summary><h3>Presentación: {program.introduction.title}</h3></summary>
                <div class="introduction">
                  {splitParagraphs(program.introduction.text).map((paragraph) => <p>{paragraph}</p>)}
                </div>
              </details>
            </Panel>
          </div>

          <div class="details">
            <Panel>
              <details>
                <summary><h3>Nota de método</h3></summary>
                <p>{methodNote(program)}</p>
                {program.sourceUrl && (
                  <p><a href={withBase(program.sourceUrl)} target="_blank" rel="noopener">Consultar la fuente oficial</a>.</p>
                )}
              </details>
            </Panel>
          </div>

          <SectionHeading title="Dónde se presenta">
            <p>Provincias en las que {program.acronym} presenta candidatura al Congreso o al Senado, según la proclamación oficial.</p>
          </SectionHeading>
          <Panel>
            <PresenceMap program={program} />
            <RelatedParties program={program} />
          </Panel>
        </div>
      </>
    )
  }
</BaseLayout>

<style>
  .hero { padding: clamp(28px, 4vw, 44px) 0 clamp(32px, 4vw, 52px); }
  .hero__grid {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 32px 48px;
  }
  .hero__main {
    flex: 1 1 560px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
    container-type: inline-size; /* the title scales with the width of this column */
  }
  .hero__party { margin: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 16px; }
  .hero__acronym { font-family: var(--font-display); font-weight: 900; font-size: 4.5rem; line-height: 0.9; overflow-wrap: anywhere; }
  .hero__party-name { font-size: 1.1875rem; font-weight: 600; }
  .hero__title {
    margin: 0;
    /* Big Shoulders Black capitals are about 0.55em wide, and a wide letter (M, D) more: with 0.6em per
       letter the longest word fits the column, and no word breaks in the middle. */
    font-size: clamp(2.5rem, calc(100cqi / (var(--word-length) * 0.6)), 7.5rem);
    line-height: 0.88;
    overflow-wrap: normal;
    word-break: keep-all;
  }
  .hero__subtitle { margin: 0; max-width: 31em; font-size: 1.375rem; font-weight: 600; }
  .hero__sentence { margin: 0; max-width: 34em; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }

  /* The sphere of the party: a disc in its color with dots, lit from the top left.
     When the reader points at it, the dots fade and a pie chart of the categories shows. */
  .party-sphere-wrap { flex: 0 1 400px; min-width: 0; }
  .party-sphere {
    position: relative;
    display: block;
    view-transition-name: party-sphere;
    color: var(--color-ink);
    text-decoration: none;
    box-sizing: border-box;
    aspect-ratio: 1 / 1;
    border: var(--border-thick) solid var(--color-ink);
    border-radius: 50%;
    overflow: hidden;
    background: var(--sphere-disc);
    container-type: inline-size; /* the text of the hole follows the size of the sphere */
    cursor: pointer;
  }
  .party-sphere__dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, var(--sphere-dots) 3.1px, transparent 3.6px);
    background-size: 10px 10px;
    -webkit-mask-image: linear-gradient(135deg, transparent 30%, #000 95%);
    mask-image: linear-gradient(135deg, transparent 30%, #000 95%);
    transition: opacity var(--duration-slow) var(--easing-out);
  }
  /* Hover: the dots fade a little and a paper plate in the middle says where the sphere goes. */
  .party-sphere__cta {
    position: absolute;
    inset: 26%;
    display: grid;
    place-content: center;
    gap: 2px;
    border: var(--border-thin) solid var(--color-ink);
    border-radius: 50%;
    background: var(--color-paper);
    text-align: center;
    opacity: 0;
    transform: scale(0.9);
    transition: opacity var(--duration-base) var(--easing-out), transform var(--duration-base) var(--easing-out);
  }
  .party-sphere__cta strong { font: 900 clamp(1.75rem, 12cqi, 3rem) / 1 var(--font-display); }
  .party-sphere__cta span { font: 700 clamp(0.8125rem, 3.4cqi, 1rem) / 1.15 var(--font-body); }
  .party-sphere:hover .party-sphere__dots,
  .party-sphere:focus-visible .party-sphere__dots { opacity: 0.35; }
  .party-sphere:hover .party-sphere__cta,
  .party-sphere:focus-visible .party-sphere__cta { opacity: 1; transform: none; }
  .party-sphere:focus-visible { outline-offset: 4px; }
  .party-sphere__hint { margin: var(--space-2) 0 0; font-size: var(--text-sm); font-weight: 600; text-align: center; }
  @media (prefers-reduced-motion: reduce) {
    .party-sphere__dots, .party-sphere__cta { transition: none; }
  }

  /* The band on the party color. */
  .band {
    background: var(--band-color);
    color: var(--band-on-color);
    border-top: var(--border-thick) solid var(--color-ink);
    border-bottom: var(--border-thick) solid var(--color-ink);
  }
  .band p {
    margin: 0;
    padding-block: 26px;
    font-size: clamp(1.25rem, 2.2vw, 1.5rem);
