---
/**
 * The page of one measure, made to be shared. It has its own title, description and link preview (a quote of the
 * measure, drawn by the Worker: `worker/og/card.ts`), and shows the card of the measure open. It is not indexed and not in
 * the sitemap: the text is the same as in the explorer (`../medidas.astro`). It does not redirect: a link preview
 * reads the page it is given, and the reader who follows the link sees the measure right here.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import MeasureCard from '@/components/measures/MeasureCard.astro';
import Button from '@/components/ui/Button.astro';
import { announcedMeasures, getProgram, programs } from '@/lib/programs';
import { measurePageDescription, measurePageTitle, measureQuote, measureShareImage } from '@/lib/seo';
import { routes } from '@/lib/routes';

export function getStaticPaths() {
  return programs.flatMap((program) =>
    announcedMeasures(program).map((measure) => ({ params: { party: program.id, n: String(measure.number) } })),
  );
}

const program = getProgram(Astro.params.party!);
const measure = program.measures.find((candidate) => String(candidate.number) === Astro.params.n)!;
---

<BaseLayout
  title={measurePageTitle(program, measure)}
  description={measurePageDescription(program, measure)}
  accent={program.color}
  accentLight={program.lightColor}
  image={measureShareImage(program, measure)}
  noindex
>
  <section class="measure-page">
    <div class="container">
      <p class="breadcrumb">
        <a href={routes.party(program.id)}>{program.acronym}: {program.programName}</a> /
        <a href={routes.measures(program.id)}>{program.measureUnitPlural}</a> / {measure.number}
      </p>
      <h1 class:list={['headline', { 'is-long': measure.phraseTitle.length > 60, 'is-longer': measure.phraseTitle.length > 110 }]}>{measureQuote(measure)}</h1>
      <div class="measure-page__card">
        <MeasureCard measure={measure} program={program} open showShare={false} />
      </div>
      <p class="measure-page__more">
        <Button href={routes.measure(program.id, measure.number)}>
          {`Ver entre las ${program.measureUnitPlural} de ${program.acronym}`}
        </Button>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .measure-page { padding: 36px 0 56px; }
  .breadcrumb { font-size: 1rem; font-weight: 700; margin: 0; }
  .measure-page h1 { font-size: clamp(2.25rem, 7vw, 5rem); margin: var(--space-3) 0 var(--space-5); }
  .measure-page h1.is-long { font-size: clamp(1.75rem, 5vw, 3.25rem); }
  .measure-page h1.is-longer { font-size: clamp(1.375rem, 3.5vw, 2.25rem); }
  .measure-page__more { margin: var(--space-5) 0 0; }
</style>
