---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hemicycle from '@/components/simulator/Hemicycle.astro';
import ShareIcon from '@/components/simulator/ShareIcon.astro';
import Button from '@/components/ui/Button.astro';
import Panel from '@/components/ui/Panel.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Tag from '@/components/ui/Tag.astro';
import { ABSOLUTE_MAJORITY, CONGRESS_SEATS, congressGroups } from '@eleccion/congreso';
import {
  SENATE_ABSOLUTE_MAJORITY,
  SENATE_AUTONOMOUS_SEATS,
  SENATE_ELECTED_SEATS,
  SENATE_SEATS,
  senateGroups,
} from '@eleccion/senado';
import { programs } from '@/lib/programs';
import { routes } from '@/lib/routes';
import { SECTION_SHARE_IMAGES } from '@/lib/site';
import { IMAGE_FORMATS } from '@/lib/simulator-image';

// The networks of the share buttons. The script gives each link its address (see `shareUrls` in the script).
const networks = [
  { id: 'whatsapp', label: 'WhatsApp', icon: 'whatsapp' },
  { id: 'telegram', label: 'Telegram', icon: 'telegram' },
  { id: 'x', label: 'X', icon: 'x' },
  { id: 'facebook', label: 'Facebook', icon: 'facebook' },
  { id: 'linkedin', label: 'LinkedIn', icon: 'linkedin' },
  { id: 'email', label: 'Correo', icon: 'mail' },
] as const;

// The groups go to the script as data: the script builds the rows, so a reader can add parties of their own.
const programIds = new Set(programs.map((program) => program.id));
const hrefOf = (programId?: string) => (programId && programIds.has(programId) ? routes.party(programId) : undefined);
const withLinks = <T extends { programId?: string; next?: { programId?: string } }>(groups: T[]) =>
  groups.map((group) => ({
    ...group,
    href: hrefOf(group.programId),
    next: group.next ? { ...group.next, href: hrefOf(group.next.programId) } : undefined,
  }));
const chamberData = {
  congreso: withLinks(congressGroups),
  senado: withLinks(senateGroups),
};
---

<BaseLayout
  title="Simulador de Congreso, Senado y pactos"
  description="Reparte los 350 escaños del Congreso o los 266 del Senado, crea tus propios partidos, prueba pactos y mayorías y comparte el resultado."
  image={SECTION_SHARE_IMAGES.simulator}
>
  <section class="page-hero">
    <div class="container">
      <Tag variant="ink">Herramienta, no encuesta</Tag>
      <h1 class="headline" id="sim-title">Congreso y pactos</h1>
      <p class="page-hero__lede" id="sim-lede">
        Reparte los {CONGRESS_SEATS} escaños como quieras, crea partidos nuevos y comprueba qué pactos logran investir a un presidente.
        Los escaños de partida son los del Congreso actual. Los números no son una previsión.
      </p>
      <div class="chambers" role="group" aria-label="Cámara">
        <button type="button" data-chamber="congreso" aria-pressed="true">
          Congreso <small>{CONGRESS_SEATS} escaños</small>
        </button>
        <button type="button" data-chamber="senado" aria-pressed="false">
          Senado <small>{SENATE_SEATS} escaños</small>
        </button>
      </div>
    </div>
  </section>

  <div class="container sim" id="sim" data-chambers={JSON.stringify(chamberData)}>
    <SectionHeading title="Reparte los escaños">
      <p>Cambia el número de escaños de cada partido o crea uno propio. El hemiciclo se actualiza al momento.</p>
    </SectionHeading>

    <div class="sim-grid sim-grid--seats">
      <Panel class="sim-chart">
        <Hemicycle id="hemi-seats" label="Hemiciclo del Congreso con el reparto de escaños">
          <text class="hemicycle__total" id="seats-total" x="200" y="172" text-anchor="middle">{CONGRESS_SEATS}</text>
          <text class="hemicycle__caption" id="seats-caption" x="200" y="192" text-anchor="middle">de {CONGRESS_SEATS} escaños</text>
        </Hemicycle>
        <p class="status" id="seats-status" aria-live="polite"></p>
        <!-- The main way to share: next to the result, in the yellow of the site. The dialog opens on the seats. -->
        <Button class="export-open export-open--main" data-export-open="seats" aria-haspopup="dialog">
          <ShareIcon name="share" /><span id="export-open-seats-label">Compartir este Congreso…</span>
        </Button>
        <p class="hint">Arrastra los escaños de un partido sobre los de otro para intercambiar sus posiciones. También puedes usar el asa de la lista.</p>
        <p class="sr-only" id="order-status" role="status"></p>
        <div class="sim-actions">
          <Button size="sm" id="preset-now">Congreso actual</Button>
          <Button size="sm" id="preset-autonomous" hidden>Solo autonómicos ({SENATE_AUTONOMOUS_SEATS})</Button>
          <Button size="sm" id="preset-2023">Resultados de 2023</Button>
          <Button size="sm" id="preset-zero">Todo a cero</Button>
          <Button size="sm" id="create-missing" hidden>Crear partido con los que faltan</Button>
        </div>
      </Panel>

      <!-- The column is as tall as the hemicycle panel. The list scrolls inside the panel. -->
      <div class="seats-col">
      <Panel class="seats-panel" title="Escaños por partido" lead="El orden del hemiciclo va de izquierda a derecha y es solo visual.">
        <div class="sort" role="group" aria-label="Ordenar la lista de partidos">
          <span class="sort__label">Ordenar por</span>
          <button type="button" data-sort="hemicycle" aria-pressed="true">Hemiciclo</button>
          <button type="button" data-sort="alpha" aria-pressed="false">A–Z</button>
          <button type="button" data-sort="seats" aria-pressed="false">Escaños</button>
        </div>
        <div class="seat-scroll">
        <ul class="seat-list" id="seat-list"></ul>
        </div>

        <!-- Outside the scroll: the button to create a party is always visible. The open form floats above it. -->
        <details class="party-form" id="party-details">
          <summary>Crear un partido</summary>
          <form id="party-form" novalidate>
            <label>
              Siglas
              <input name="acronym" type="text" maxlength="12" autocomplete="off" placeholder="Por ejemplo, XYZ" />
            </label>
            <label>
              Color
              <input name="color" type="color" value="#7a5af8" />
            </label>
            <label>
              Escaños
              <input name="seats" type="number" inputmode="numeric" min="0" max={CONGRESS_SEATS} step="1" value="0" />
            </label>
            <label>
              Posición
              <select name="position" aria-label="Posición en el hemiciclo">
                <option value="left">A la izquierda</option>
                <option value="center">En el centro</option>
                <option value="right" selected>A la derecha</option>
              </select>
            </label>
            <Button type="submit" variant="ink" size="sm">Añadir partido</Button>
            <p class="party-form__error" id="party-error" role="alert"></p>
          </form>
        </details>
      </Panel>
      </div>
    </div>

    <SectionHeading title="Prueba una investidura" headingId="vote-heading">
      <p id="vote-lead">
        Elige un candidato y decide el voto de cada partido. Con {ABSOLUTE_MAJORITY} votos a favor se inviste en la primera votación.
        Si no, a las 48 horas basta con más votos a favor que en contra.
      </p>
    </SectionHeading>

    <div class="pact-toolbar box">
      <label for="candidate" id="candidate-label">Candidato a la investidura</label>
      <select id="candidate"></select>
      <p id="candidate-note">El partido del candidato vota «Sí».</p>
    </div>

    <div class="sim-grid sim-grid--pacts">
      <!-- The result panel sets the height. The votes panel has the same height: the list of votes and the pacts scroll inside it. -->
      <div class="votes-col">
        <Panel class="votes-panel" title="Los votos" lead="Un partido sin voto elegido vota «No».">
          <div class="vote-scroll">
            <ul class="vote-list" id="vote-list"></ul>
          </div>

          <section class="coalitions-box" aria-labelledby="coalitions-title">
            <h3 class="coalitions__title" id="coalitions-title">Pactos que suman {ABSOLUTE_MAJORITY}</h3>
            <p class="coalitions__lead" id="coalitions-lead"></p>
            <ul class="coalitions" id="coalitions"></ul>
          </section>
        </Panel>
      </div>

      <Panel title="El resultado">
        <!-- A board in the style of the voting screens of the Congress: dark, with a light for each seat
             (green yes, red no, yellow abstention). It is the same in both themes, like a real screen. -->
        <div class="board">
          <Hemicycle id="hemi-votes" label="Hemiciclo del Congreso con el sentido del voto de cada escaño"></Hemicycle>
          <p class="board__head">
            <span>Votos emitidos <b id="tally-total">0</b></span>
            <span>Mayoría absoluta <b id="board-majority">{ABSOLUTE_MAJORITY}</b></span>
          </p>
          <ul class="board__tally" aria-label="Recuento">
            <li class="board__row board__row--yes"><span>Sí</span><b id="legend-yes">–</b></li>
            <li class="board__row board__row--no"><span>No</span><b id="legend-no">–</b></li>
            <li class="board__row board__row--abstain"><span>Abstención</span><b id="legend-abstain">–</b></li>
          </ul>
          <div class="vote-bar" id="vote-bar" role="img" aria-label="Votos de la investidura">
            <span class="vote-bar__part vote-bar__part--yes" data-part="yes"></span>
            <span class="vote-bar__part vote-bar__part--abstain" data-part="abstain"></span>
            <span class="vote-bar__part vote-bar__part--no" data-part="no"></span>
            <span class="vote-bar__part vote-bar__part--rest" id="vote-rest" aria-hidden="true"></span>
            <span class="vote-bar__marker" id="vote-marker" aria-hidden="true"><i id="vote-marker-value">{ABSOLUTE_MAJORITY}</i></span>
          </div>
        </div>
        <div class="verdict box" id="verdict" aria-live="polite">
          <h3 id="verdict-title"></h3>
          <p id="verdict-text"></p>
        </div>
        <!-- Only with a candidate: the dialog opens on the vote. -->
        <Button class="export-open export-open--vote" id="export-open-vote" data-export-open="vote" aria-haspopup="dialog" hidden>
          <ShareIcon name="share" /><span id="export-open-vote-label">Compartir esta investidura…</span>
        </Button>
      </Panel>
    </div>

    <SectionHeading title="Comparte tu simulación">
      <p>El enlace guarda los escaños, los partidos que has creado y los votos. Quien lo abra verá lo mismo y podrá cambiarlo.</p>
    </SectionHeading>
    <Panel class="share">
      <p class="share__preview" id="share-preview"></p>
      <div class="share__actions">
        <Button variant="ink" id="share-copy"><ShareIcon name="clipboard" />Copiar enlace</Button>
        <Button id="share-native" hidden><ShareIcon name="copy" />Compartir enlace…</Button>
        <Button id="share-image" data-export-open="last" aria-haspopup="dialog"><ShareIcon name="share" /><span data-export-label="Compartir imagen…">Compartir imagen o vídeo…</span></Button>
      </div>
      <h3 class="share__subtitle">Compartir en</h3>
      <ul class="share__networks">
        {
          networks.map((network) => (
            <li>
              <Button size="sm" class="share__network" data-network={network.id} href="#" target="_blank" rel="noopener noreferrer" aria-label={`Compartir en ${network.label}`}>
                <ShareIcon name={network.icon} />
                <span class="share__label">{network.label}</span>
              </Button>
            </li>
          ))
        }
      </ul>
      <p class="share__status" id="share-status" role="status"></p>
    </Panel>

    <!-- The image to share: a native dialog with a live preview. Escape closes it and the focus returns to the button. -->
    <dialog class="export" id="export-dialog" aria-labelledby="export-title">
      <div class="export__head">
        <h2 class="export__title" id="export-title" data-export-label="Compartir como imagen">Compartir como imagen o vídeo</h2>
        <button class="export__close" type="button" aria-label="Cerrar" data-export-close>×</button>
      </div>
      <div class="export__body">
        <figure class="export__preview">
          <canvas id="export-canvas" role="img" aria-label="Vista previa de la imagen"></canvas>
          <figcaption id="export-size"></figcaption>
        </figure>
        <form class="export__options" id="export-form">
          <!-- The script turns off a kind of file that this browser can not make, and says why. -->
          <fieldset class="choice">
            <legend>Archivo</legend>
            <div class="choice__grid choice__grid--3">
              <label><input type="radio" name="file" value="png" checked /><span>Imagen<small>PNG, fija</small></span></label>
              <label><input type="radio" name="file" value="video" /><span>Vídeo<small id="export-video-detail">MP4, 8 s</small></span></label>
              <label><input type="radio" name="file" value="gif" /><span>GIF<small>Animado, se repite</small></span></label>
            </div>
            <p class="choice__note" id="export-file-note" hidden></p>
          </fieldset>
          <fieldset class="choice">
            <legend>Contenido</legend>
            <div class="choice__grid">
              <label><input type="radio" name="content" value="seats" checked /><span>Escaños<small>Los partidos y sus colores</small></span></label>
              <label><input type="radio" name="content" value="vote" /><span><span id="export-vote-label">Investidura</span><small>Sí, no y abstención</small></span></label>
            </div>
            <p class="choice__note" id="export-vote-note">Para la investidura, elige antes un candidato.</p>
          </fieldset>
          <fieldset class="choice">
            <legend>Tamaño</legend>
            <div class="choice__grid">
              {
                Object.entries(IMAGE_FORMATS).map(([id, format], index) => (
                  <label>
                    <input type="radio" name="format" value={id} checked={index === 0} />
                    <span>
                      {format.label}
                      <small>{format.width} × {format.height}</small>
                      <small>{format.use}</small>
                    </span>
                  </label>
                ))
              }
            </div>
          </fieldset>
          <fieldset class="choice">
            <legend>Fondo</legend>
            <div class="choice__grid">
              <label><input type="radio" name="theme" value="light" checked /><span>Blanco</span></label>
              <label><input type="radio" name="theme" value="dark" /><span>Negro</span></label>
            </div>
          </fieldset>
          <label class="export__field">
            Título
            <input name="title" type="text" maxlength="40" autocomplete="off" value="Mi Congreso" />
          </label>
        </form>
      </div>
      <div class="export__actions">
        <Button variant="ink" id="export-download"><ShareIcon name="download" /><span id="export-download-label">Descargar imagen</span></Button>
        <Button id="export-share" hidden><ShareIcon name="share" /><span id="export-share-label">Compartir imagen</span></Button>
        <Button id="export-copy" hidden><ShareIcon name="clipboard" />Copiar imagen</Button>
      </div>
      <p class="export__status" id="export-status" role="status"></p>
    </dialog>

    <p class="sim-note" id="sim-note-congreso">
      Los escaños actuales son los del Congreso de la XV legislatura, que se disolvió el 6 de octubre de 2026 (fuente: la ficha de la
      legislatura en Wikipedia, que no da fecha de esas cifras). Los de 2023 son los resultados oficiales por candidatura: el PSOE
      incluye al PSC y Sumar a sus coaliciones. Sumar se presenta el 29N como Frente Amplio (FA): con «Congreso actual» y «Resultados de 2023» se llama Sumar, y con «Todo a cero», que empieza el Congreso del 29N, Frente Amplio, cada uno con su color. En la lista, «Convertir en Frente Amplio» cambia el nombre y el color sin cambiar los escaños, y «Convertir en Sumar» lo deshace. El orden del hemiciclo y los colores son aproximados. El simulador aplica el artículo 99
      de la Constitución y no tiene en cuenta cómo se reparten los escaños por provincia.
    </p>
    <p class="sim-note" id="sim-note-senado" hidden>
      El Senado de la XV legislatura tiene {SENATE_SEATS} escaños: {SENATE_ELECTED_SEATS} elegidos en las urnas por provincia e isla y{' '}
      {SENATE_AUTONOMOUS_SEATS} por designación autonómica (art. 69.5 de la Constitución), que no se renuevan el 29N. «Senado actual»
      muestra la suma de ambos por partido de procedencia (en la Cámara los grupos parlamentarios se prestan senadores para alcanzar el mínimo).
      «Solo autonómicos ({SENATE_AUTONOMOUS_SEATS})» conserva esos escaños para repartir los {SENATE_ELECTED_SEATS} electos del 29N, y
      «Electos de 2023 ({SENATE_ELECTED_SEATS})» muestra los resultados oficiales del 23J (PSOE incluye al PSC; ERC y EH Bildu concurrieron como
      Izquierdas por la Independencia; «Otros» es Eivissa i Formentera al Senat). El Senado no inviste al presidente del Gobierno: la mayoría
      absoluta ({SENATE_ABSOLUTE_MAJORITY}) permite vetar leyes (art. 90) o aplicar el artículo 155, y la mayoría simple basta para enmiendas y
      mociones. El orden del hemiciclo y los colores son aproximados.
    </p>
  </div>

  <template id="seat-row-template">
    <li class="seat-row">
      <button type="button" class="seat-row__handle">
        <svg viewBox="0 0 12 20" width="12" height="20" fill="currentColor" aria-hidden="true" focusable="false">
          <circle cx="3" cy="4" r="1.7" /><circle cx="9" cy="4" r="1.7" />
          <circle cx="3" cy="10" r="1.7" /><circle cx="9" cy="10" r="1.7" />
          <circle cx="3" cy="16" r="1.7" /><circle cx="9" cy="16" r="1.7" />
        </svg>
      </button>
      <span class="seat-row__swatch" aria-hidden="true"></span>
      <div class="seat-row__name">
        <label class="seat-row__label"></label>
        <small class="seat-row__full"></small>
        <button type="button" class="seat-row__remove" hidden>Quitar partido</button>
        <button type="button" class="seat-row__rename" hidden></button>
      </div>
      <div class="stepper">
        <button type="button" data-step="-1">−</button>
        <input type="number" inputmode="numeric" min="0" max={CONGRESS_SEATS} step="1" />
        <button type="button" data-step="1">+</button>
      </div>
    </li>
  </template>

  <template id="vote-row-template">
    <li class="vote-row">
      <fieldset>
        <legend>
          <span class="seat-row__swatch" aria-hidden="true"></span>
          <b></b>
          <span class="vote-row__seats"></span>
        </legend>
        <div class="segmented">
          <input type="radio" value="yes" />
          <label>Sí</label>
          <input type="radio" value="abstain" />
          <label>Abst.</label>
          <input type="radio" value="no" />
          <label>No</label>
        </div>
      </fieldset>
    </li>
  </template>
</BaseLayout>

<script>
  import '@/scripts/simulator';
</script>

<style>
  .page-hero { border-bottom: var(--border-thick) solid var(--color-ink); padding: 44px 0; }
  .page-hero h1 { font-size: clamp(3.25rem, 12cqi, 8.5rem); margin: var(--space-4) 0; }
  .page-hero__lede { font-size: 1.1875rem; font-weight: 600; max-width: 60ch; }
  /* Chamber switcher: the same square, thick-bordered toggle used in CandidacyMap. */
  .chambers { display: inline-flex; flex-wrap: wrap; margin-top: var(--space-5); }
  .chambers button {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    min-height: 48px;
    padding: 8px 20px;
    border: var(--border-thick) solid var(--color-ink);
    border-radius: 0;
    background: var(--color-paper);
    color: var(--color-ink);
    font: 700 1.0625rem var(--font-body);
    cursor: pointer;
  }
  .chambers button + button { margin-left: calc(-1 * var(--border-thick)); }
  .chambers button small { font: 600 var(--text-xs) var(--font-body); color: var(--color-ink-muted); }
  .chambers button[aria-pressed='true'] { background: var(--color-ink); color: var(--color-paper); }
  .chambers button[aria-pressed='true'] small { color: inherit; }
  .chambers button:not([aria-pressed='true']):hover { background: var(--color-highlight); color: var(--color-on-highlight); }
  .chambers button:not([aria-pressed='true']):hover small { color: inherit; }
  .chambers button:focus-visible { outline: 3px solid var(--color-highlight); outline-offset: 2px; position: relative; z-index: 1; }
  .sim-note[hidden] { display: none; }

  .sim-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: var(--space-5); align-items: start; }
  /* The first row: the hemicycle panel sets the height, and the panel of the seats has the same height. */
  .sim-grid--seats { align-items: stretch; }
  .seats-col { position: relative; min-height: 420px; min-width: 0; }
  .seats-col :global(.seats-panel) { position: absolute; inset: 0; display: flex; flex-direction: column; min-height: 0; }
  .seat-scroll { flex: 1 1 auto; min-height: 0; overflow-y: auto; overscroll-behavior: contain; padding-right: var(--space-2); }
  .sim-grid--pacts { grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); align-items: stretch; }
  .votes-col { position: relative; min-width: 0; min-height: 520px; }
  .votes-col :global(.votes-panel) { position: absolute; inset: 0; display: flex; flex-direction: column; min-height: 0; }
  /* The pacts take the room they need, up to 46% of the panel; the votes take the rest. Each one scrolls if it needs more. */
  .vote-scroll { flex: 1 1 0; min-height: 140px; overflow-y: auto; overscroll-behavior: contain; padding-right: var(--space-2); }
  .coalitions-box {
    flex: 0 1 auto;
    max-height: 46%;
    min-height: 0;
    display: flex;
    flex-direction: column;
    margin-top: var(--space-3);
    border-top: var(--border-thick) solid var(--color-ink);
    padding-top: var(--space-2);
  }
  .coalitions-box .coalitions { flex: 1 1 auto; min-height: 0; overflow-y: auto; overscroll-behavior: contain;
    padding: 4px 12px 12px 4px; }
  /* The numbers in the hemicycle can not be selected: a drag over them would select the text. */
  :global(#hemi-seats), :global(#hemi-votes) { user-select: none; -webkit-user-select: none; }
  .hemicycle__total, .hemicycle__caption { user-select: none; -webkit-user-select: none; pointer-events: none; }
  .hemicycle__total { font: 900 40px var(--font-display); fill: var(--color-ink); }
  .hemicycle__caption { font: 700 13px var(--font-body); fill: var(--color-ink); }
  .status { margin: var(--space-3) 0; font: 700 var(--text-sm) var(--font-body); }
  .status[data-state='warning'] { background: var(--color-highlight); color: var(--color-on-highlight); padding: var(--space-2) var(--space-3); }
  .sim-actions { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .sim-actions :global([hidden]), .share__actions :global([hidden]) { display: none; }
  /* The buttons that open the dialog of the image, next to each result. The main one is yellow, the highlight of the
     site: black on yellow 13:1 in both themes; on hover, paper on ink (21:1). */
  .sim :global(.export-open) { width: 100%; margin: 0 0 var(--space-3); }
  .sim :global(.export-open[hidden]) { display: none; }
  .sim :global(.export-open--main) { background: var(--color-highlight); color: var(--color-on-highlight); }
  .sim :global(.export-open--main:hover) { background: var(--color-ink); color: var(--color-paper); }
  .sim :global(.export-open--vote) { margin: var(--space-4) 0 0; }

  .sort { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-3); margin-bottom: var(--space-3); }
  .sort__label { font: 700 var(--text-xs) var(--font-body); }
  .sort button {
    min-height: 44px;
    padding: 0 var(--space-3);
    border: var(--border-thin) solid var(--color-ink);
    background: var(--color-paper);
    color: var(--color-ink);
    font: 700 var(--text-xs) var(--font-body);
    cursor: pointer;
  }
  .sort button + button { margin-left: -2px; }
  .sort button[aria-pressed='true'] { background: var(--color-ink); color: var(--color-paper); }
  .sort button:not([aria-pressed='true']):hover { background: var(--color-highlight); color: var(--color-on-highlight); }
  .sort button:focus-visible { outline: 3px solid var(--color-ink); outline-offset: -3px; }
  .sort button[aria-pressed='true']:focus-visible { outline-color: var(--color-paper); }
  .seat-list, .vote-list, .coalitions { list-style: none; margin: 0; padding: 0; }
  /* The rows are created by the script from a template: their styles are global inside the lists. */
  .seat-list :global(.seat-row) {
    display: grid;
    grid-template-columns: 28px 14px minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) 0;
    border-top: var(--border-fine) solid var(--color-ink);
  }
  .seat-list :global(.seat-row:first-child) { border-top: 0; }
  .hint { margin: 0 0 var(--space-3); font-size: var(--text-sm); color: var(--color-ink-muted); }

  /* Move: the handle of a row, and the states of a drag. */
  .seat-list :global(.seat-row__handle) {
    display: grid;
    place-items: center;
    width: 28px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-ink-muted);
    cursor: grab;
    touch-action: none; /* a touch on the handle drags the row; it does not scroll the page */
  }
  .seat-list :global(.seat-row__handle:hover) { color: var(--color-ink); }
  .seat-list :global(.seat-row__handle:active) { cursor: grabbing; }
  .seat-list :global(.seat-row__handle:focus-visible) { outline: 3px solid var(--color-ink); outline-offset: -3px; }
  .seat-list[data-sort='alpha'] :global(.seat-row__handle),
  .seat-list[data-sort='seats'] :global(.seat-row__handle) { visibility: hidden; pointer-events: none; }
  .seat-list :global(.seat-row.is-dragging) { outline: 3px solid var(--color-ink); outline-offset: -3px; }
  .seat-list :global(.seat-row.is-drop) { background: var(--color-highlight); color: var(--color-on-highlight); }
  .seat-list :global(.seat-row.is-drop .seat-row__full), .seat-list :global(.seat-row.is-drop .seat-row__remove), .seat-list :global(.seat-row.is-drop .seat-row__rename), .seat-list :global(.seat-row.is-drop .seat-row__handle) { color: inherit; }
  /* The SVG belongs to the Hemicycle component, so these selectors are global. */
  :global(#hemi-seats circle) { cursor: grab; }
  :global(#hemi-seats.is-dragging circle) { cursor: grabbing; }
  :global(#hemi-seats circle[data-drag='source']) { opacity: 0.35; }
  :global(#hemi-seats circle[data-drag='target']) { stroke-width: 3; }
  :global(.seat-row__swatch) { width: 16px; height: 16px; box-sizing: border-box; border-radius: 50%; background: var(--group); border: var(--border-fine) solid var(--color-ink); flex: none; }
  .seat-list :global(.seat-row__name) { display: grid; gap: 2px; min-width: 0; font-size: var(--text-sm); justify-items: start; }
  .seat-list :global(.seat-row__label b) { font-family: var(--font-body); }
  .seat-list :global(.seat-row__full) { color: var(--color-ink-muted); font-size: var(--text-xs); }
  .seat-list :global(.seat-row__remove) { padding: 0; border: 0; background: none; color: var(--color-ink); font: 600 var(--text-xs) var(--font-body); text-decoration: underline; cursor: pointer; }
  .seat-list :global(.seat-row__remove[hidden]), .seat-list :global(.seat-row__rename[hidden]) { display: none; }
  .seat-list :global(.seat-row__rename) { padding: 0; border: 0; background: none; color: var(--color-ink); font: 600 var(--text-xs) var(--font-body); text-decoration: underline; cursor: pointer; text-align: left; }

  .seat-list :global(.stepper) { display: inline-flex; max-width: 100%; border: var(--border-thin) solid var(--color-ink); }
  .seat-list :global(.stepper button) {
    width: 44px;
    height: 44px;
    border: 0;
    background: var(--color-paper);
    color: var(--color-ink);
    font: 700 1.25rem var(--font-body);
    cursor: pointer;
  }
  .seat-list :global(.stepper button:hover) { background: var(--color-highlight); color: var(--color-on-highlight); }
  /* The focus ring goes inside the control: the global ring is outside and it spills over the panel. */
  .seat-list :global(.stepper button:focus-visible),
  .seat-list :global(.stepper input:focus-visible) { outline: 3px solid var(--color-ink); outline-offset: -3px; }
  .seat-list :global(.stepper input) {
    box-sizing: border-box;
    width: 64px;
    min-width: 0;
    height: 44px;
    border: 0;
    border-inline: var(--border-thin) solid var(--color-ink);
    border-radius: 0;
    background: var(--color-paper);
    color: var(--color-ink);
    text-align: center;
    font: 700 1rem var(--font-body);
    -moz-appearance: textfield;
    appearance: textfield;
  }
  .seat-list :global(.stepper input::-webkit-outer-spin-button), .seat-list :global(.stepper input::-webkit-inner-spin-button) { -webkit-appearance: none; margin: 0; }

  /* Form to create a party. */
  .party-form { position: relative; flex: none; margin-top: var(--space-3); border-top: var(--border-thick) solid var(--color-ink); padding-top: var(--space-2); }
  .party-form summary { cursor: pointer; font: 700 var(--text-sm) var(--font-body); min-height: 44px; display: flex; align-items: center; }
  /* The open form floats above the summary and covers part of the list: the list does not shrink. */
  .party-form[open] form {
    position: absolute;
    z-index: 5;
    left: 0;
    right: 0;
    bottom: 100%;
    margin: 0 0 var(--space-2);
    padding: var(--space-4);
    background: var(--color-paper);
    border: var(--border-thick) solid var(--color-ink);
  }
  .party-form form { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr)); gap: var(--space-3); align-items: end; margin-top: var(--space-2); }
  .party-form label { display: grid; gap: 6px; font: 700 var(--text-xs) var(--font-body); }
  .party-form input:not([type='color']), .party-form select {
    box-sizing: border-box; width: 100%; min-height: 44px; border: var(--border-thin) solid var(--color-ink); border-radius: 0; padding: 0 10px;
    background: var(--color-paper); color: var(--color-ink); font: 600 0.9375rem var(--font-body); text-transform: none;
  }
  /* The text of the select sits in the middle of its height and the arrow at the right edge, like the other selects. */
  .party-form select, .pact-toolbar select { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); }
  .party-form input[type='color'] { width: 100%; height: 44px; padding: 2px; border: var(--border-thin) solid var(--color-ink); background: var(--color-paper); cursor: pointer; }
  .party-form__error { grid-column: 1 / -1; margin: 0; min-height: 1.2em; font: 700 var(--text-xs) var(--font-body); }

  /* The bar of the candidate sits above both panels, so they start at the same height. */
  .pact-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-4); padding: var(--space-3) var(--space-4); margin-bottom: var(--space-5); }
  .pact-toolbar label { font: 700 var(--text-xs) var(--font-body); }
  .pact-toolbar select { box-sizing: border-box; flex: 0 1 280px; min-width: 0; min-height: 48px; border: var(--border-thin) solid var(--color-ink); border-radius: 0; padding: 0 12px; background: var(--color-paper); color: var(--color-ink); font: 600 1rem var(--font-body); }
  .pact-toolbar p { margin: 0 0 0 auto; font-size: var(--text-sm); color: var(--color-ink-muted); }

  .vote-list :global(.vote-row) { padding: var(--space-2) 0; border-top: var(--border-fine) solid var(--color-ink); }
  .vote-list :global(.vote-row:first-child) { border-top: 0; }
  .vote-list :global(.vote-row[hidden]) { display: none; }
  .vote-list :global(.vote-row fieldset) { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-2) var(--space-3); border: 0; margin: 0; padding: 0; min-width: 0; }
  .vote-list :global(.vote-row legend) { display: flex; align-items: center; gap: var(--space-2); float: left; padding: 0; font-size: var(--text-sm); }
  .vote-list :global(.vote-row legend b) { font-family: var(--font-body); }
  .vote-list :global(.vote-row__seats) { font-size: var(--text-xs); color: var(--color-ink-muted); }
  .vote-list :global(.segmented) { display: inline-flex; border: var(--border-thin) solid var(--color-ink); margin-left: auto; }
  .vote-list :global(.segmented input) { position: absolute; opacity: 0; pointer-events: none; }
  .vote-list :global(.segmented label) {
    display: grid;
    place-items: center;
    min-width: 56px;
    min-height: 44px;
    padding: 0 var(--space-2);
    font: 700 var(--text-xs) var(--font-body);
    cursor: pointer;
    background: var(--color-paper);
    color: var(--color-ink);
  }
  .vote-list :global(.segmented label + input + label) { border-left: var(--border-thin) solid var(--color-ink); }
  .vote-list :global(.segmented input:checked + label) { background: var(--color-ink); color: var(--color-paper); }
  .vote-list :global(.segmented input:focus-visible + label) { outline: 3px solid var(--color-ink); outline-offset: -3px; }
  .vote-list :global(.segmented input:checked:focus-visible + label) { outline-color: var(--color-paper); }
  .vote-list :global(.segmented input:disabled + label) { cursor: default; }
  .vote-list :global(.segmented input:not(:checked) + label:hover) { background: var(--color-highlight); color: var(--color-on-highlight); }
  .vote-list :global(.vote-row[data-candidate='true'] .segmented input:not(:checked) + label:hover) { background: var(--color-paper); color: var(--color-ink); }

  /* The voting board, in the style of the screens of the Congress. Its colors are fixed (the same in both
     themes, like a real screen). Contrast on --board-bg: text 17:1, muted text 8:1. Dark text on the lights:
     yes 8.4:1, no 5.7:1, abstention 13:1. */
  .sim {
    --board-bg: #111315;
    --board-text: #f5f5f0;
    --board-muted: #a7adb4;
    --board-line: #2c3136;
    --led-yes: #34c759;
    --led-no: #ff4d42;
    --led-abstain: #ffd60a;
    --led-off: #3a4048;
  }
  .board {
    padding: var(--space-4) var(--space-4) var(--space-3);
    background: var(--board-bg);
    color: var(--board-text);
    /* A dark frame in both themes, like a screen. */
    border: var(--border-thick) solid var(--color-ink);
  }
  /* A light for each seat. A seat with no vote (or no candidate) is a light that is off. */
  .board :global(#hemi-votes circle) { fill: var(--led-off); stroke: #000; }
  .board__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-1) var(--space-4);
    margin: var(--space-4) 0 0;
    padding-bottom: var(--space-2);
    border-bottom: 3px solid var(--board-muted);
    font: 700 var(--text-xs) var(--font-body);
    color: var(--board-muted);
  }
  .board__head b { margin-left: var(--space-2); font: 900 1.625rem var(--font-display); color: var(--board-text); }
  .board__tally { list-style: none; margin: 0; padding: 0; }
  .board__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: var(--space-2) 2px 6px;
    border-bottom: 3px solid var(--row);
    font: 700 var(--text-md) var(--font-body);
  }
  .board__row b { font: 900 2.25rem / 1 var(--font-display); font-variant-numeric: tabular-nums; }
  .board__row--yes { --row: var(--led-yes); }
  .board__row--no { --row: var(--led-no); }
  .board__row--abstain { --row: var(--led-abstain); }

  /* The bar of votes, with the mark of the absolute majority. Dark text on each light. */
  .vote-bar { position: relative; display: flex; margin: var(--space-5) 0 var(--space-6); border: var(--border-thin) solid var(--board-line); background: #0a0b0c; min-height: 36px; }
  /* No padding: the width of each part is exactly its share of the 350 seats (flex-grow = votes, basis 0). */
  .vote-bar__part { display: grid; place-items: center; flex: 1 1 0; min-width: 0; padding: 0; font: 700 var(--text-xs) var(--font-body); white-space: nowrap; overflow: hidden; color: var(--board-bg); }
  .vote-bar__part[hidden] { display: none; }
  .vote-bar__part--yes { background: var(--led-yes); }
  .vote-bar__part--abstain { background: var(--led-abstain); }
  .vote-bar__part--no { background: var(--led-no); }
  .vote-bar__part--rest { background: transparent; }
  .vote-bar__marker { position: absolute; top: -8px; bottom: -8px; width: 0; border-left: 3px solid var(--board-text); }
  .vote-bar__marker i { position: absolute; top: calc(100% + 2px); left: 50%; transform: translateX(-50%); font: 700 var(--text-xs) var(--font-body); font-style: normal; background: var(--board-bg); color: var(--board-text); padding: 0 4px; }
  /* Without a candidate, the votes wait: no option looks selected, and all are muted. */
  .vote-list :global(fieldset:disabled .segmented input + label),
  .vote-list :global(fieldset:disabled .segmented input + label:hover) { background: var(--color-paper); color: var(--color-ink-subtle); cursor: not-allowed; }

  .verdict { padding: var(--space-4); margin-top: var(--space-6); }
  .verdict h3 { font-size: 2rem; margin: 0 0 var(--space-2); }
  .verdict p { margin: 0; }
  .coalitions__title { font-size: 1.75rem; margin: 0 0 var(--space-1); }
  .coalitions__lead { margin: 0 0 var(--space-3); font-size: var(--text-sm); color: var(--color-ink-muted); }
  .coalitions { display: grid; gap: var(--space-3); }
  .coalitions :global(.coalition) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
    min-height: 56px;
    box-sizing: border-box;
    padding: var(--space-2) var(--space-3);
    border: var(--border-thin) solid var(--color-ink);
    background: var(--color-paper);
    color: var(--color-ink);
    text-align: left;
    cursor: pointer;
  }
  .coalitions :global(.coalition__parties) { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; font: 700 var(--text-sm) var(--font-body); }
  .coalitions :global(.coalition__party) { display: inline-flex; align-items: center; gap: 6px; }
  .coalitions :global(.coalition__swatch) { width: 16px; height: 16px; box-sizing: border-box; border-radius: 50%; border: var(--border-fine) solid var(--color-ink); flex: none; }
  .coalitions :global(.coalition__plus) { color: var(--color-ink-muted); }
  .coalitions :global(.coalition__sum) { display: grid; justify-items: end; line-height: 1.1; }
  .coalitions :global(.coalition__sum strong) { font: 900 1.875rem var(--font-display); }
  .coalitions :global(.coalition__sum small) { font: 700 var(--text-2xs) var(--font-body); color: var(--color-ink-muted); }
  .coalitions :global(.coalition:hover) { background: var(--color-highlight); color: var(--color-on-highlight); }
  .coalitions :global(.coalition:hover .coalition__plus), .coalitions :global(.coalition:hover .coalition__sum small) { color: inherit; }
  /* The pact that is applied now. */
  .coalitions :global(.coalition[aria-pressed='true']) { background: var(--color-ink); color: var(--color-paper); }
  .coalitions :global(.coalition[aria-pressed='true'] .coalition__plus), .coalitions :global(.coalition[aria-pressed='true'] .coalition__sum small) { color: inherit; }
  .coalitions :global(.coalition[aria-pressed='true'] .coalition__swatch) { border-color: var(--color-paper); }

  .share__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .share__status { min-height: 1.4em; margin: var(--space-5) 0 0; padding-top: var(--space-2); font: 700 var(--text-sm) var(--font-body); }
  .share__preview { margin: 0 0 var(--space-4); font-size: var(--text-md); font-weight: 600; }
  .share__subtitle { margin: var(--space-5) 0 var(--space-3); font: 700 var(--text-xs) var(--font-body); }
  .share__networks { display: flex; flex-wrap: wrap; gap: var(--space-3); list-style: none; margin: 0; padding: 0; }
  .sim-note { margin: var(--space-6) 0 var(--space-8); max-width: 80ch; font-size: var(--text-sm); color: var(--color-ink-muted); }

  /* The dialog of the image: the preview at the left, the options at the right (one column on a phone). */
  .export {
    box-sizing: border-box;
    width: min(100% - 32px, 1080px);
    max-height: calc(100dvh - 32px);
    padding: var(--space-4);
    border: var(--border-thick) solid var(--color-ink);
    border-radius: 0;
    background: var(--color-paper);
    color: var(--color-ink);
    overflow: auto;
    overscroll-behavior: contain;
  }
  .export::backdrop { background: rgb(0 0 0 / 60%); }
  .export__head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); margin-bottom: var(--space-4); }
  .export__title { margin: 0; font-size: 2rem; line-height: 1; }
  .export__close {
    flex: none;
    width: 44px;
    height: 44px;
    border: var(--border-thick) solid var(--color-ink);
    border-radius: 0;
    background: var(--color-paper);
    color: var(--color-ink);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }
  .export__close:hover { background: var(--color-highlight); color: var(--color-on-highlight); }
  .export__body { display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, 320px); gap: var(--space-5); align-items: start; }
  /* The image sits on a dot pattern, so its own edge is clear on both backgrounds. */
  .export__preview {
    display: grid;
    place-items: center;
    gap: var(--space-2);
    margin: 0;
    padding: var(--space-4);
    border: var(--border-thin) solid var(--color-ink);
    background-image: var(--trama-light);
    background-size: var(--trama-size);
    color: var(--color-ink-muted);
  }
  /* A canvas keeps its proportions when both limits apply: the whole image is always visible. */
  .export__preview canvas { display: block; width: auto; height: auto; max-width: 100%; max-height: min(62vh, 620px); }
  .export__preview figcaption { padding: 2px var(--space-2); background: var(--color-paper); color: var(--color-ink); font: 700 var(--text-xs) var(--font-body); }
  .export__options { display: grid; gap: var(--space-4); }
  .choice { margin: 0; padding: 0; border: 0; min-width: 0; }
  .choice legend { padding: 0; margin-bottom: var(--space-2); font: 700 var(--text-xs) var(--font-body); }
  .choice__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-2); }
  .choice__grid--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .choice label { position: relative; display: flex; }
  .choice input { position: absolute; opacity: 0; pointer-events: none; }
  .choice span {
    display: grid;
    align-content: center;
    gap: 2px;
    width: 100%;
    min-height: 48px;
    box-sizing: border-box;
    padding: var(--space-2) var(--space-3);
    border: var(--border-thin) solid var(--color-ink);
    background: var(--color-paper);
    color: var(--color-ink);
    font: 700 var(--text-sm) var(--font-body);
    cursor: pointer;
  }
  .choice small { font: 600 var(--text-2xs) var(--font-body); color: var(--color-ink-muted); }
  .choice input:not(:checked):not(:disabled) + span:hover { background: var(--color-highlight); color: var(--color-on-highlight); }
  .choice input:not(:checked):not(:disabled) + span:hover small { color: inherit; }
  .choice input:checked + span { background: var(--color-ink); color: var(--color-paper); }
  .choice input:checked + span small { color: inherit; }
  .choice input:focus-visible + span { outline: 3px solid var(--color-highlight); outline-offset: 2px; box-shadow: 0 0 0 2px var(--color-ink); }
  .choice input:disabled + span { color: var(--color-ink-muted); border-style: dashed; cursor: not-allowed; }
  .choice__note { margin: var(--space-2) 0 0; font-size: var(--text-xs); color: var(--color-ink-muted); }
  .choice__note[hidden] { display: none; }
  .export__field { display: grid; gap: 6px; font: 700 var(--text-xs) var(--font-body); }
  .export__field input {
    box-sizing: border-box;
    width: 100%;
    min-height: 48px;
    padding: 0 12px;
    border: var(--border-thin) solid var(--color-ink);
    border-radius: 0;
    background: var(--color-paper);
    color: var(--color-ink);
    font: 600 1rem var(--font-body);
  }
  .export__field input:focus-visible { outline: 3px solid var(--color-ink); outline-offset: 2px; }
  .export__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-5); padding-top: var(--space-4); border-top: var(--border-thick) solid var(--color-ink); }
  .export__actions :global([hidden]) { display: none; }
  .export__status { min-height: 1.4em; margin: var(--space-3) 0 0; font: 700 var(--text-sm) var(--font-body); }

  @media (max-width: 900px) {
    .sim-grid, .sim-grid--pacts { grid-template-columns: minmax(0, 1fr); }
    .seats-col { min-height: 0; }
    .seats-col :global(.seats-panel) { position: static; }
    .seat-scroll { max-height: 520px; }
    .votes-col { min-height: 0; }
    .votes-col :global(.votes-panel) { position: static; }
    /* The panel has no fixed height here: the list takes the height of its content, up to the maximum. */
    .vote-scroll { flex: 0 1 auto; min-height: 0; max-height: min(560px, 70vh); }
    .coalitions-box .coalitions { overflow: visible; }
    .export__body { grid-template-columns: minmax(0, 1fr); }
    .export__preview canvas { max-height: 46vh; }
  }
  @media (max-width: 560px) {
    .chambers { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .chambers button { flex-direction: column; align-items: flex-start; gap: 2px; padding: 10px 14px; }
    /* Share: the three actions fill the width, and the networks are icons in one row. */
    .share__actions { display: grid; grid-template-columns: minmax(0, 1fr); }
