  }
  .board__row b { font: 900 2.25rem / 1 var(--font-display); font-variant-numeric: tabular-nums; }
  .board__row--yes { --row: var(--led-yes); }
  .board__row--no { --row: var(--led-no); }
  .board__row--abstain { --row: var(--led-abstain); }

  /* The bar of votes, with the mark of the absolute majority. Dark text on each light. */
  .vote-bar { position: relative; display: flex; margin: var(--space-5) 0 var(--space-6); border: var(--border-thin) solid var(--board-line); background: #0a0b0c; min-height: 36px; }
  /* No padding: the width of each part is exactly its share of the 350 seats (flex-grow = votes, basis 0). */
  .vote-bar__part { display: grid; place-items: center; flex: 1 1 0; min-width: 0; padding: 0; font: 700 var(--text-xs) var(--font-body); white-space: nowrap; overflow: hidden; color: var(--board-bg); }
