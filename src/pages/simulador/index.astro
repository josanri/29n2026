  .share__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .share__status { min-height: 1.4em; margin: var(--space-5) 0 0; padding-top: var(--space-2); font: 700 var(--text-sm) var(--font-body); }
  .share__preview { margin: 0 0 var(--space-4); font-size: var(--text-md); font-weight: 600; }
  .share__subtitle { margin: var(--space-5) 0 var(--space-3); font: 700 var(--text-xs) var(--font-body); }
  .share__networks { display: flex; flex-wrap: wrap; gap: var(--space-3); list-style: none; margin: 0; padding: 0; }
  .sim-notes { margin: var(--space-6) 0 var(--space-8); max-width: 80ch; border-top: var(--border-thin) solid var(--color-ink); }
  .sim-notes summary { display: flex; align-items: center; min-height: 44px; font: 700 var(--text-sm) var(--font-body); cursor: pointer; }
  .sim-notes summary::-webkit-details-marker { display: none; }
  .sim-notes summary::after { content: '+'; margin-left: var(--space-2); font-size: 1.25rem; line-height: 1; }
  .sim-notes[open] summary::after { content: '−'; }
  .sim-notes summary:hover { background: var(--color-highlight); color: var(--color-on-highlight); }
  .sim-note { margin: var(--space-2) 0 0; font-size: var(--text-sm); color: var(--color-ink-muted); }

  /* The dialog of the image: the preview at the left, the options at the right (one column on a phone). */
  .export {
    box-sizing: border-box;
    width: min(100% - 32px, 1080px);
    max-height: calc(100dvh - 32px);
    padding: var(--space-4);
    border: var(--border-thick) solid var(--color-ink);
    border-radius: 0;
    background: var(--color-paper);
    color: var(--color-ink);
    overflow: auto;
    overscroll-behavior: contain;
  }
  .export::backdrop { background: rgb(0 0 0 / 60%); }
  .export__head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); margin-bottom: var(--space-4); }
  .export__title { margin: 0; font-size: 2rem; line-height: 1; }
  .export__close {
    flex: none;
    width: 44px;
    height: 44px;
    border: var(--border-thick) solid var(--color-ink);
    border-radius: 0;
    background: var(--color-paper);
    color: var(--color-ink);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }
  .export__close:hover { background: var(--color-highlight); color: var(--color-on-highlight); }
  .export__body { display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, 320px); gap: var(--space-5); align-items: start; }
  /* The image sits on a dot pattern, so its own edge is clear on both backgrounds. */
  .export__preview {
    display: grid;
    place-items: center;
    gap: var(--space-2);
    margin: 0;
    padding: var(--space-4);
    border: var(--border-thin) solid var(--color-ink);
    background-image: var(--trama-light);
    background-size: var(--trama-size);
    color: var(--color-ink-muted);
  }
  /* A canvas keeps its proportions when both limits apply: the whole image is always visible. */
  .export__preview canvas { display: block; width: auto; height: auto; max-width: 100%; max-height: min(62vh, 620px); }
  .export__preview figcaption { padding: 2px var(--space-2); background: var(--color-paper); color: var(--color-ink); font: 700 var(--text-xs) var(--font-body); }
  .export__options { display: grid; gap: var(--space-4); }
  .choice { margin: 0; padding: 0; border: 0; min-width: 0; }
  .choice legend { padding: 0; margin-bottom: var(--space-2); font: 700 var(--text-xs) var(--font-body); }
  .choice__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-2); }
  .choice__grid--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .choice label { position: relative; display: flex; }
  .choice input { position: absolute; opacity: 0; pointer-events: none; }
  .choice label > span {
    display: grid;
    align-content: center;
    gap: 2px;
    width: 100%;
    min-height: 48px;
    box-sizing: border-box;
    padding: var(--space-2) var(--space-3);
    border: var(--border-thin) solid var(--color-ink);
    background: var(--color-paper);
    color: var(--color-ink);
    font: 700 var(--text-sm) var(--font-body);
    cursor: pointer;
  }
  .choice small { font: 600 var(--text-2xs) var(--font-body); color: var(--color-ink-muted); }
  .choice input:not(:checked):not(:disabled) + span:hover { background: var(--color-highlight); color: var(--color-on-highlight); }
  .choice input:not(:checked):not(:disabled) + span:hover small { color: inherit; }
  .choice input:checked + span { background: var(--color-ink); color: var(--color-paper); }
  .choice input:checked + span small { color: inherit; }
  .choice input:focus-visible + span { outline: 3px solid var(--color-highlight); outline-offset: 2px; box-shadow: 0 0 0 2px var(--color-ink); }
  .choice input:disabled + span { color: var(--color-ink-muted); border-style: dashed; cursor: not-allowed; }
  .choice__note { margin: var(--space-2) 0 0; font-size: var(--text-xs); color: var(--color-ink-muted); }
  .choice__note[hidden] { display: none; }
  .export__field { display: grid; gap: 6px; font: 700 var(--text-xs) var(--font-body); }
  .export__field input {
    box-sizing: border-box;
    width: 100%;
    min-height: 48px;
    padding: 0 12px;
    border: var(--border-thin) solid var(--color-ink);
    border-radius: 0;
    background: var(--color-paper);
    color: var(--color-ink);
    font: 600 1rem var(--font-body);
  }
  .export__field input:focus-visible { outline: 3px solid var(--color-ink); outline-offset: 2px; }
  .export__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-5); padding-top: var(--space-4); border-top: var(--border-thick) solid var(--color-ink); }
  .export__actions :global([hidden]) { display: none; }
  .export__status { min-height: 1.4em; margin: var(--space-3) 0 0; font: 700 var(--text-sm) var(--font-body); }

  /* The menu of the presets («Partir de»): one button that says where the seats come from, and a list that opens under it. */
  .start { position: relative; margin: 0 0 var(--space-3); }
  .start__toggle {
    width: 100%;
    min-height: 52px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 4px var(--space-3);
    border: var(--border-thin) solid var(--color-ink);
    border-radius: 0;
    background: var(--color-paper);
    color: var(--color-ink);
    text-align: left;
    cursor: pointer;
  }
  .start__text { display: grid; }
  .start__label { font: 600 var(--text-xs) var(--font-body); color: var(--color-ink-muted); }
  .start__text b { font: 700 1rem var(--font-body); }
  .start__toggle :global(.share-icon) { transition: transform var(--duration-fast); }
  .start__toggle[aria-expanded='true'] :global(.share-icon) { transform: rotate(180deg); }
  .start__toggle:hover { background: var(--color-highlight); color: var(--color-on-highlight); }
  .start__toggle:hover .start__label { color: inherit; }
  .start__toggle:focus-visible { outline: 3px solid var(--color-ink); outline-offset: -7px; }
  .start__menu {
    position: absolute;
    z-index: var(--z-dropdown);
    left: 0;
    right: 0;
    top: calc(100% - var(--border-thin));
    display: grid;
    background: var(--color-paper);
    border: var(--border-thin) solid var(--color-ink);
    box-shadow: 6px 6px 0 var(--color-ink);
  }
  .start__menu[hidden], .start__item[hidden] { display: none; }
  .start__item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: var(--space-3);
    align-items: center;
    min-height: 56px;
    padding: 6px var(--space-3);
    border: 0;
    border-top: var(--border-fine) solid var(--color-ink);
    background: var(--color-paper);
    color: var(--color-ink);
    text-align: left;
    cursor: pointer;
  }
  .start__item:first-child { border-top: 0; }
  .start__item b { grid-column: 1; font: 700 0.9375rem var(--font-body); }
  .start__item small { grid-column: 1; font: 600 var(--text-xs) var(--font-body); color: var(--color-ink-muted); }
  .start__item::after { content: ''; grid-column: 2; grid-row: 1 / span 2; font: 700 1.125rem var(--font-body); }
  .start__item[aria-pressed='true'] { background: var(--color-ink); color: var(--color-paper); }
  .start__item[aria-pressed='true'] small { color: inherit; }
  .start__item[aria-pressed='true']::after { content: '✓'; }
  .start__item:not([aria-pressed='true']):hover { background: var(--color-highlight); color: var(--color-on-highlight); }
  .start__item:not([aria-pressed='true']):hover small { color: inherit; }
  .start__item:focus-visible { outline: 3px solid var(--color-ink); outline-offset: -5px; }
  .start__item[aria-pressed='true']:focus-visible { outline-color: var(--color-paper); }
  .sim-actions:not(:has(> :not([hidden]))) { display: none; }
  .sim-actions { margin-bottom: var(--space-3); }

  /* The tiles of the image dialog: an icon for each kind of file and the shape of each size. */
  .choice span :global(.share-icon) { justify-self: start; width: 22px; height: 22px; margin-bottom: 2px; }
  .choice__shape { justify-self: start; display: block; height: 20px; margin-bottom: 4px; box-sizing: border-box; border: 2px solid currentColor; }
  /* The download is the main action of the dialog: black on yellow (13:1 in both themes). */
  .export :global(.export__primary) { background: var(--color-highlight); color: var(--color-on-highlight); }
  .export :global(.export__primary:hover) { background: var(--color-ink); color: var(--color-paper); }
  .export__preview canvas { box-shadow: 6px 6px 0 var(--color-ink); }

  /* The steps and their bar are for phones and tablets (see the media query of 900 px). */
  .steps, .sim-bar { display: none; }

  /* The quick share sheet: it comes up from the bottom of the screen. */
  .sheet {
    box-sizing: border-box;
    width: 100%;
    max-width: 560px;
    max-height: calc(100dvh - 24px);
    margin: auto auto 0;
    padding: var(--space-4) var(--space-4) var(--space-5);
    border: var(--border-thick) solid var(--color-ink);
    border-bottom: 0;
    border-radius: 0;
    background: var(--color-paper);
    color: var(--color-ink);
    overflow: auto;
    overscroll-behavior: contain;
  }
  .sheet[open] { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-4); }
  .sheet::backdrop { background: rgb(0 0 0 / 60%); }
  .sheet__head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); }
  .sheet__title { margin: 0; font-size: 2rem; line-height: 1; }
  .sheet__what { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border: var(--border-thin) solid var(--color-ink); }
  .sheet__what[hidden] { display: none; }
  .sheet__what button {
    display: grid;
    justify-items: center;
    gap: 2px;
    min-height: 52px;
    padding: 6px;
    border: 0;
    background: var(--color-paper);
    color: var(--color-ink);
    font: 700 0.9375rem var(--font-body);
    cursor: pointer;
  }
  .sheet__what button + button { border-left: var(--border-thin) solid var(--color-ink); }
  .sheet__what small { font: 600 var(--text-xs) var(--font-body); color: var(--color-ink-muted); }
  .sheet__what button[aria-pressed='true'] { background: var(--color-ink); color: var(--color-paper); }
  .sheet__what button[aria-pressed='true'] small { color: inherit; }
  .sheet__what button:not([aria-pressed='true']):hover { background: var(--color-highlight); color: var(--color-on-highlight); }
  .sheet__what button:not([aria-pressed='true']):hover small { color: inherit; }
  .sheet__what button:focus-visible { outline: 3px solid var(--color-ink); outline-offset: -6px; }
  .sheet__what button[aria-pressed='true']:focus-visible { outline-color: var(--color-paper); }
  /* The image or the video first: a yellow card with a hard shadow, like a sticker. Black on yellow, 13:1. */
  .sheet__promo {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-3);
    background: var(--color-highlight);
    color: var(--color-on-highlight);
    border: var(--border-thin) solid var(--color-ink);
    box-shadow: 6px 6px 0 var(--color-ink);
  }
  /* The preview of the image: the canvas at full size, shown smaller, on the dot pattern of the image dialog. */
  .sheet__preview {
    display: grid;
    place-items: center;
    padding: var(--space-3);
    border: var(--border-thin) solid var(--color-on-highlight);
    background-color: var(--color-paper);
    background-image: var(--trama-light);
    background-size: var(--trama-size);
    cursor: zoom-in;
  }
  .sheet__preview canvas { display: block; max-width: 100%; max-height: 240px; width: auto; height: auto; box-shadow: 4px 4px 0 var(--color-ink); }
  .sheet__preview:focus-visible { outline: 3px solid var(--color-on-highlight); outline-offset: 3px; }
  .sheet__promo-text { display: grid; gap: 4px; min-width: 0; }
  .sheet__promo-text b { font: 900 1.625rem/0.9 var(--font-display); text-transform: uppercase; }
  .sheet__promo-text span { font: 600 var(--text-sm)/1.35 var(--font-body); }
  .sheet__promo-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-2); }
  .sheet__promo-actions:has(> [hidden]) { grid-template-columns: minmax(0, 1fr); }
  .sheet__promo-actions :global(.button) { justify-content: center; padding: 0 var(--space-2); }
  .sheet__promo-actions :global([hidden]) { display: none; }
  .sheet__or { display: flex; align-items: center; gap: var(--space-3); margin: 0; font: 700 var(--text-xs) var(--font-body); text-transform: uppercase; }
  .sheet__or::before, .sheet__or::after { content: ''; flex: 1; border-top: 2px solid var(--color-ink); }
  .sheet__link { display: flex; border: var(--border-thin) solid var(--color-ink); }
  .sheet__url { flex: 1; min-width: 0; display: flex; align-items: center; gap: var(--space-2); padding: 0 var(--space-3); font: 600 var(--text-sm) var(--font-body); }
  .sheet__url span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sheet__copy {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 48px;
    padding: 0 var(--space-3);
    border: 0;
    border-left: var(--border-thin) solid var(--color-ink);
    background: var(--color-ink);
    color: var(--color-paper);
    font: 700 0.9375rem var(--font-body);
    cursor: pointer;
  }
  .sheet__copy:hover { background: var(--color-highlight); color: var(--color-on-highlight); }
  .sheet__copy:focus-visible { outline: 3px solid var(--color-paper); outline-offset: -6px; }
  .sheet__networks { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: var(--space-2); list-style: none; margin: 0; padding: 0; }
  .sheet__network {
    display: grid;
    place-items: center;
    height: 48px;
    border: var(--border-thin) solid var(--color-ink);
    background: var(--color-paper);
    color: var(--color-ink);
  }
  .sheet__network:hover { background: var(--color-highlight); color: var(--color-on-highlight); }
  .sheet__network:focus-visible { outline: 3px solid var(--color-ink); outline-offset: -7px; }
  .sheet__status { min-height: 1.2em; margin: 0; font: 700 var(--text-sm) var(--font-body); }
  .sheet__status:empty { display: none; }

  @media (max-width: 900px) {
    .sim-grid, .sim-grid--pacts { grid-template-columns: minmax(0, 1fr); }
    .seats-col { min-height: 0; }
    .seats-col :global(.seats-panel) { position: static; }
    .votes-col { min-height: 0; }
    .votes-col :global(.votes-panel) { position: static; }
    .coalitions-box .coalitions { overflow: visible; }
    .export__body { grid-template-columns: minmax(0, 1fr); }
    .export__preview canvas { max-height: 46vh; }

    /* The steps: «Escaños» and «Investidura» show one part of the page each; «Comparte» opens the share sheet. */
    .steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: var(--space-5); border: var(--border-thin) solid var(--color-ink); }
    .steps button {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: var(--space-2);
      min-height: 52px;
      padding: 0 var(--space-2);
      border: 0;
      background: var(--color-paper);
      color: var(--color-ink);
      font: 700 0.9375rem var(--font-body);
      cursor: pointer;
    }
    .steps button + button { position: relative; border-left: var(--border-thin) solid var(--color-ink); }
    /* The separator: the yellow dot of the logo (and a seat) on the line between two steps. Yellow with a black ring,
       in both themes: the ring shows next to a paper step, and the yellow next to an ink step. */
    .steps button + button::before {
      content: '';
      position: absolute;
      z-index: 1;
      top: 50%;
      left: 0;
      width: 16px;
      height: 16px;
      box-sizing: border-box;
      border: 3px solid #000;
      border-radius: 50%;
      background: var(--color-highlight);
      transform: translate(calc(-50% - var(--border-thin) / 2), -50%);
      pointer-events: none;
    }
    .steps__number { font: 900 1.375rem/1 var(--font-display); }
    .steps button[aria-current='step'] { background: var(--color-ink); color: var(--color-paper); }
    .steps button:not([aria-current='step']):hover { background: var(--color-highlight); color: var(--color-on-highlight); }
    .steps button:focus-visible { outline: 3px solid var(--color-ink); outline-offset: -7px; }
    .steps button[aria-current='step']:focus-visible { outline-color: var(--color-paper); }
    .sim[data-step='seats'] .step-vote, .sim[data-step='vote'] .step-seats { display: none; }
    .step-seats > :global(.section-heading), .step-vote > :global(.section-heading) { margin-top: var(--space-5); }
    /* The bar shares and goes on: the section «Comparte» and the buttons next to each result are not needed. */
    .share-section, .sim :global(.export-open--main), .sim :global(.export-open--vote) { display: none; }

    /* The bar of the steps, at the bottom of the screen while the simulator is visible. */
    .sim-bar {
      position: sticky;
      bottom: 0;
      z-index: var(--z-sticky);
      display: grid;
      gap: var(--space-2);
      margin: var(--space-6) calc(-1 * var(--gutter)) 0;
      padding: 10px var(--gutter) 12px;
      border-top: var(--border-thick) solid var(--color-ink);
      background: var(--color-paper);
      color: var(--color-ink);
    }
    .sim-bar__row { display: flex; align-items: center; gap: var(--space-2); }
    .sim-bar__info { flex: 1; min-width: 0; display: grid; }
    .sim-bar__info--seats b { font: 900 1.875rem/0.9 var(--font-display); }
    .sim-bar__info--seats span { justify-self: start; font: 700 var(--text-xs) var(--font-body); }
    .sim-bar__info--seats span[data-state='warning'] { padding: 0 4px; background: var(--color-highlight); color: var(--color-on-highlight); }
    .sim-bar__info--vote b { font: 700 0.9375rem/1.2 var(--font-body); }
    .sim-bar__info--vote span { font: 600 var(--text-xs) var(--font-body); color: var(--board-muted); }
    .sim-bar__share {
      flex: none;
      display: grid;
      place-items: center;
      width: 48px;
      height: 48px;
      border: var(--border-thin) solid var(--color-ink);
      background: var(--color-highlight);
      color: var(--color-on-highlight);
      cursor: pointer;
    }
    .sim-bar__next {
      flex: none;
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      min-height: 48px;
      padding: 0 var(--space-4);
      border: var(--border-thin) solid var(--color-ink);
      background: var(--color-ink);
      color: var(--color-paper);
      font: 700 0.9375rem var(--font-body);
      cursor: pointer;
    }
    .sim-bar__share:hover { background: var(--color-ink); color: var(--color-paper); }
    .sim-bar__next:hover { background: var(--color-highlight); color: var(--color-on-highlight); }
    .sim-bar button:focus-visible { outline: 3px solid var(--color-highlight); outline-offset: 2px; }
    .sim[data-step='seats'] :is(.sim-bar__info--vote, .sim-bar__next--vote, .sim-bar__meter),
    .sim[data-step='vote'] :is(.sim-bar__info--seats, .sim-bar__next--seats) { display: none; }
    /* In the step of the vote the bar is a small voting board: dark in both themes, like the board above. */
    .sim[data-step='vote'] .sim-bar { background: var(--board-bg); color: var(--board-text); border-top-color: #000; }
    .sim[data-step='vote'] .sim-bar__share { border-color: var(--color-highlight); }
    .sim[data-step='vote'] .sim-bar__next { border-color: var(--board-text); background: var(--board-text); color: var(--board-bg); }
    .sim[data-step='vote'] .sim-bar__next:hover { border-color: var(--color-highlight); background: var(--color-highlight); color: #000; }
    .sim-bar__meter { position: relative; display: flex; height: 14px; background: #0a0b0c; border: 1px solid var(--board-line); }
    .sim-bar__meter span { flex: none; }
    .sim-bar__meter [data-meter='yes'] { background: var(--led-yes); }
    .sim-bar__meter [data-meter='abstain'] { background: var(--led-abstain); }
    .sim-bar__meter [data-meter='no'] { background: var(--led-no); }
    /* Without a candidate the bar waits: no empty bar of votes, and its buttons are off (dashed, like the options that are off). */
    .sim-bar[data-waiting='true'] .sim-bar__meter { display: none; }
    .sim[data-step='vote'] .sim-bar button:disabled { border-style: dashed; border-color: var(--board-muted); background: transparent; color: var(--board-muted); cursor: not-allowed; }
    .sim-bar__meter i { position: absolute; top: -5px; bottom: -5px; width: 0; border-left: 3px solid var(--board-text); }

    /* The seats: a card for each party, two or more in a row. The full name is in the tooltip of the name;
       the order changes with a drag in the hemicycle. */
    .seat-scroll { max-height: none; overflow: visible; padding-right: 0; }
    .seat-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 136px), 1fr)); gap: var(--space-4) var(--space-3); }
    .seat-list :global(.seat-row),
    .seat-list :global(.seat-row:first-child) {
      grid-template-columns: 14px minmax(0, 1fr);
      grid-template-areas: 'swatch name' 'stepper stepper';
      gap: 6px var(--space-2);
      padding: 0;
      border: 0;
    }
    .seat-list :global(.seat-row__handle), .seat-list :global(.seat-row__full), .hint__handle { display: none; }
    .seat-list :global(.seat-row__swatch) { grid-area: swatch; }
