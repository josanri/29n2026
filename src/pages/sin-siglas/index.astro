  .page-hero:has(+ .game) { border-bottom: var(--border-thick) solid var(--color-ink); padding: 44px 0; }
  .page-hero:has(+ .game) h1 { font-size: clamp(2.25rem, 10cqi, 7.5rem); margin: var(--space-4) 0; }
