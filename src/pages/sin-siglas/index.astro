  .game .quiz-card__stamp[data-answer='yes'] { color: var(--color-block-3); }
  .game .quiz-card__stamp[data-answer='no'] { color: var(--color-block-2); }
  .game .quiz-card__stamp[data-answer='neutral'] { color: var(--color-ink); }

  .game .quiz__answers { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-3); }
  .game .answer {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    min-height: 76px;
    padding: var(--space-2);
    border: var(--border-thick) solid var(--color-ink);
    background: var(--color-paper);
    color: var(--color-ink);
    box-shadow: var(--shadow-sm);
    font: 400 var(--text-md) var(--font-display);
