  }

  /* 2. The measures */
  .game .quiz { display: grid; gap: var(--space-5); max-width: 760px; margin-inline: auto; padding: 0; border: 0; }
  .game .quiz__progress { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-2) var(--space-4); }
  .game .quiz__count { margin: 0 auto 0 0; font: 700 var(--text-sm) var(--font-mono); text-transform: uppercase; }
