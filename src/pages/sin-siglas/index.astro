  .game .quiz-card__meta { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: var(--space-2); margin: 0; font: 700 var(--text-xs) var(--font-mono); text-transform: uppercase; color: var(--color-ink-muted); }
  .game .quiz-card__category { padding: 2px 8px; border: var(--border-thin) solid currentColor; }
  .game .quiz-card__heading { margin: var(--space-2) 0 0; font-size: clamp(1.375rem, 3.2vw, 2rem); line-height: 1.15; text-transform: none; overflow-wrap: anywhere; }
