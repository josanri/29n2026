  .game .answer:active { transform: translate(3px, 3px); box-shadow: none; }
  /* The answer that the reader gave, when the reader goes back to a measure: a thick inner frame. */
  .game .answer[aria-pressed='true'] { box-shadow: inset 0 0 0 4px var(--color-highlight), var(--shadow-sm); }

  /* The answer in a dot, a chip or a square: a symbol and a color. */
  .game [data-answer='yes']:is(li, .vote-chip, .vote-square) { background: var(--color-block-3); color: var(--color-on-block); border-color: var(--color-block-3); }
  .game [data-answer='no']:is(li, .vote-chip, .vote-square) { background: var(--color-block-2); color: var(--color-on-block); border-color: var(--color-block-2); }
