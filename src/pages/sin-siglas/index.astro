  .game .quiz-card__text { margin: 0; font-size: var(--text-md); white-space: pre-line; }
  .game .quiz-card__more[hidden] { display: none; }
  .game .quiz-card__more summary { cursor: pointer; font: 700 var(--text-sm) var(--font-mono); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 3px; }
  .game .quiz-card__more summary:hover { text-decoration-color: var(--color-highlight); }
  .game .quiz-card__more p { margin: var(--space-3) 0 0; white-space: pre-line; }
  /* The stamp of the answer, over the card. */
  .game .quiz-card__stamp {
    position: absolute;
    top: 50%;
