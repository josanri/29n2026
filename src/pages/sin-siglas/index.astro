  .game .answer-legend { display: grid; justify-items: end; gap: 6px; }
  .game .answer-legend__title { margin: 0; font: 700 var(--text-2xs) var(--font-mono); text-transform: uppercase; color: var(--color-ink-muted); }
  .game .answer-legend ul { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); list-style: none; margin: 0; padding: 0; }
  .game .answer-legend li { display: inline-flex; align-items: center; gap: 6px; font: 700 var(--text-xs) var(--font-mono); }
  .game .affinity { display: grid; gap: var(--space-2); list-style: none; margin: 0; padding: 0; }
  .game .affinity__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 6px var(--space-4);
    padding: var(--space-3) 0;
    border-top: 1px dashed var(--color-ink-subtle);
  }
  .game .affinity__party { margin: 0; }
  .game .affinity__party a { display: inline-flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); text-decoration: none; }
  .game .affinity__party a:hover .affinity__name { text-decoration: underline; text-decoration-color: var(--color-highlight); text-decoration-thickness: 3px; }
  .game .affinity__name { font-weight: 600; }
  .game .affinity__squares { display: flex; gap: 4px; }
  .game .vote-square { display: grid; place-items: center; width: 24px; height: 24px; box-sizing: border-box; border: var(--border-thin) solid var(--color-ink); font: 700 var(--text-xs) var(--font-mono); }
  .game .affinity__facts { grid-column: 1 / -1; margin: 0; font-size: var(--text-sm); color: var(--color-ink-muted); }
  .game .affinity__row.is-empty .party-tag { background: transparent; color: var(--color-ink-muted); border: var(--border-thin) dashed var(--color-ink-muted); }
  .game .results__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-6); }

  /* Share */
  .game .share { margin-top: var(--space-8); padding: var(--space-5); }
  .game .share p { margin: 0 0 var(--space-3); }
  .game .share__preview { padding: var(--space-3) var(--space-4); border-left: 4px solid var(--color-highlight); background: var(--color-paper-alt); font-weight: 600; }
  .game .share__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-bottom: var(--space-4); }
  .game .share__actions [hidden] { display: none; }
  .game .share__networks { display: flex; flex-wrap: wrap; gap: var(--space-2); list-style: none; margin: 0; padding: 0; }
  .game .share__status:empty { display: none; }
  /* `.game .share p` sets no top margin: this rule is more specific, so the message keeps its space. */
  .game .share .share__status { margin: var(--space-5) 0 0; padding-top: var(--space-3); border-top: 1px dashed var(--color-ink-subtle); font: 700 var(--text-sm) var(--font-mono); }

  @media (max-width: 900px) {
    .game .start { grid-template-columns: minmax(0, 1fr); }
    .game .start__map .province-map { max-height: 60vh; }
  }
  @media (max-width: 560px) {
    .game-step { padding: var(--space-4); }
    .game .answer-legend { justify-items: start; }
    .game .quiz-card { min-height: 260px; padding: var(--space-4); }
    .game .answer { min-height: 64px; font-size: var(--text-sm); }
    .game .quiz__dots li { width: 22px; height: 22px; }
    .game .reveal { grid-template-columns: 84px minmax(0, 1fr); }
    .game .reveal .vote-chip { grid-column: 2; justify-self: start; }
    /* The two actions of the results and the share actions fill the width. The networks are icons in one row. */
    .game .results__actions { display: grid; grid-template-columns: minmax(0, 1fr); }
    .game .share { padding: var(--space-4); }
    .game .share__actions { display: grid; grid-template-columns: minmax(0, 1fr); }
    .game .results__actions .button,
    .game .share__actions .button { justify-content: center; }
    .game .share__networks { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .game .share__network { width: 100%; box-sizing: border-box; justify-content: center; padding: 10px 0; min-height: 44px; }
    .game .share__label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  }
  @media (prefers-reduced-motion: reduce) {
    .game .reveal__face, .game .reveal__party, .game .answer { transition: none; }
  }
</style>
