---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProgramCard from '@/components/party/ProgramCard.astro';
import CandidacyMap from '@/components/candidacies/CandidacyMap.astro';
import Button from '@/components/ui/Button.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Tag from '@/components/ui/Tag.astro';
import { programs, publishedFirst, publishedPrograms } from '@/lib/programs';
import {
  nationalPrograms,
  provinceRegions,
  provinces,
  provincesOf,
  regionalProgramsIn,
  regionalRegions,
} from '@/lib/presence';
import { partySearchText } from '@/lib/party-search';
import { routes, SEARCH_PARAMS } from '@/lib/routes';
import { categories } from '@/lib/taxonomy';
import { compareText, formatNumber } from '@/lib/format';

const totalMeasures = programs.reduce((sum, program) => sum + program.measures.length, 0);
const nationalSorted = publishedFirst(nationalPrograms);

// Example parties for the placeholder of the search fields, by province code ('' = all provinces).
// `local` are the parties of one region; `other` are the parties of the whole country.
// `p` tells if the party has a published program: the list can hide the ones that have none.
const nationalIds = new Set(nationalPrograms.map((program) => program.id));
interface Example { a: string; p: boolean }
const emptyExamples = () => ({ local: [] as Example[], other: [] as Example[] });
const examplesByProvince: Record<string, { local: Example[]; other: Example[] }> = { '': emptyExamples() };
for (const program of programs) {
  const kind = nationalIds.has(program.id) ? 'other' : 'local';
  for (const code of ['', ...provincesOf(program)]) {
    (examplesByProvince[code] ??= emptyExamples())[kind].push({ a: program.acronym, p: program.hasProgram });
  }
}
const examplesJson = JSON.stringify(examplesByProvince);
// Example reforms (topics) for the placeholder of the hero search.
const searchTopics = ['Vivienda', 'IRPF', 'Pensiones', 'Sanidad', 'Alquiler', 'Educación', 'Impuestos', 'Energía'];
---

<BaseLayout title="Inicio">
  <section class="hero">
    <div class="container">
      <Tag variant="ink" size="md">Elecciones generales · 29 de noviembre de 2026</Tag>
      <h1 class="headline">
        Los <span class="hero__mark">programas</span> medida a medida
      </h1>
      <p class="hero__lede">
        Cada programa electoral, descompuesto en sus medidas y propuestas, con el texto original y el enlace a la fuente oficial.
      </p>
      <form class="hero__search box" action={routes.search()} method="get" role="search">
        <label class="sr-only" for="hero-q">Busca un partido o una reforma</label>
        <input
          id="hero-q"
          name={SEARCH_PARAMS.query}
          type="search"
          placeholder="Busca un partido o una reforma: PP, Vivienda, IRPF…"
          data-examples={examplesJson}
          data-topics={JSON.stringify(searchTopics)}
          autocomplete="off"
        />
        <button type="submit">
          Buscar
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" aria-hidden="true">
            <path d="M3 12h17M13 5l7 7-7 7" />
          </svg>
        </button>
      </form>
    </div>
    <dl class="counter">
      <div><dt>Programas</dt><dd>{programs.length}</dd></div>
      <div><dt>Medidas y propuestas</dt><dd>{formatNumber(totalMeasures)}</dd></div>
      <div><dt>Categorías</dt><dd>{categories.length}</dd></div>
    </dl>
  </section>

  <CandidacyMap />

  <section class="container" id="programas">
    <SectionHeading index="02 / PROGRAMAS" title="Programas analizados">
      <p>
        Se incorporan los programas con fuente oficial disponible. {publishedPrograms.length} de los {programs.length} partidos que se
        presentan han publicado ya el suyo.
      </p>
    </SectionHeading>

    <div class="filters box" role="group" aria-label="Filtrar programas">
      <label class="filters__field" for="party-search">
        Partido
        <input
          id="party-search"
          type="search"
          placeholder="Bildu, PNV, Compromís…"
          data-examples={examplesJson}
          autocomplete="off"
        />
      </label>
      <label class="filters__field" for="province-filter">
        Provincia
        <select id="province-filter">
          <option value="">Todas las provincias</option>
          {provinceRegions.map((region) => (
            <optgroup label={region}>
              {provinces
                .filter((province) => province.region === region)
                .sort((a, b) => compareText(a.name, b.name))
                .map((province) => <option value={province.code} data-region={region}>{province.name}</option>)}
            </optgroup>
          ))}
        </select>
      </label>
      <button class="filters__switch" type="button" id="published-filter" aria-pressed="true">
        <span class="filters__track" aria-hidden="true"></span>
        Solo con programa publicado
      </button>
      <p class="filters__summary" id="filter-summary" aria-live="polite"></p>
    </div>

    <section class="group" data-group>
      <h3>Ámbito estatal</h3>
      <div class="grid grid--cards">
        {nationalSorted.map((program) => (
          <div
            class="card"
            data-card={program.id}
            data-provinces={provincesOf(program).join(' ')}
            data-unpublished={String(!program.hasProgram)}
            data-search={partySearchText(program)}
          >
            <ProgramCard program={program} />
          </div>
        ))}
      </div>
    </section>

    <section class="group" data-group>
      <h3>Partidos de ámbito autonómico</h3>
      <div class="grid grid--cards">
        {regionalRegions.flatMap((region) =>
          publishedFirst(regionalProgramsIn(region)).map((program) => (
            <section class="region" data-group data-region={region}>
              <h4>{region}</h4>
              <div
                class="card"
                data-card={program.id}
                data-provinces={provincesOf(program).join(' ')}
                data-unpublished={String(!program.hasProgram)}
                data-search={partySearchText(program)}
              >
                <ProgramCard program={program} />
              </div>
            </section>
          )),
        )}
      </div>
    </section>

    <p class="filters__empty box" id="filter-empty" hidden>
      Ningún partido coincide con los filtros.
      <Button id="show-all">Quitar los filtros</Button>
    </p>
  </section>
</BaseLayout>

<script>
  import Fuse from 'fuse.js';
  import { fuzzyOptions, MIN_FUZZY_LENGTH } from '@/lib/fuzzy';
  import { normalizeForSearch } from '@/lib/format';
  import { HOME_PARAMS as params } from '@/lib/routes';

  const searchInput = document.querySelector<HTMLInputElement>('#party-search')!;

  // The placeholder of a search field shows three parties at random. It changes on each page load
  // and when the province changes. With a province chosen, it prefers the parties of that region.
  type Examples = Record<string, { local: { a: string; p: boolean }[]; other: { a: string; p: boolean }[] }>;
  const shuffle = <T,>(items: T[]) => [...items].sort(() => Math.random() - 0.5);
  // Only short acronyms (2 to 5 letters or digits, no accents) are good examples: "PP", "ERC", "BNG".
  // Long ones, such as "AUTÓNOMOS", look like words and do not read as a party.
  const isShortAcronym = (acronym: string) => /^[A-Za-z0-9]{2,5}$/.test(acronym);
  // The examples are only parties that the list shows: with the switch "solo con programa publicado"
  // on, a party without a program is not an example.
  const showExamples = (input: HTMLInputElement, province: string, onlyPublished = true) => {
    try {
      const examples: Examples = JSON.parse(input.dataset.examples ?? '{}');
      const entry = examples[province] ?? examples[''];
      if (!entry) return;
      const usable = (list: { a: string; p: boolean }[]) =>
        list.filter((example) => (!onlyPublished || example.p) && isShortAcronym(example.a)).map((example) => example.a);
      const local = usable(entry.local);
      const other = usable(entry.other);
      const picked = [...shuffle([...new Set(local)]).slice(0, 2), ...shuffle([...new Set(other)])]
        .filter((acronym, index, all) => all.indexOf(acronym) === index)
        .slice(0, 3);
      if (picked.length === 3) input.placeholder = `${input.dataset.placeholderPrefix ?? ''}${picked.join(', ')}…`;
    } catch {
      /* Keep the placeholder from the HTML. */
    }
  };
  // The hero search finds parties and reforms: its placeholder mixes two parties and one topic.
  const heroSearch = document.querySelector<HTMLInputElement>('#hero-q')!;
  try {
    const examples: Examples = JSON.parse(heroSearch.dataset.examples ?? '{}');
    const topics: string[] = JSON.parse(heroSearch.dataset.topics ?? '[]');
    // Only parties with a published program: the search finds measures, and the others have none.
    const parties = shuffle(
      [...new Set([...(examples['']?.local ?? []), ...(examples['']?.other ?? [])].filter((example) => example.p).map((example) => example.a))].filter(isShortAcronym),
    ).slice(0, 2);
    const topic = shuffle(topics).slice(0, 1);
    if (parties.length === 2 && topic.length === 1) {
      // A shorter lead on a narrow screen, so that the examples fit in the field.
      const lead = matchMedia('(max-width: 640px)').matches ? 'Partido o reforma: ' : 'Busca un partido o una reforma: ';
      heroSearch.placeholder = `${lead}${shuffle([...parties, ...topic]).join(', ')}…`;
    }
  } catch {
    /* Keep the placeholder from the HTML. */
  }
  const provinceSelect = document.querySelector<HTMLSelectElement>('#province-filter')!;
  const publishedSwitch = document.querySelector<HTMLButtonElement>('#published-filter')!;
  const summary = document.querySelector<HTMLElement>('#filter-summary')!;
  const emptyMessage = document.querySelector<HTMLElement>('#filter-empty')!;
  const showAllButton = document.querySelector<HTMLButtonElement>('#show-all')!;
  const cards = [...document.querySelectorAll<HTMLElement>('[data-card]')];
  // Innermost groups first, so an outer group already sees its empty subgroups hidden.
  const groups = [...document.querySelectorAll<HTMLElement>('[data-group]')].reverse();
  const totalParties = new Set(cards.map((card) => card.dataset.card)).size;

  // Fuzzy index over the names, the acronym and the regions of each card (data-search).
  const fuse = new Fuse(
    cards.map((card) => ({ card, text: card.dataset.search ?? '' })),
    { ...fuzzyOptions, keys: ['text'] },
  );
  const cardsMatching = (query: string): Set<HTMLElement> | null => {
    if (!query) return null;
    if (query.length < MIN_FUZZY_LENGTH) {
      return new Set(cards.filter((card) => card.dataset.search!.includes(query)));
    }
    return new Set(fuse.search(query).map((result) => result.item.card));
  };

  const applyFilters = () => {
    const searchQuery = normalizeForSearch(searchInput.value);
    const matches = cardsMatching(searchQuery);
    const province = provinceSelect.value;
    const onlyPublished = publishedSwitch.getAttribute('aria-pressed') === 'true';
    // A regional party of several regions (EH Bildu) shows in each one. With a province
    // chosen, it shows only in the group of the region of that province.
    const region = province ? provinceSelect.selectedOptions[0].dataset.region : undefined;
    const visibleParties = new Set<string>();
    for (const card of cards) {
      const inProvince = !province || card.dataset.provinces!.split(' ').includes(province);
      const cardRegion = card.closest<HTMLElement>('[data-region]')?.dataset.region;
      const inRegion = !region || !cardRegion || cardRegion === region;
      const inSearch = !matches || matches.has(card);
      const show = inProvince && inRegion && inSearch && !(onlyPublished && card.dataset.unpublished === 'true');
      card.hidden = !show;
      if (show) visibleParties.add(card.dataset.card!);
    }
    for (const group of groups) {
      group.hidden = !group.querySelector('[data-card]:not([hidden])');
    }
    const place = province ? ` en ${provinceSelect.selectedOptions[0].textContent}` : '';
    summary.textContent = `${visibleParties.size} de ${totalParties} partidos${place}`;
    emptyMessage.hidden = visibleParties.size > 0;

    const url = new URL(location.href);
    if (searchInput.value.trim()) url.searchParams.set(params.search, searchInput.value.trim());
    else url.searchParams.delete(params.search);
    if (province) url.searchParams.set(params.province, province);
    else url.searchParams.delete(params.province);
    if (onlyPublished) url.searchParams.delete(params.showAll);
    else url.searchParams.set(params.showAll, '1');
    history.replaceState(null, '', url);
  };

  const query = new URLSearchParams(location.search);
  const initialProvince = query.get(params.province);
  if (initialProvince && [...provinceSelect.options].some((option) => option.value === initialProvince)) {
    provinceSelect.value = initialProvince;
  }
  if (query.get(params.showAll) === '1') publishedSwitch.setAttribute('aria-pressed', 'false');
  searchInput.value = query.get(params.search) ?? '';

  searchInput.addEventListener('input', applyFilters);
  // The example parties follow the filters: the province and the switch of published programs.
  const updateExamples = () =>
    showExamples(searchInput, provinceSelect.value, publishedSwitch.getAttribute('aria-pressed') === 'true');
  // The map of candidacies shares the province with this filter, in both directions.
  const PROVINCE_EVENT = 'province:select';
  provinceSelect.addEventListener('change', () => {
    updateExamples();
    applyFilters();
    document.dispatchEvent(new CustomEvent(PROVINCE_EVENT, { detail: { code: provinceSelect.value, source: 'filter' } }));
  });
  document.addEventListener(PROVINCE_EVENT, (event) => {
    const { code, source } = (event as CustomEvent<{ code: string; source: string }>).detail;
    if (source === 'filter' || provinceSelect.value === code) return;
    provinceSelect.value = code;
    updateExamples();
    applyFilters();
  });
  updateExamples();
  publishedSwitch.addEventListener('click', () => {
    publishedSwitch.setAttribute('aria-pressed', String(publishedSwitch.getAttribute('aria-pressed') !== 'true'));
    updateExamples();
    applyFilters();
  });
  showAllButton.addEventListener('click', () => {
    searchInput.value = '';
    provinceSelect.value = '';
    publishedSwitch.setAttribute('aria-pressed', 'false');
    updateExamples();
    applyFilters();
    document.dispatchEvent(new CustomEvent(PROVINCE_EVENT, { detail: { code: '', source: 'filter' } }));
  });
  applyFilters();
</script>

<style>
  .hero {
    border-bottom: var(--border-thick) solid var(--color-ink);
    padding: clamp(40px, 6vw, 72px) 0 0;
  }
  .hero h1 {
    font-size: clamp(2.5rem, 9cqi, 9.25rem);
    line-height: 0.9;
    margin: 22px 0 var(--space-6);
  }
  /* The search sits in the hero: it sends the reader to the party list with the filters set. */
  .hero__search {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    margin: 0 0 var(--space-7); /* room for the hard shadow */
    box-shadow: var(--shadow-lg);
  }
  .hero__search input,
  .hero__search select,
  .hero__search button {
    box-sizing: border-box;
    min-height: 56px;
    border: 0;
    border-radius: 0;
    background: var(--color-paper);
    color: var(--color-ink);
    font: 600 1.125rem var(--font-body);
    padding: 0 var(--space-4);
  }
  .hero__search input {
    flex: 1 1 320px;
    min-width: 0;
    border-right: var(--border-thick) solid var(--color-ink);
    text-overflow: ellipsis; /* a long placeholder ends in "…", it is not cut */
  }
  .hero__search select { flex: 0 1 260px; min-width: 0; border-right: var(--border-thick) solid var(--color-ink); }
  .hero__search select { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); }
  .hero__search button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    flex: 0 0 auto;
    background: var(--color-highlight);
    color: var(--color-on-highlight);
    font: 700 1rem var(--font-mono);
    text-transform: uppercase;
    cursor: pointer;
  }
  .hero__search button:hover { background: var(--color-ink); color: var(--color-paper); }
  .hero__search :focus-visible { outline: 3px solid var(--color-highlight); outline-offset: -3px; }
  @media (max-width: 640px) {
    .hero__search input, .hero__search select { flex-basis: 100%; border-right: 0; border-bottom: var(--border-thick) solid var(--color-ink); }
    .hero__search input { font-size: 1rem; padding-inline: var(--space-3); }
    .hero__search button { flex: 1 1 100%; }
  }
  .hero__mark {
    /* Monochrome: no color that suggests a party. On party pages each theme brings the color. */
    background: var(--color-ink);
    color: var(--color-paper);
    padding: 0 0.08em;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    border: var(--border-thick) solid var(--color-ink);
    display: inline-block;
    max-width: 100%;
    overflow-wrap: anywhere;
    transform: rotate(-1.5deg);
    box-shadow: 6px 6px 0 color-mix(in srgb, var(--color-ink) 35%, transparent);
    margin: 0.1em 0 0.16em; /* room so the rotated box does not touch the next line */
  }
  .hero__lede { font-size: clamp(1.0625rem, 1.6vw, 1.25rem); max-width: 60ch; font-weight: 600; margin: 0 0 var(--space-6); }
  /* One row of three, from edge to edge. The numbers sit beside their labels. */
  .counter {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    margin: 0;
    border-top: var(--border-thick) solid var(--color-ink);
  }
  .counter div {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding: var(--space-4) var(--gutter);
    border-right: var(--border-thick) solid var(--color-ink);
    min-width: 0;
  }
  .counter div:last-child { border-right: 0; }
  .counter dt { order: 2; font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; }
  .counter dd { order: 1; margin: 0; font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3.5rem); line-height: 1; }

  .filters {
    position: sticky;
    top: 84px;
    z-index: var(--z-sticky);
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 12px 20px;
    margin-top: var(--space-5);
    padding: 14px var(--space-4);
    background: var(--color-paper);
  }
  /* The filters stick 8px below the header. This strip of paper covers that gap (and goes under the header),
     so the cards that scroll behind the filters do not show through it. */
  .filters::before {
    content: '';
    position: absolute;
    left: calc(-1 * var(--border-thick));
    /* On the right it goes past the box: the hard shadows of the cards stick out there. */
    right: calc(-1 * var(--border-thick) - 14px);
    bottom: calc(100% + var(--border-thick));
    height: 16px;
    background: var(--color-paper);
    pointer-events: none;
  }
  .filters__field { display: grid; gap: 6px; font: 700 var(--text-xs) var(--font-mono); text-transform: uppercase; }
  .filters__field select,
  .filters__field input {
    box-sizing: border-box;
    width: 100%;
    min-width: min(100%, 260px);
    min-height: 42px;
    border: var(--border-thin) solid var(--color-ink);
    border-radius: 0;
    padding: 7px 10px;
    background: var(--color-paper);
    color: var(--color-ink);
    font: 600 0.9375rem var(--font-body);
  }
  /* The select text sits at the left and the arrow at the right edge, like the search field. */
  .filters__field select { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .filters__field select::picker-icon { margin-left: auto; }
  .filters__switch {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 42px;
    padding: 7px var(--space-3);
    border: var(--border-thin) solid var(--color-ink);
    background: var(--color-paper);
    color: var(--color-ink);
    font: 700 0.8125rem var(--font-mono);
    text-transform: uppercase;
    cursor: pointer;
  }
  .filters__switch:hover { background: var(--color-highlight); color: var(--color-on-highlight); }
  /* Switch: the knob moves right and the track fills with ink when on. */
  .filters__track {
    position: relative;
    flex: none;
    width: 34px;
    height: 18px;
    border: var(--border-thin) solid currentColor;
    background: var(--color-paper);
    transition: background-color var(--duration-base);
  }
  .filters__track::after {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    width: 10px;
    height: 10px;
    background: var(--color-ink);
    transition: transform var(--duration-base);
  }
  .filters__switch[aria-pressed='true'] .filters__track { background: var(--color-ink); }
  .filters__switch[aria-pressed='true'] .filters__track::after {
    background: var(--color-paper);
    transform: translateX(16px);
  }
  .filters__summary { margin: 0 0 10px auto; font: 700 0.8125rem var(--font-mono); }
  .filters__empty {
    margin-top: var(--space-6);
    padding: 18px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 18px;
    font-weight: 600;
  }
  .filters__empty[hidden], .card[hidden], [data-group][hidden] { display: none; }
  /* Phone: one column. The fields and the switch fill the width and the summary comes last. */
  @media (max-width: 560px) {
    .filters::before { display: none; } /* on a phone the filters do not stick */
    .filters {
      position: static;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3);
      margin-top: var(--space-4);
      padding: var(--space-3);
    }
    .filters__field select,
    .filters__field input { min-width: 0; min-height: 48px; }
    .filters__switch { width: 100%; box-sizing: border-box; min-height: 48px; }
    .filters__summary { margin: 0; text-align: right; }
    .group { margin-top: var(--space-6); }
  }

  .group { margin-top: 40px; }
  .group > h3 { font-size: clamp(1.5rem, 3.5vw, 2.125rem); margin-bottom: 20px; }
  /* One grid of party cards. Each card has the name of its region above it. */
  .region { display: flex; flex-direction: column; }
  .region .card { flex: 1; }
  .region h4 { font-family: var(--font-mono); font-size: 0.9375rem; font-weight: 700; margin: 0 0 var(--space-3); }
</style>
