  @media (max-width: 640px) { .clash-scroll { max-height: 420px; padding: var(--space-2); } }
  .clash { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3); }
  .clash__link { display: grid; gap: 0; color: var(--color-ink); text-decoration: none; border: var(--border-fine) solid var(--color-ink); background: var(--color-paper); }
