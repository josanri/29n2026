  button.rhythm__label:focus-visible { outline: 3px solid var(--color-ink); outline-offset: -3px; }
  .rhythm__swatch { flex: none; display: inline-block; width: 12px; height: 12px; background: var(--party); border: var(--border-fine) solid var(--color-ink); }
  .rhythm__short { display: none; }
  .rhythm__plot { position: relative; min-width: 0; }
  .rhythm__group { margin: var(--space-4) 0 var(--space-2); font-weight: 800; font-size: var(--text-sm); text-transform: uppercase; letter-spacing: 0.04em; }
  .rhythm__group--topics { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 16px; }
  .heat-key { display: inline-flex; align-items: center; gap: 3px; text-transform: none; letter-spacing: 0; font-weight: 600; color: var(--color-ink-muted); }
  .heat-key i { display: inline-block; width: 16px; height: 12px; border: 1px solid var(--color-ink-muted); }
  .heat-key i:first-child { margin-left: 4px; }
  .heat-key i:last-child { margin-right: 4px; }

  .bins { display: flex; align-items: flex-end; gap: 2px; height: 96px; border-bottom: var(--border-fine) solid var(--color-ink); }
