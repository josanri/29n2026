  .matrix__cell:focus-visible { outline: 3px solid var(--color-ink); outline-offset: -5px; }
  .matrix__self { color: var(--color-ink-muted); background-image: var(--trama-light); background-size: var(--trama-size); }
  .matrix__total { padding: 6px 10px; font-weight: 800; }

  /* The cuts of the peak block, in a box with its own scroll: the list can be long and must not push the page down. */
  .clash-scroll {
    max-height: min(560px, 70vh);
    overflow-y: auto;
