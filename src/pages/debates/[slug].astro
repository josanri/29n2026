  .sides__row:hover .sides__bar--got,
  .sides__row[aria-pressed='true'] .sides__bar--got { background: var(--color-on-highlight); }
  .sides__num { padding: 0 6px; font-weight: 800; font-variant-numeric: tabular-nums; font-size: var(--text-sm); }
  .sides__key { display: flex; flex-wrap: wrap; gap: 4px 16px; margin-top: 6px; font-size: var(--text-xs); font-weight: 600; }
