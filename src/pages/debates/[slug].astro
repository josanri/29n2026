  /* ---- Transcript: the filters at the side (on top on a narrow screen), the text in a reading column ---- */
  /* The sticky panels stay under the site header: one row of 72px below 1180px, and taller above. */
  .transcript-section { --sticky-top: 108px; scroll-margin-top: 96px; }
  @media (max-width: 1179px) { .transcript-section { --sticky-top: 84px; } }
  .reader { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: var(--space-6); align-items: start; }
  .minimap { display: none; }
